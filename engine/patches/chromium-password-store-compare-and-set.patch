+std::optional<PasswordStoreChangeList>
+LoginDatabaseAsyncHelper::UpdateLoginsIfPasswordIs(
+    std::vector<StoredCredential> creds,
+    std::u16string expected) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!login_db_ || creds.empty()) {
+    return std::nullopt;
+  }
+  std::unique_ptr<sql::Transaction> transaction = CreateTransaction();
+  if (!transaction || !transaction->Begin()) {
+    return std::nullopt;
+  }
+  PasswordStoreChangeList changes;
+  for (const StoredCredential& cred : creds) {
+    std::vector<StoredCredential> current;
+    if (!login_db_->GetLogins(
+            PasswordFormDigest(cred.scheme, cred.signon_realm, cred.url),
+            false, &current)) {
+      return std::nullopt;
+    }
+    const bool holds_expected =
+        std::ranges::any_of(current, [&](const StoredCredential& stored) {
+          return AreStoredCredentialUniqueKeysEqual(stored, cred) &&
+                 stored.password_value == expected;
+        });
+    for (StoredCredential& stored : current) {
+      stored.password_value.clear();
+    }
+    if (!holds_expected) {
+      return std::nullopt;
+    }
+    UpdateCredentialError error = UpdateCredentialError::kNone;
+    PasswordStoreChangeList changed = UpdateLoginImpl(cred, &error);
+    if (error != UpdateCredentialError::kNone || changed.empty()) {
+      return std::nullopt;
+    }
+    changes.insert(changes.end(), changed.begin(), changed.end());
+  }
+  if (password_sync_bridge_) {
+    password_sync_bridge_->ActOnPasswordStoreChanges(FROM_HERE, changes);
+  }
+  if (!transaction->Commit()) {
+    return std::nullopt;
+  }
+  return changes;
+}
+
+std::optional<PasswordStoreChangeList>
+LoginDatabaseAsyncHelper::AddLoginIfAbsent(StoredCredential cred) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!login_db_) {
+    return std::nullopt;
+  }
+  std::unique_ptr<sql::Transaction> transaction = CreateTransaction();
+  if (!transaction || !transaction->Begin()) {
+    return std::nullopt;
+  }
+  std::vector<StoredCredential> current;
+  if (!login_db_->GetLogins(
+          PasswordFormDigest(cred.scheme, cred.signon_realm, cred.url), false,
+          &current)) {
+    return std::nullopt;
+  }
+  const bool present =
+      std::ranges::any_of(current, [&](const StoredCredential& stored) {
+        return !stored.blocked_by_user &&
+               !stored.federation_origin.IsValid() &&
+               stored.signon_realm == cred.signon_realm &&
+               stored.username_value == cred.username_value;
+      });
+  for (StoredCredential& stored : current) {
+    stored.password_value.clear();
+  }
+  if (present) {
+    return std::nullopt;
+  }
+  AddCredentialError error = AddCredentialError::kNone;
+  PasswordStoreChangeList changes = AddLoginImpl(std::move(cred), &error);
+  if (error != AddCredentialError::kNone || changes.empty()) {
+    return std::nullopt;
+  }
+  if (password_sync_bridge_) {
+    password_sync_bridge_->ActOnPasswordStoreChanges(FROM_HERE, changes);
+  }
+  if (!transaction->Commit()) {
+    return std::nullopt;
   }
   return changes;
 }
