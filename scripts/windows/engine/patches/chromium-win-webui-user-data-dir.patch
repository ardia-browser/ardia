+TEST_F(UserDataDir, ExtendedLengthPathPrefixesOnlyLongAbsolutePaths) {
+  const std::wstring tail(MAX_PATH, L'a');
+  EXPECT_EQ(L"C:\\Ardia\\ArdiaApp.dll",
+            ExtendedLengthPath(L"C:\\Ardia\\ArdiaApp.dll"));
+  EXPECT_EQ(L"C:/Ardia/ArdiaApp.dll",
+            ExtendedLengthPath(L"C:/Ardia/ArdiaApp.dll"));
+  EXPECT_EQ(L"\\\\?\\C:\\" + tail, ExtendedLengthPath(L"C:\\" + tail));
+  EXPECT_EQ(L"\\\\?\\d:\\" + tail + L"\\x",
+            ExtendedLengthPath(L"d:/" + tail + L"/x"));
+  EXPECT_EQ(L"\\\\?\\UNC\\server\\share\\" + tail,
+            ExtendedLengthPath(L"\\\\server\\share\\" + tail));
+  EXPECT_EQ(L"\\\\?\\UNC\\server\\share\\" + tail,
+            ExtendedLengthPath(L"//server/share/" + tail));
+  EXPECT_EQ(L"\\\\?\\C:\\" + tail,
+            ExtendedLengthPath(L"\\\\?\\C:\\" + tail));
+  EXPECT_EQ(L"\\\\.\\C:\\" + tail,
+            ExtendedLengthPath(L"\\\\.\\C:\\" + tail));
+  EXPECT_EQ(L"Ardia\\" + tail, ExtendedLengthPath(L"Ardia\\" + tail));
+  EXPECT_EQ(L"Ardia/" + tail + L"/x",
+            ExtendedLengthPath(L"Ardia/" + tail + L"/x"));
+  EXPECT_EQ(L"\\" + tail, ExtendedLengthPath(L"\\" + tail));
+  EXPECT_EQ(L"C:" + tail, ExtendedLengthPath(L"C:" + tail));
+  EXPECT_EQ(L"\\\\?\\C:\\a\\" + tail + L"\\y",
+            ExtendedLengthPath(L"C:\\a\\.\\b\\..\\" + tail + L"\\x\\..\\y"));
+  EXPECT_EQ(L"\\\\?\\C:\\" + tail, ExtendedLengthPath(L"C:\\..\\..\\" + tail));
+  EXPECT_EQ(L"\\\\?\\C:\\a\\" + tail,
+            ExtendedLengthPath(L"C:/a//./" + tail + L"/"));
+  EXPECT_EQ(L"\\\\?\\UNC\\server\\share\\" + tail,
+            ExtendedLengthPath(L"\\\\server\\share\\..\\..\\" + tail));
+  EXPECT_EQ(L"\\\\?\\UNC\\server\\share\\" + tail,
+            ExtendedLengthPath(L"//server/share/a/./../" + tail));
+  EXPECT_EQ(L"\\\\?\\UNC\\server\\share\\",
+            ExtendedLengthPath(L"\\\\server\\share\\" + tail + L"\\.."));
+  EXPECT_EQ(L"\\\\" + tail, ExtendedLengthPath(L"\\\\" + tail));
+}
