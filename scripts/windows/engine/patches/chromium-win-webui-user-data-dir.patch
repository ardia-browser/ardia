+bool PlainFileExists(const std::wstring& path) {
+  if (path.empty())
+    return false;
+  const DWORD attributes = ::GetFileAttributesW(path.c_str());
+  return attributes != INVALID_FILE_ATTRIBUTES &&
+         (attributes &
+          (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) == 0;
+}
+
+std::wstring ExtendedLengthPath(std::wstring path) {
+  if (path.size() < MAX_PATH)
+    return path;
+  const auto separator = [](wchar_t c) { return c == L'\\' || c == L'/'; };
+  if (separator(path[0]) && separator(path[1]) &&
+      (path[2] == L'?' || path[2] == L'.') && separator(path[3])) {
+    return path;
+  }
+  const bool unc = separator(path[0]) && separator(path[1]);
+  const bool drive = ((path[0] >= L'A' && path[0] <= L'Z') ||
+                      (path[0] >= L'a' && path[0] <= L'z')) &&
+                     path[1] == L':' && separator(path[2]);
+  if (!unc && !drive)
+    return path;
+  std::vector<std::wstring> segments;
+  size_t fixed = 0;
+  size_t start = unc ? 2 : 3;
+  while (start <= path.size()) {
+    size_t end = start;
+    while (end < path.size() && !separator(path[end]))
+      ++end;
+    const std::wstring segment = path.substr(start, end - start);
+    start = end + 1;
+    if (segment.empty() || segment == L".")
+      continue;
+    if (segment == L"..") {
+      if (segments.size() > fixed)
+        segments.pop_back();
+      continue;
+    }
+    segments.push_back(segment);
+    if (unc && fixed < 2)
+      fixed = segments.size();
+  }
+  if (unc && fixed < 2)
+    return path;
+  std::wstring extended =
+      unc ? std::wstring(L"\\\\?\\UNC") : L"\\\\?\\" + path.substr(0, 2);
+  for (const std::wstring& segment : segments)
+    extended += L"\\" + segment;
+  if (segments.size() == fixed)
+    extended += L"\\";
+  return extended;
+}
+
+std::wstring ReactNativeAppLibraryPath() {
+  const std::wstring folder = ExecutableDirectory();
+  if (folder.empty())
+    return std::wstring();
+  const std::wstring library = ExtendedLengthPath(folder + L"ArdiaApp.dll");
+  return PlainFileExists(library) ? library : std::wstring();
+}
+
+bool ReactNativeAppLibraryBesideExe() {
+  if (g_react_native_app_library_present_for_testing.has_value())
+    return *g_react_native_app_library_present_for_testing;
+  LONG state = ::InterlockedCompareExchange(
+      &g_react_native_app_library_state, kReactNativeAppLibraryUnprobed,
+      kReactNativeAppLibraryUnprobed);
+  if (state == kReactNativeAppLibraryUnprobed) {
+    const LONG probed = ReactNativeAppLibraryPath().empty()
+                            ? kReactNativeAppLibraryAbsent
+                            : kReactNativeAppLibraryPresent;
+    state = ::InterlockedCompareExchange(&g_react_native_app_library_state,
+                                         probed, kReactNativeAppLibraryUnprobed);
+    if (state == kReactNativeAppLibraryUnprobed)
+      state = probed;
+  }
+  return state == kReactNativeAppLibraryPresent;
+}
