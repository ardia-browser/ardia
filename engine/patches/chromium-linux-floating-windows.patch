 gfx::Size OpaqueBrowserFrameView::GetMinimumSize() const {
+  if (const auto pinned = ArdiaLinuxPinnedWindowSize(this)) {
+    return *pinned;
+  }
   return layout_->GetMinimumSize(this);
 }
 
+gfx::Size OpaqueBrowserFrameView::GetMaximumSize() const {
+  if (const auto pinned = ArdiaLinuxPinnedWindowSize(this)) {
+    return *pinned;
+  }
+  return BrowserFrameView::GetMaximumSize();
+}
