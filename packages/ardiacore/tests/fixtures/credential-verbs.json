          }
        }
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "create",
          "item",
          "--nointeraction"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "BW_SESSION": "session0123456789abcdefSESSIONKEY"
        },
        "stdin": "eyJsb2dpbiI6eyJ1cmlzIjpbeyJ1cmkiOiJodHRwczovL2V4YW1wbGUuY29tLyJ9XSwidXNlcm5hbWUiOiJhIn0sIm5hbWUiOiJFeGFtcGxlIiwidHlwZSI6MX0=",
        "timeoutMs": 60000,
        "signIn": false
      }
    },
    {
      "name": "a json slot goes to stdin as utf8 when asked",
      "manifest": "bw",
      "verb": "edit.item",
