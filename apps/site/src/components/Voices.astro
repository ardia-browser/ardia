---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { VOICES } from "../data/voices";
import andywang from "../assets/voices/andywang.jpg";
import charlielamb from "../assets/voices/charlielamb.jpg";
import itsomsarraf from "../assets/voices/itsomsarraf.jpg";
import jsmasterypro from "../assets/voices/jsmasterypro.jpg";
import lukeJudges from "../assets/voices/luke_judges.jpg";
import mielkeJack from "../assets/voices/mielke_jack.jpg";
import mkbhd from "../assets/voices/mkbhd.jpg";
import pablopunk from "../assets/voices/pablopunk.jpg";
import sprice from "../assets/voices/sprice.jpg";
import thaetos from "../assets/voices/thaetos.png";
import theo from "../assets/voices/theo.jpg";

const avatars: Record<string, ImageMetadata> = {
  andywang,
  charlielamb,
  itsomsarraf,
  jsmasterypro,
  luke_judges: lukeJudges,
  mielke_jack: mielkeJack,
  mkbhd,
  pablopunk,
  sprice,
  thaetos,
  theo,
};

const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0])
    .join("")
    .toUpperCase();

const groups = [
  { name: "lead", label: "Testimonials", voices: VOICES.filter((v) => v.featured) },
  { name: "rest", label: "More testimonials", voices: VOICES.filter((v) => !v.featured) },
];
---

<section class="voices paint edge edge-b" data-paint="dusk" id="voices" aria-labelledby="voices-title" data-shot="voices">
  <div class="wrap">
    <header class="voices-head">
      <p class="label kicker">From the feed</p>
      <h2 class="poster" id="voices-title">What people say.</h2>
    </header>

    {
      groups.map((group) => (
        <ul class={group.name} role="list" aria-label={group.label}>
          {group.voices.map((v) => {
            const avatar = avatars[v.avatar];
            return (
              <li class="quote">
                <figure class="voice">
                  <blockquote>
                    <p>{v.quote}</p>
                  </blockquote>
                  <figcaption>
                    <a class="by" href={v.href} rel="noopener">
                    <span class="face">
                      {avatar ? (
                        <Image src={avatar} alt="" width={64} height={64} densities={[1, 2]} />
                      ) : (
                        <span class="initials" aria-hidden="true">
                          {initials(v.name)}
                        </span>
                      )}
                    </span>
                    <span class="who">
                      <span class="name">{v.name}</span>
                      <span class="meta">
                        <span class="handle">{v.handle}</span>
                        <span class="label source">{v.sourceLabel}</span>
                      </span>
                    </span>
                    </a>
                  </figcaption>
                </figure>
              </li>
            );
          })}
        </ul>
      ))
    }
  </div>
</section>

<style>
  .voices {
    padding: var(--section) 0;
  }

  .voices-head {
    max-width: 42em;
  }

  h2 {
    font-size: var(--t-h2);
  }

  .lead,
  .rest {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lead {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.95fr);
    gap: 28px clamp(24px, 3vw, 40px);
    margin-top: clamp(40px, 5vw, 72px);
    align-items: stretch;
  }

  .rest {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(24px, 2.6vw, 34px) clamp(24px, 3vw, 36px);
    margin-top: clamp(32px, 3.6vw, 48px);
    align-items: stretch;
  }

  .rest .quote:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .quote {
    min-width: 0;
    filter:
      drop-shadow(0 1px 1px rgb(22 19 15 / 0.1))
      drop-shadow(0 16px 28px rgb(74 28 24 / 0.15));
  }

  .voice {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    height: 100%;
    margin: 0;
    padding: 26px 26px 22px;
    color: var(--day-ink);
  }

  .voice::before,
  .voice::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    z-index: -1;
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 256px;
    background-blend-mode: soft-light;
    -webkit-mask:
      var(--edge-a) var(--tear-x, 0%) 0 / 760px 9px repeat-x,
      linear-gradient(#000 0 0) 0 8px / 100% 100% no-repeat;
    mask:
      var(--edge-a) var(--tear-x, 0%) 0 / 760px 9px repeat-x,
      linear-gradient(#000 0 0) 0 8px / 100% 100% no-repeat;
  }

  .voice::before {
    top: 0;
    bottom: 8px;
  }

  .voice::after {
    bottom: 0;
    height: 9px;
    scale: 1 -1;
    -webkit-mask: var(--edge-b) var(--tear-b, 37%) 0 / 760px 9px repeat-x;
    mask: var(--edge-b) var(--tear-b, 37%) 0 / 760px 9px repeat-x;
  }

  .quote:nth-child(2n) .voice {
    --tear-x: 41%;
    --tear-b: 13%;
  }

  .quote:nth-child(3n) .voice {
    --tear-x: 68%;
    --tear-b: 59%;
  }

  .lead .voice {
    padding: clamp(30px, 3.2vw, 40px) clamp(26px, 3vw, 38px) clamp(26px, 2.8vw, 32px);
    gap: 28px;
  }

  .lead blockquote::before {
    content: "";
    display: block;
    width: 28px;
    height: 4.5px;
    margin-bottom: 18px;
    border-radius: 55% 45% 60% 40% / 70% 60% 50% 40%;
    background-color: var(--forest);
    background-image: var(--impasto);
    background-size: 120px;
    background-blend-mode: soft-light;
    transform: rotate(-2deg);
  }

  blockquote {
    margin: 0;
  }

  blockquote p {
    position: relative;
    font-size: clamp(1rem, 0.96rem + 0.16vw, 1.1rem);
    font-weight: 440;
    line-height: 1.52;
    letter-spacing: -0.008em;
    max-width: 44ch;
    color: var(--day-ink);
    text-wrap: pretty;
  }

  blockquote p::before {
    content: "\201C";
    position: absolute;
    right: 100%;
    top: 0;
    padding-right: 0.04em;
  }

  blockquote p::after {
    content: "\201D";
  }

  .lead blockquote p {
    font-family: var(--sans);
    font-size: clamp(1.34rem, 1.04rem + 0.92vw, 1.88rem);
    font-weight: 560;
    line-height: 1.28;
    letter-spacing: -0.024em;
    max-width: 27ch;
    text-wrap: balance;
  }

  .by {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    min-height: 44px;
    color: var(--day-ink);
    text-decoration: none;
  }

  .face {
    flex: none;
    width: 38px;
    height: 38px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--paper-deep);
    box-shadow: 0 0 0 1px rgb(22 19 15 / 0.18);
  }

  .lead .face {
    width: 46px;
    height: 46px;
  }

  .face :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--sans);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #16130f;
  }

  .who {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
  }

  .name {
    font-size: 0.95rem;
    font-weight: 640;
    letter-spacing: -0.016em;
    line-height: 1.25;
    color: var(--day-ink);
    text-decoration: underline transparent;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 150ms;
  }

  .lead .name {
    font-size: 1.02rem;
  }

  .meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 10px;
    color: #4d524a;
    line-height: 1.3;
  }

  .handle {
    font-size: 0.82rem;
    font-weight: 450;
  }

  .source {
    color: #595d53;
  }

  @media (hover: hover) {
    .by:hover .name {
      text-decoration-color: currentColor;
    }
  }

  @media (max-width: 820px) {
    .lead,
    .rest {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead {
      gap: 20px;
    }
    .rest {
      gap: 18px;
      margin-top: 20px;
    }
    .voice {
      padding: 22px 20px 18px 26px;
      gap: 16px;
    }
    .lead .voice {
      justify-content: flex-start;
      padding: 24px 20px 20px 28px;
      gap: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .name {
      transition: none;
    }
  }
</style>
