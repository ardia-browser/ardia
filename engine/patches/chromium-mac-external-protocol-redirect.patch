+WeakDocumentPtr ArdiaBrowserRedirectDocument(WebContents* contents,
+                                            const GURL& app_url,
+                                            const url::Origin& redirector) {
+  auto& tree = static_cast<WebContentsImpl*>(contents)->GetPrimaryFrameTree();
+  NavigationRequest* request = tree.root()->navigation_request();
+  if (!request || request->IsRendererInitiated() ||
+      request->GetInitiatorFrameToken() || request->GetInitiatorOrigin() ||
+      !request->WasServerRedirect() || request->GetURL() != app_url) {
+    return {};
+  }
+  const auto& chain = request->GetRedirectChain();
+  if (chain.size() < 2 || !chain.front().SchemeIsHTTPOrHTTPS() ||
+      !chain[chain.size() - 2].SchemeIsHTTPOrHTTPS() ||
+      url::Origin::Create(chain[chain.size() - 2]) != redirector) {
+    return {};
+  }
+  return contents->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+}
