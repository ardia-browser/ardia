+
+void PrefHashFilter::SetAsideForSafeStorage(
+    const base::DictValue& contents_before_checks,
+    base::DictValue& pref_store_contents,
+    const std::set<std::string>& reset_paths) {
+  base::ListValue* reset_list =
+      pref_store_contents.FindList(user_prefs::kTrackedPreferencesReset);
+  for (const std::string& path : reset_paths) {
+    const auto tracked = tracked_paths_.find(path);
+    if (tracked == tracked_paths_.end()) {
+      continue;
+    }
+    const std::string stored_hash_path =
+        base::StrCat({kProtectedHashesPath, path, kEncryptedHashSuffix});
+    base::DictValue entries;
+    if (tracked->second->GetType() == TrackedPreferenceType::SPLIT) {
+      const base::DictValue* before =
+          contents_before_checks.FindDictByDottedPath(path);
+      const base::DictValue* after =
+          pref_store_contents.FindDictByDottedPath(path);
+      const base::DictValue* encrypted_hashes =
+          contents_before_checks.FindDictByDottedPath(stored_hash_path);
+      if (!before || !encrypted_hashes) {
+        continue;
+      }
+      for (const auto [key, value] : *before) {
+        const std::string* hash = encrypted_hashes->FindString(key);
+        if (!hash || (after && after->contains(key))) {
+          continue;
+        }
+        entries.Set(key, base::DictValue()
+                             .Set(kAwaitingValueKey, value.Clone())
+                             .Set(kAwaitingHashKey, *hash));
+        if (reset_list) {
+          reset_list->EraseValue(base::Value(base::StrCat({path, ".", key})));
+        }
+      }
+    } else {
+      const base::Value* before = contents_before_checks.FindByDottedPath(path);
+      const base::Value* after = pref_store_contents.FindByDottedPath(path);
+      const std::string* hash =
+          contents_before_checks.FindStringByDottedPath(stored_hash_path);
+      if (!before || !hash || (after && *after == *before)) {
+        continue;
+      }
+      entries.Set(kAwaitingAtomicKey,
+                  base::DictValue()
+                      .Set(kAwaitingValueKey, before->Clone())
+                      .Set(kAwaitingHashKey, *hash));
+      if (reset_list) {
+        reset_list->EraseValue(base::Value(path));
+      }
+    }
+    if (entries.empty()) {
+      continue;
+    }
+    base::DictValue* kept = awaiting_safe_storage_.EnsureDict(path);
+    for (auto [key, entry] : entries) {
+      kept->Set(key, std::move(entry));
+    }
+  }
+}
+
+bool PrefHashFilter::RestoreVerifiedForThisMachine(
+    base::DictValue& pref_store_contents,
+    PrefHashStoreTransaction* transaction) {
+  bool changed = false;
+  base::ListValue* reset_list = nullptr;
+  const auto list_reset = [&](std::string entry) {
+    if (!reset_list) {
+      reset_list =
+          pref_store_contents.EnsureList(user_prefs::kTrackedPreferencesReset);
+    }
+    AppendOnce(*reset_list, std::move(entry));
+  };
+  for (const auto& [path, preference] : tracked_paths_) {
+    base::DictValue* entries = awaiting_safe_storage_.FindDict(path);
+    if (!entries) {
+      continue;
+    }
+    const std::string hash_path = base::StrCat({path, kEncryptedHashSuffix});
+    std::vector<std::string> settled;
+    if (preference->GetType() == TrackedPreferenceType::SPLIT) {
+      bool restored = false;
+      for (const auto [key, entry] : *entries) {
+        const AwaitingFields fields = FieldsOf(entry);
+        if (!fields.value || !fields.encrypted_hash || !fields.hmac) {
+          continue;
+        }
+        settled.push_back(key);
+        const std::string keyed_path = base::StrCat({path, ".", key});
+        if (pref_hash_store_->ComputeHmac(keyed_path, fields.value) !=
+            *fields.hmac) {
+          list_reset(keyed_path);
+          continue;
+        }
+        base::DictValue* live = pref_store_contents.FindDictByDottedPath(path);
+        if (live && live->contains(key)) {
+          continue;
+        }
+        if (!live) {
+          live = &pref_store_contents.SetByDottedPath(path, base::DictValue())
+                      ->GetDict();
+        }
+        live->Set(key, fields.value->Clone());
+        DictionaryHashStoreContents(pref_store_contents)
+            .SetSplitPrefAuthenticator(hash_path, key, *fields.encrypted_hash);
+        restored = true;
+      }
+      if (restored) {
+        transaction->StoreSplitHmac(
+            path, pref_store_contents.FindDictByDottedPath(path));
+      }
+    } else if (const base::Value* entry = entries->Find(kAwaitingAtomicKey)) {
+      const AwaitingFields fields = FieldsOf(*entry);
+      if (fields.value && fields.encrypted_hash && fields.hmac) {
+        settled.push_back(kAwaitingAtomicKey);
+        if (pref_hash_store_->ComputeHmac(path, fields.value) != *fields.hmac) {
+          list_reset(path);
+        } else if (!pref_store_contents.FindByDottedPath(path)) {
+          pref_store_contents.SetByDottedPath(path, fields.value->Clone());
+          DictionaryHashStoreContents(pref_store_contents)
+              .SetAtomicPrefAuthenticator(hash_path, *fields.encrypted_hash);
+          transaction->StoreHmac(path,
+                                 pref_store_contents.FindByDottedPath(path));
+        }
+      }
+    }
+    for (const std::string& key : settled) {
+      entries->Remove(key);
+    }
+    if (entries->empty()) {
+      awaiting_safe_storage_.Remove(path);
+    }
+    changed = changed || !settled.empty();
   }
+  return changed;
 }
 
+bool PrefHashFilter::VerifiedBySafeStorage(
+    const std::string& path,
+    const std::string* key,
+    const base::Value& value,
+    const std::string& encrypted_hash) const {
+  base::DictValue storage;
+  DictionaryHashStoreContents hashes(storage);
+  const std::string hash_path = base::StrCat({path, kEncryptedHashSuffix});
+  if (key) {
+    hashes.SetSplitPrefAuthenticator(hash_path, *key, encrypted_hash);
+  } else {
+    hashes.SetAtomicPrefAuthenticator(hash_path, encrypted_hash);
+  }
+  std::unique_ptr<PrefHashStoreTransaction> transaction(
+      pref_hash_store_->BeginTransaction(&hashes, encryptor_));
+  if (!key) {
+    return transaction->CheckValue(path, &value) ==
+           ValueState::UNCHANGED_ENCRYPTED;
+  }
+  base::DictValue entry;
+  entry.Set(*key, value.Clone());
+  std::vector<std::string> invalid_keys;
+  return transaction->CheckSplitValue(path, &entry, &invalid_keys) ==
+         ValueState::UNCHANGED_ENCRYPTED;
+}
+
+void PrefHashFilter::VerifyAwaitingSafeStorage() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  CHECK(encryptor_);
+  if (awaiting_safe_storage_.empty() ||
+      !encryptor_->IsDecryptionAvailable()) {
+    return;
+  }
+  base::ListValue reset_list =
+      pref_service_->GetList(user_prefs::kTrackedPreferencesReset).Clone();
+  const size_t resets_before = reset_list.size();
+  for (const auto& [path, preference] : tracked_paths_) {
+    base::DictValue* entries = awaiting_safe_storage_.FindDict(path);
+    if (!entries) {
+      continue;
+    }
+    const bool split =
+        preference->GetType() == TrackedPreferenceType::SPLIT;
+    std::vector<std::string> failed;
+    for (auto [key, entry] : *entries) {
+      const AwaitingFields fields = FieldsOf(entry);
+      if (fields.hmac) {
+        continue;
+      }
+      const std::string reported_path =
+          split ? base::StrCat({path, ".", key}) : path;
+      if (!fields.value || !fields.encrypted_hash ||
+          !VerifiedBySafeStorage(path, split ? &key : nullptr, *fields.value,
+                                 *fields.encrypted_hash)) {
+        failed.push_back(key);
+        AppendOnce(reset_list, reported_path);
+        continue;
+      }
+      entry.GetDict().Set(kAwaitingHmacKey, pref_hash_store_->ComputeHmac(
+                                                reported_path, fields.value));
+    }
+    for (const std::string& key : failed) {
+      entries->Remove(key);
+    }
+    if (entries->empty()) {
+      awaiting_safe_storage_.Remove(path);
+    }
+  }
+  if (reset_list.size() != resets_before) {
+    pref_service_->SetList(user_prefs::kTrackedPreferencesReset,
+                           std::move(reset_list));
+  }
+}
