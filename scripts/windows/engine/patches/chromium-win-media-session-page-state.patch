+bool MediaSessionImpl::ArdiaWinOnPrimaryPage() {
+  const auto on_primary_page = [](RenderFrameHost* frame) {
+    return frame && frame->IsActive() && frame->GetPage().IsPrimary();
+  };
+  for (const auto& player : normal_players_) {
+    if (!on_primary_page(player.first.observer->render_frame_host())) {
+      return false;
+    }
+  }
+  for (const auto& player : one_shot_players_) {
+    if (!on_primary_page(player.observer->render_frame_host())) {
+      return false;
+    }
+  }
+  for (const auto& player : ambient_players_) {
+    if (!on_primary_page(player.observer->render_frame_host())) {
+      return false;
+    }
+  }
+  return !routed_service_ ||
+         on_primary_page(routed_service_->GetRenderFrameHost());
 }
 
+std::vector<media_session::MediaImage> MediaSessionImpl::ArdiaWinArtwork()
+    const {
+  const auto artwork = images_.find(MediaSessionImageType::kArtwork);
+  return artwork != images_.end() ? artwork->second
+                                  : std::vector<media_session::MediaImage>();
+}
