assert(is_win)

declare_args() {
  ardia_linux_compile_probe = false
}

if (ardia_linux_compile_probe) {
  group("linux_compile_probe") {
    deps = [ "//ardia/linux:compile_probe" ]
  }
}

action("webui_bootstrap") {
  script = "//ardia/linux/generate_bootstrap.py"
  sources = [ "//ardia/linux/bootstrap.js" ]
  outputs = [ "$root_gen_dir/ardia/linux/host_bootstrap.h" ]
  args = [
    "--input",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

source_set("win") {
  sources = [
    "//ardia/linux/ac_linux_contract.h",
    "//ardia/linux/ac_linux_session.cc",
    "//ardia/linux/ac_linux_session.h",
    "ac_calls.cc",
    "ac_calls.h",
    "api.cc",
    "api.h",
    "autoplay.cc",
    "autoplay.h",
    "context_menu.cc",
    "context_menu.h",
    "extension_actions.cc",
    "extension_actions.h",
    "external_apps.cc",
    "external_apps.h",
    "frame_view.cc",
    "frame_view.h",
    "hooks.h",
    "host.cc",
    "host.h",
    "host_visibility.cc",
    "kept_pages.cc",
    "kept_pages.h",
    "launch_guard.cc",
    "launch_guard.h",
    "main.cc",
    "main.h",
    "page_links.cc",
    "page_links.h",
    "page_links_internal.h",
    "page_links_peek.cc",
    "page_links_session.cc",
    "page_links_script.h",
    "private_sessions.cc",
    "private_sessions.h",
    "profiles.cc",
    "profiles.h",
    "public/EngineApi.h",
    "renderer_efficiency.cc",
    "renderer_efficiency.h",
    "tab_calls.cc",
    "tab_calls.h",
    "tab_events.cc",
    "tab_events.h",
    "tab_state.cc",
    "tab_state.h",
    "test_gate.cc",
