+constexpr wchar_t kBaseWhitespace[] = {
+    0x09,   0x0B,   0x0C,   0x20,   0x0A,   0x0D,   0x0085, 0x00A0,
+    0x1680, 0x2000, 0x2001, 0x2002, 0x2003, 0x2004, 0x2005, 0x2006,
+    0x2007, 0x2008, 0x2009, 0x200A, 0x2028, 0x2029, 0x202F, 0x205F,
+    0x3000, 0};
+
+std::wstring TrimmedLikeBase(const std::wstring& text) {
+  const size_t first = text.find_first_not_of(kBaseWhitespace);
+  if (first == std::wstring::npos)
+    return std::wstring();
+  const size_t last = text.find_last_not_of(kBaseWhitespace);
+  return text.substr(first, last - first + 1);
+}
+
+size_t SwitchPrefixLength(const std::wstring& text) {
+  for (const wchar_t* prefix : {L"--", L"-", L"/"}) {
+    const size_t length = ::wcslen(prefix);
+    if (text.compare(0, length, prefix) == 0)
+      return length;
+  }
+  return 0;
+}
+
+std::wstring AsciiLower(std::wstring text) {
+  for (wchar_t& c : text) {
+    if (c >= L'A' && c <= L'Z')
+      c = static_cast<wchar_t>(c - L'A' + L'a');
+  }
+  return text;
+}
+
+struct LaunchSwitches {
+  std::wstring shell;
+  std::wstring process_type;
+  bool headless = false;
+};
+
+LaunchSwitches ParseLaunchSwitches(const std::wstring& command_line) {
+  LaunchSwitches switches;
+  const std::wstring trimmed = TrimmedLikeBase(command_line);
+  if (trimmed.empty())
+    return switches;
+  const std::vector<std::wstring> tokens = TokenizeCommandLineToArray(trimmed);
+  bool parse_switches = true;
+  for (size_t i = 1; i < tokens.size(); ++i) {
+    const std::wstring arg = TrimmedLikeBase(tokens[i]);
+    parse_switches = parse_switches && arg != L"--";
+    if (!parse_switches)
+      continue;
+    const size_t prefix = SwitchPrefixLength(arg);
+    if (prefix == 0 || prefix == arg.size())
+      continue;
+    const size_t equals = arg.find(L'=');
+    const std::wstring switch_string = arg.substr(0, equals);
+    if (switch_string.substr(prefix) == L"single-argument")
+      break;
+    const std::wstring key = AsciiLower(switch_string);
+    const std::wstring name = key.substr(SwitchPrefixLength(key));
+    const std::wstring value =
+        equals == std::wstring::npos ? std::wstring() : arg.substr(equals + 1);
+    if (name == L"ardia-shell")
+      switches.shell = value;
+    else if (name == L"type")
+      switches.process_type = value;
+    else if (name == L"headless")
+      switches.headless = true;
+  }
+  return switches;
 }
 
+bool IsHeadlessMode(const std::wstring& command_line) {
+  return ParseLaunchSwitches(command_line).headless;
+}
