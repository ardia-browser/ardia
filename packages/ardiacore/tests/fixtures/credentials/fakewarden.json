{
  "manifest": 2,
  "name": "fakewarden",
  "title": "Fakewarden",
  "description": "A fake password manager for the native credential tests.",
  "version": "1.0.0",
  "requires": "1.41.0",
  "official": true,
  "main": "dist/main.js",
  "contributes": {
    "credentialProvider": {
      "title": "Fakewarden",
      "symbol": "key.fill",
      "accent": "#175DDC",
      "capabilities": [
        "totp",
        "save",
        "masterPassword",
        "touchID"
      ],
      "signIn": {
        "methods": [
          {
            "id": "password",
            "title": "Email and Password",
            "fields": [
              {
                "id": "email",
                "title": "Email",
                "type": "email"
              },
              {
                "id": "masterPassword",
                "title": "Master Password",
                "type": "secret"
              }
            ]
          }
        ],
        "servers": [
          {
            "id": "us",
            "title": "Fakewarden.com"
          },
          {
            "id": "self",
            "title": "Self-Hosted",
            "custom": {
              "title": "Server URL"
            }
          }
        ],
        "unlock": {
          "field": "masterPassword"
        }
      },
      "cli": {
        "name": "bw",
        "install": {
          "command": "brew install fakewarden",
          "url": "https://example.com/fakewarden"
        },
        "minimumVersion": "2024.6.0",
        "patterns": {
          "word": "^[a-z0-9-]{1,20}$",
          "count": "^[0-9]{1,6}$"
        },
        "env": [
          {
            "name": "BW_NOINTERACTION",
            "literal": "true"
          },
          {
            "name": "FAKE_STATE_DIR",
            "testFolder": ""
          }
        ],
        "onLock": {
          "verb": "lock",
          "params": {
            "session": {
              "from": "session"
            }
          }
        },
        "verbs": {
          "status": {
            "argv": [
              "status"
            ],
            "slots": {
              "session": {
                "type": "secret",
                "optional": true
              }
            },
            "env": [
              {
                "name": "BW_SESSION",
                "secretSlot": "session"
              }
            ],
            "output": {
              "mode": "json"
            }
          },
          "login": {
            "argv": [
              "login",
              {
                "slot": "email"
              }
            ],
            "slots": {
              "email": {
                "type": "email"
              },
              "password": {
                "type": "secret"
              }
            },
            "env": [
              {
                "name": "ARDIA_BW_PASSWORD",
                "secretSlot": "password"
              }
            ],
            "signIn": true,
            "output": {
              "mode": "lastLineSecret"
            },
            "unlocks": {
              "persistent": true
            },
            "hints": {
              "wrongCredentials": [
                "username or password is incorrect"
              ]
            }
          },
          "unlock": {
            "argv": [
              "unlock"
            ],
            "slots": {
              "password": {
                "type": "secret"
              }
            },
            "env": [
              {
                "name": "ARDIA_BW_PASSWORD",
                "secretSlot": "password"
              }
            ],
            "signIn": true,
            "output": {
              "mode": "lastLineSecret"
            },
            "unlocks": true
          },
          "lock": {
            "argv": [
              "lock"
            ],
            "slots": {
              "session": {
                "type": "secret",
                "optional": true
              }
            },
            "env": [
              {
                "name": "BW_SESSION",
                "secretSlot": "session"
              }
            ],
            "output": {
              "mode": "lines"
            }
          },
          "list.items": {
            "argv": [
              "list",
              {
                "slot": "count"
              }
            ],
            "slots": {
              "session": {
                "type": "secret"
              },
              "count": {
                "type": "id",
                "pattern": "count"
              }
            },
            "env": [
              {
                "name": "BW_SESSION",
                "secretSlot": "session"
              }
            ],
            "timeoutMs": 60000,
            "outputLimitBytes": 167772160,
            "output": {
              "mode": "json",
              "items": "$"
            }
          },
          "list.json": {
            "argv": [
              "list",
              {
                "slot": "count"
              }
            ],
            "slots": {
              "session": {
                "type": "secret"
              },
              "count": {
                "type": "id",
                "pattern": "count"
              }
            },
            "env": [
              {
                "name": "BW_SESSION",
                "secretSlot": "session"
              }
            ],
            "output": {
              "mode": "json"
            }
          },
          "get.password": {
            "argv": [
              "get",
              "password",
              {
                "slot": "id"
              }
            ],
            "slots": {
              "session": {
                "type": "secret"
              },
              "id": {
                "type": "id",
                "pattern": "word"
              }
            },
            "env": [
              {
                "name": "BW_SESSION",
                "secretSlot": "session"
              }
            ],
            "output": {
              "mode": "lines"
            }
          },
          "sleep": {
            "argv": [
              "sleep",
              {
                "slot": "seconds"
              }
            ],
            "slots": {
              "seconds": {
                "type": "id",
                "pattern": "count"
              }
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "lines"
            }
          },
          "stream": {
            "argv": [
              "stream",
              {
                "slot": "count"
              }
            ],
            "slots": {
              "count": {
                "type": "id",
                "pattern": "count"
              }
            },
            "signIn": true,
            "output": {
              "mode": "stream"
            }
          },
          "env": {
            "argv": [
              "env"
            ],
            "output": {
              "mode": "lines"
            }
          },
          "echo": {
            "argv": [
              "echo"
            ],
            "slots": {
              "password": {
                "type": "secret"
              }
            },
            "env": [
              {
                "name": "ARDIA_BW_PASSWORD",
                "secretSlot": "password"
              }
            ],
            "output": {
              "mode": "lines"
            }
          },
          "sub": {
            "argv": [
              "--nointeraction",
              {
                "slot": "word"
              }
            ],
            "slots": {
              "word": {
                "type": "id",
                "pattern": "word"
              }
            },
            "output": {
              "mode": "lines"
            }
          }
        }
      }
    }
  }
}
