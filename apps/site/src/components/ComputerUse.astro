---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { computerUse as cu } from "../data/computerUse";
import ardiaLogo from "../assets/app-icon.png";
import asideLogo from "../assets/logos/aside.png";
import opencodeLogo from "../assets/logos/opencode.png";

interface Props {
  page?: boolean;
}
const { page = false } = Astro.props;
const Title = page ? "h1" : "h2";

const logos: Record<string, ImageMetadata> = {
  ardia: ardiaLogo,
  aside: asideLogo,
  opencode: opencodeLogo,
};

const runsText = (passes: number, runs: number) => (passes === runs ? `all ${runs} passed` : `passed ${passes} of ${runs}`);
---

<section
  class:list={["cu paint", { edge: !page, "cu-page": page }]}
  data-paint="noon"
  id="cli"
  aria-labelledby="cu-title"
  data-shot="computer-use"
>
  <div class="wrap">
    <header class="cu-head">
      <div class="cu-title">
        <p class="label kicker">Bring your own agent</p>
        <Title class="poster cu-heading" id="cu-title">Drive it by CLI.</Title>
        <p class="lede">
          Drive Ardia from Claude Code or Codex with <code>ardia browse</code>, logins included, or automate other Mac apps with{" "}
          <code>ardia computer</code>. Below: median tokens across {cu.taskCount} tasks, lower is better.
        </p>
        {!cu.complete && <p class="label status">Bench in progress, {cu.runs} of {cu.planned} runs so far</p>}
      </div>
    </header>

    <div class="sheet-card" data-cu-root>
      <div class="card-bar">
        <div class="model-tabs" role="tablist" aria-label="Select model benchmark" data-cu-tabs>
          {
            cu.charts.map((c, idx) => (
              <button
                type="button"
                role="tab"
                id={`cu-tab-${idx}`}
                aria-controls={`cu-panel-${idx}`}
                class:list={["model-tab", { "is-active": idx === 0 }]}
                aria-selected={idx === 0 ? "true" : "false"}
                tabindex={idx === 0 ? 0 : -1}
                data-cu-tab={idx}
              >
                <span class="tab-model">{c.model}</span>
                <span class="tab-agent">{c.agentName}</span>
              </button>
            ))
          }
        </div>

        <div class="win-stack">
          {
            cu.charts.map((c, idx) => (
              <div class:list={["model-win", { "is-active": idx === 0 }]} data-cu-win={idx}>
                <span class="win-pill">
                  <b>{c.headline.figure}</b> fewer tokens
                </span>
                <span class="model-sub">
                  vs OpenCode{c.headline.secondary ? ` · ${c.headline.secondary.replace(" fewer than Aside", " vs Aside")}` : ""}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      {
        cu.charts.map((c, idx) => (
          <div
            id={`cu-panel-${idx}`}
            role="tabpanel"
            aria-labelledby={`cu-tab-${idx}`}
            class:list={["table-panel", { "is-active": idx === 0 }]}
            hidden={idx !== 0}
            data-cu-panel={idx}
          >
            <div class="table-wrap">
              <table class="cu-table">
                <caption class="visually-hidden">
                  {c.title}, {c.agent}: median tokens per task, lower is better
                </caption>
                <colgroup>
                  <col class="cu-task" />
                  {c.series.map(() => <col class="cu-num" />)}
                  <col class="cu-x" />
                </colgroup>
                <thead>
                  <tr>
                    <th scope="col" class="task-col">Task</th>
                    {c.series.map((s) => {
                      const logo = logos[s.side];
                      return (
                        <th scope="col" class="num-col" data-side={s.side}>
                          <span class="col-head">
                            {logo ? (
                              <Image class="brand-logo" src={logo} alt="" width={20} height={20} densities={[1, 2]} />
                            ) : (
                              <i class="dot" aria-hidden="true" />
                            )}
                            <span>{s.name}</span>
                          </span>
                        </th>
                      );
                    })}
                    <th scope="col" class="x-col">Comparison</th>
                  </tr>
                </thead>
                <tbody>
                  {c.rows.map((row) => (
                    <tr>
                      <th scope="row" title={row.title}>
                        <span class="task-full">{row.title}</span>
                        <span class="task-short">{row.task}</span>
                        {row.callout && (
                          <span class:list={["m-callout", { loss: row.callout.loss }]}>
                            <b>{row.callout.figure}</b> {row.callout.line}
                          </span>
                        )}
                      </th>
                      {row.cells.map((cell) => (
                        <td
                          class:list={["num", { best: cell.isBest, partial: cell.partial, none: cell.value === null }]}
                          data-side={cell.side}
                          title={cell.value !== null ? `${row.task}, ${cell.name}: ${cell.text}, ${runsText(cell.passes, cell.runs)}` : undefined}
                        >
                          {cell.partial && (
                            <>
                              <span class="pass-tag" aria-hidden="true">
                                {cell.passes}/{cell.runs}
                              </span>
                              <span class="visually-hidden"> ({runsText(cell.passes, cell.runs)})</span>
                            </>
                          )}
                          <span class="val">{cell.text}</span>
                          {cell.isBest && <span class="visually-hidden">, lowest</span>}
                        </td>
                      ))}
                      <td class:list={["x", { loss: row.callout?.loss }]}>
                        {row.callout && (
                          <>
                            <b>{row.callout.figure}</b> {row.callout.line}
                          </>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
                <tfoot>
                  <tr>
                    <th scope="row">{cu.taskCount}-task total</th>
                    {c.series.map((s) => (
                      <td class:list={["num", { best: s.isBest }]} data-side={s.side}>
                        <span class="val">{s.total}</span>
                        {s.isBest && <span class="visually-hidden">, lowest</span>}
                      </td>
                    ))}
                    <td class="x">
                      <b>{c.headline.figure}</b> fewer than OpenCode
                    </td>
                  </tr>
                </tfoot>
              </table>
            </div>
          </div>
        ))
      }
    </div>

    <div class="colophon">
      <p class="colophon-summary">
        {cu.taskCount} local web apps, medians of {cu.repeats} runs ({cu.dates}). {cu.passes} of {cu.runs} runs passed.
        {cu.partial.length > 0 && ` Partial pass: ${cu.partial.join("; ")}.`}
      </p>
      {
        page ? (
          <ul class="fine" role="list">
            <li>
              Your own Claude Code or Codex drives Ardia through the <code>ardia</code> command, as shipped in 0.2.45-nightly.3. Nothing in Ardia calls a model.
            </li>
            <li>OpenCode Browse {cu.opencodeVersion}: the same Claude Code and Codex, through its extension and MCP server.</li>
            <li>Aside {cu.asideVersion}: its in-browser agent, not its desktop Computer Use, on its own subscription providers.</li>
            <li>
              Fresh state each run: Ardia’s saved notes cleared, Aside’s memory off and prior chats deleted. Models ran at high reasoning effort. Ardia ran hidden; Aside stayed behind other windows.
            </li>
            <li>Token medians include failed runs. On docs research the shell agents can read pages with curl; Aside’s agent can’t.</li>
          </ul>
        ) : (
          <details class="fine-details">
            <summary class="label">Setup and versions</summary>
            <ul class="fine" role="list">
              <li>
                Your own Claude Code or Codex drives Ardia through the <code>ardia</code> command, as shipped in 0.2.45-nightly.3. Nothing in Ardia calls a model.
              </li>
              <li>OpenCode Browse {cu.opencodeVersion}: the same Claude Code and Codex, through its extension and MCP server.</li>
              <li>Aside {cu.asideVersion}: its in-browser agent, not its desktop Computer Use, on its own subscription providers.</li>
              <li>
                Fresh state each run: Ardia’s saved notes cleared, Aside’s memory off and prior chats deleted. Models ran at high reasoning effort. Ardia ran hidden; Aside stayed behind other windows.
              </li>
              <li>Token medians include failed runs. On docs research the shell agents can read pages with curl; Aside’s agent can’t.</li>
            </ul>
          </details>
        )
      }
      <p class="colophon-links">
        <a class="link label" href={cu.source} rel="noopener" data-track="github_clicked" data-track-link="agent_bench" data-track-location="computer_use"
          >Rerun the bench</a
        >
      </p>
    </div>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-cu-root]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-cu-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-cu-panel]")];
    const wins = [...root.querySelectorAll<HTMLElement>("[data-cu-win]")];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.classList.toggle("is-active", active);
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.tabIndex = active ? 0 : -1;
        if (active && focus) tab.focus();
      });
      panels.forEach((panel, i) => {
        const active = i === index;
        panel.classList.toggle("is-active", active);
        panel.hidden = !active;
      });
      wins.forEach((win, i) => {
        win.classList.toggle("is-active", i === index);
      });
    };
    tabs.forEach((tab, idx) => {
      tab.addEventListener("click", () => select(idx));
      tab.addEventListener("keydown", (event) => {
        if (event.key === "ArrowRight" || event.key === "ArrowLeft") {
          event.preventDefault();
          const next = (idx + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
          select(next, true);
        } else if (event.key === "Home") {
          event.preventDefault();
          select(0, true);
        } else if (event.key === "End") {
          event.preventDefault();
          select(tabs.length - 1, true);
        }
      });
    });
  }
</script>

<style>
  .cu {
    --side-ardia: oklch(0.38 0.09 162);
    --side-aside: oklch(0.38 0.11 40);
    --side-opencode: oklch(0.38 0.1 272);
    --side-color: var(--rival);
    padding: clamp(68px, 7.5vw, 128px) 0 clamp(60px, 6.5vw, 108px);
  }
  .cu [data-side="ardia"] {
    --side-color: var(--side-ardia);
  }
  .cu [data-side="aside"] {
    --side-color: var(--side-aside);
  }
  .cu [data-side="opencode"] {
    --side-color: var(--side-opencode);
  }
  .cu-page {
    padding-top: clamp(40px, 5vw, 84px);
  }
  .cu-head {
    margin-bottom: clamp(24px, 3vw, 36px);
  }
  .cu-heading {
    font-size: var(--t-h2);
  }
  .lede {
    max-width: 38em;
    margin-top: 14px;
    font-size: var(--t-lede);
    line-height: 1.44;
    color: var(--ink);
  }
  .cu code {
    font-family: var(--mono);
    font-size: 0.8em;
    padding: 0.14em 0.44em;
    border-radius: 6px;
    background: rgb(22 19 15 / 0.075);
    word-spacing: -0.22em;
    white-space: nowrap;
  }
  .status {
    display: inline-block;
    margin-top: 16px;
    padding: 4px 10px;
    color: var(--stamp);
    border: 1.5px solid currentColor;
    border-radius: 6px;
    transform: rotate(-1.5deg);
  }

  .sheet-card {
    padding: clamp(18px, 2.2vw, 24px) clamp(10px, 1.4vw, 18px) clamp(16px, 2vw, 24px);
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid transparent;
    box-shadow:
      0 0 0 1px rgb(22 19 15 / 0.08),
      0 1px 2px rgb(22 19 15 / 0.04),
      0 20px 44px -26px rgb(60 36 16 / 0.18);
  }

  .card-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px 20px;
    padding: 0 14px 18px;
    margin-bottom: 14px;
    border-bottom: 1px solid rgb(22 19 15 / 0.08);
  }

  .model-tabs {
    display: inline-grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
    padding: 4px;
    border-radius: 12px;
    background: rgb(22 19 15 / 0.06);
  }
  .model-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    min-height: 42px;
    padding: 6px 20px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink-2);
    font-family: var(--sans);
    cursor: pointer;
    transition:
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out),
      box-shadow 150ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  @media (hover: hover) {
    .model-tab:hover:not(.is-active) {
      color: var(--ink);
    }
  }
  .model-tab.is-active {
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 0 0 1px rgb(22 19 15 / 0.06),
      0 1px 3px rgb(22 19 15 / 0.1);
  }
  .tab-model {
    font-size: 0.9rem;
    font-weight: 680;
    letter-spacing: -0.015em;
    line-height: 1.15;
    white-space: nowrap;
  }
  .tab-agent {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ink-3);
    line-height: 1.15;
    white-space: nowrap;
  }

  .win-stack {
    display: grid;
    justify-items: end;
  }
  .model-win {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    text-align: end;
    visibility: hidden;
    pointer-events: none;
  }
  .model-win.is-active {
    visibility: visible;
    pointer-events: auto;
  }
  .win-pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.28em;
    padding: 6px 10px;
    border-radius: 8px;
    background: color-mix(in oklch, var(--side-ardia) 11%, transparent);
    color: var(--side-ardia);
    font-size: 0.86rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    text-box: trim-both cap alphabetic;
  }
  .win-pill b {
    font-size: 1rem;
    font-weight: 740;
  }
  .model-sub {
    font-size: 0.8rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .table-panel {
    display: none;
  }
  .table-panel.is-active {
    display: block;
  }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .cu-table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  col.cu-task {
    width: 38%;
  }
  col.cu-num {
    width: 13%;
  }
  col.cu-x {
    width: 23%;
  }
  .cu-table th,
  .cu-table td {
    padding: 12px 0;
    text-align: end;
    vertical-align: middle;
    font-weight: inherit;
  }
  .cu-table thead th {
    padding-block: 0 14px;
    border-bottom: 1px solid rgb(22 19 15 / 0.1);
    font-size: 0.82rem;
    font-weight: 640;
    letter-spacing: -0.008em;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .cu-table thead th.task-col {
    text-align: start;
    padding-inline-start: 14px;
  }
  .cu-table thead th.x-col {
    text-align: start;
    padding-inline: clamp(20px, 2.6vw, 40px) 14px;
  }
  .cu-table thead th.num-col {
    color: var(--side-color);
  }
  .col-head {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
  }
  .brand-logo {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    object-fit: cover;
    flex: none;
  }
  [data-side="ardia"] .brand-logo {
    outline: 1px solid rgb(22 19 15 / 0.12);
    outline-offset: -1px;
  }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--side-color);
    flex: none;
  }

  .cu-table tbody tr > * {
    border-bottom: 1px solid rgb(22 19 15 / 0.06);
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  .cu-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  @media (hover: hover) {
    .cu-table tbody tr:hover > * {
      background: rgb(22 19 15 / 0.036);
      border-bottom-color: transparent;
    }
    .cu-table tbody tr:has(+ tr:hover) > * {
      border-bottom-color: transparent;
    }
    .cu-table tbody tr:hover > :first-child {
      border-start-start-radius: 10px;
      border-end-start-radius: 10px;
    }
    .cu-table tbody tr:hover > :last-child {
      border-start-end-radius: 10px;
      border-end-end-radius: 10px;
    }
  }
  .cu-table tbody th {
    text-align: start;
    font-size: 0.95rem;
    font-weight: 540;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-inline: 14px 16px;
    text-wrap: pretty;
  }
  .task-short {
    display: none;
  }
  .m-callout {
    display: none;
  }
  .cu-table td.num {
    font-size: 0.92rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    white-space: nowrap;
    padding-inline-start: 10px;
  }
  .cu-table td.num .val {
    display: inline-block;
    padding: 4px 8px;
    margin-inline-end: -8px;
    border-radius: 7px;
    text-box: trim-both cap alphabetic;
  }
  .cu-table td.num.best .val {
    background: color-mix(in oklch, var(--side-color) 11%, transparent);
    color: var(--side-color);
    font-weight: 700;
  }
  .cu-table td.num.partial .val {
    color: var(--side-aside);
  }
  .pass-tag {
    display: inline-block;
    margin-inline-end: 4px;
    padding: 3px 6px;
    border-radius: 6px;
    background: color-mix(in oklch, var(--side-aside) 12%, transparent);
    color: var(--side-aside);
    font-size: 0.72rem;
    font-weight: 640;
    font-variant-numeric: tabular-nums diagonal-fractions;
    text-box: trim-both cap alphabetic;
  }
  .cu-table td.x {
    text-align: start;
    padding-inline: clamp(20px, 2.6vw, 40px) 14px;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.3;
  }
  .cu-table td.x b {
    color: var(--ink);
    font-weight: 700;
    font-size: 0.98rem;
    margin-inline-end: 0.16em;
  }
  .cu-table td.x.loss b {
    color: var(--ink-2);
    font-weight: 620;
  }

  .cu-table tfoot tr > * {
    padding-block: 14px 4px;
    border-top: 1.5px solid rgb(22 19 15 / 0.14);
  }
  .cu-table tfoot th {
    text-align: start;
    padding-inline: 14px 16px;
    font-size: 0.95rem;
    font-weight: 660;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .cu-table tfoot td.num {
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--ink);
  }
  .cu-table tfoot td.num.best .val {
    font-weight: 740;
  }

  .colophon {
    margin-top: clamp(24px, 3vw, 36px);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 58em;
  }
  .colophon-summary {
    margin: 0;
  }
  .fine-details {
    margin-top: 8px;
  }
  .fine-details summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    color: var(--ink);
    font-weight: 620;
    min-height: 36px;
    list-style: none;
  }
  .fine-details summary::-webkit-details-marker {
    display: none;
  }
  .fine-details summary::after {
    content: "+";
    font-size: 1rem;
    line-height: 1;
  }
  .fine-details[open] summary::after {
    content: "−";
  }
  .fine {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    columns: 2 22em;
    column-gap: clamp(20px, 3vw, 44px);
  }
  .fine li {
    break-inside: avoid;
    margin-bottom: 8px;
  }
  .colophon-links {
    margin: 8px 0 0;
  }
  .colophon .link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink);
    font-weight: 620;
  }
  .colophon .link::after {
    content: " →";
  }

  @media (max-width: 860px) {
    .sheet-card {
      padding: 16px 8px;
      border-radius: 18px;
    }
    .card-bar {
      padding: 0 10px 14px;
      margin-bottom: 12px;
    }
    col.cu-task {
      width: 40%;
    }
    col.cu-num {
      width: 20%;
    }
    col.cu-x,
    .cu-table thead th.x-col,
    .cu-table td.x {
      display: none;
    }
    .cu-table thead th {
      padding-block: 0 11px;
      font-size: 0.78rem;
      vertical-align: bottom;
    }
    .cu-table thead th.task-col {
      padding-inline-start: 10px;
    }
    .cu-table thead th.num-col:nth-last-child(2) {
      padding-inline-end: 10px;
    }
    .cu-table th,
    .cu-table td {
      padding-block: 11px;
    }
    .cu-table tbody tr > :nth-last-child(2),
    .cu-table tfoot tr > :nth-last-child(2) {
      padding-inline-end: 10px;
    }
    @media (hover: hover) {
      .cu-table tbody tr:hover > :nth-last-child(2) {
        border-start-end-radius: 10px;
        border-end-end-radius: 10px;
      }
    }
    .cu-table tbody th,
    .cu-table tfoot th {
      font-size: 0.9rem;
      line-height: 1.28;
      padding-inline: 10px 8px;
    }
    .task-full {
      display: none;
    }
    .task-short {
      display: inline;
    }
    .m-callout {
      display: block;
      margin-top: 3px;
      font-size: 0.76rem;
      font-weight: 460;
      color: var(--ink-2);
