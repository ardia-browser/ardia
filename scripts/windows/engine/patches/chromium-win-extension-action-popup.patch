       profile,
       /*include_incognito_or_parent=*/check_incognito_profile);
-  return browser && browser->GetWindow()->IsActive() ? browser : nullptr;
+  return browser && IsActivePopupBrowser(*browser) ? browser : nullptr;
 }
 
