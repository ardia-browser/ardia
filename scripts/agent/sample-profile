  const registry = __r.getModules();
  const find = (name) => { for (const [id, m] of (registry instanceof Map ? registry.entries() : Object.entries(registry))) if (m && m.verboseName === name) return __r(Number(id)); return null; };`;

async function verify() {
  const instance = await launch(app, { data, metroPort: metro });
  const shots = join(tmpdir(), "ardia-sample-verify");
  rmSync(shots, { recursive: true, force: true });
  mkdirSync(shots, { recursive: true });
  const ev = (args, body, timeout = 30000) => instance.eval(js(args, `${FIND}\n${body}`), { timeout });
  try {
    await sleep(3000);
    const { window, order } = await ev({}, `const s = ac.store.getState(); return { window: s.windowOrder[0], order: s.profileOrder };`);
    const rows = [];
    for (const profileId of [...order.slice(1), order[0]]) {
      await ev({ w: window, profileId }, `ac.store.getState().switchProfile(A.w, A.profileId); return true;`);
      await sleep(2500);
      rows.push(await ev({ w: window, profileId }, `
        const items = find("src/state/library/items.ts");
        const library = find("src/state/library/library.ts");
        const filesApi = find("src/platform/files.ts");
        const dl = find("src/platform/downloads.ts");
        const model = find("src/state/browser/model.ts");
        const slice = find("src/state/downloads/downloadsSlice.ts");
        const s = ac.store.getState();
        const engine = model.engineProfile(s, A.profileId);
        return dl.getDownloadSettings(engine).then((settings) => filesApi.listFolderMedia(settings.folder, 500).then((files) => {
          const downloads = s.downloads.filter((d) => slice.downloadVisibleIn(s, d, s.windows[A.w]));
          const history = (s.history[engine] && s.history[engine].list) || [];
          const days = (list) => items.dayGroups(list, Date.now()).length;
          const tabs = Object.values(s.tabs).filter((t) => t.profileId === A.profileId);
          return { profile: s.profiles[A.profileId].name, icon: s.profiles[A.profileId].icon, color: s.profiles[A.profileId].color, folder: settings.folder,
            media: Object.fromEntries(library.MEDIA_KINDS.map((k) => [k, items.mediaItems(downloads, k, files).length])),
            downloads: items.downloadItems(downloads).length, downloadDays: days(items.downloadItems(downloads)),
            downloadStates: downloads.reduce((n, d) => ({ ...n, [d.state]: (n[d.state] || 0) + 1 }), {}),
            history: history.length, historyDays: days(history), pinned: tabs.filter((t) => t.pin).length, open: tabs.filter((t) => !t.pin).length,
            profilesListed: items.profileItems(s.profileOrder, s.profiles, {}, null).length, sidebarLibrary: s.settings.sidebarLibrary, tabLayout: s.settings.tabLayout };
        }));`, 60000));
    }
    for (const [section, filter] of [["media", "all"], ["media", "image"], ["media", "video"], ["media", "audio"], ["downloads"], ["profiles"], ["history"]]) {
      await ev({ w: window, section, filter }, `
        const actions = find("src/state/library/actions.ts");
        actions.openLibrary(A.w, "command", A.section);
        if (A.filter) actions.setLibraryFilter(A.w, A.filter);
        return true;`);
      await sleep(1500);
      const file = join(shots, `${section}${filter ? `-${filter}` : ""}.png`);
      if (!(await ev({ w: window, file }, `return ac.shell.devSnapshotWindow(A.w, A.file);`))) log(`snapshot of ${section} failed`);
    }
    for (const r of rows)
      log(`${r.profile.padEnd(10)} media ${JSON.stringify(r.media)} · downloads ${r.downloads} over ${r.downloadDays} days ${JSON.stringify(r.downloadStates)} · history ${r.history} over ${r.historyDays} days · ${r.pinned} pinned, ${r.open} open`);
    log(`profiles listed ${rows[0].profilesListed}, sidebarLibrary ${rows[0].sidebarLibrary}, tabLayout ${rows[0].tabLayout}, download folder ${rows[0].folder}`);
    log(`snapshots in ${shots}`);
  } finally {
    await instance.quit();
    for (const f of ["instance.json", "dev-eval.js", "dev-eval-result.json"]) rmSync(join(data, f), { force: true });
  }
}

function openVisible() {
  if (running()) fail(`an instance is already running on ${data} (pid ${running()})`);
  for (const f of ["instance.json", "dev-eval.js", "dev-eval-result.json"]) rmSync(join(data, f), { force: true });
  execFileSync("open", ["-n", "--env", `ARDIA_DATA_DIR=${data}`, "--env", `ARDIA_INSTANCE=jsLocation=localhost:${metro}`, app]);
  log(`opened ${app} on ${data}`);
}

try {
  if (!(flags.reuse && seeded())) {
    log(`seeding ${data} with ${app}`);
    prepare();
    backdate(await seed());
    rmSync(served, { recursive: true, force: true });
    for (const f of ["instance.json", "dev-eval.js", "dev-eval-result.json"]) rmSync(join(data, f), { force: true });
    log(`ready: ${data}`);
  } else log(`reusing ${data}`);
  if (flags.verify) await verify();
  if (flags.open) openVisible();
} catch (e) {
  fail(e.stack ?? e.message);
}
