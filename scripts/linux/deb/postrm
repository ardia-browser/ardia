#!/bin/sh
set -e
if [ "$1" = remove ] || [ "$1" = purge ]; then
  if [ -f /etc/apparmor.d/ardia ]; then
    if command -v apparmor_parser >/dev/null 2>&1; then apparmor_parser -R /etc/apparmor.d/ardia >/dev/null 2>&1 || true; fi
    rm -f /etc/apparmor.d/ardia
  fi
  rm -f /var/cache/apparmor/*/ardia
fi
exit 0
