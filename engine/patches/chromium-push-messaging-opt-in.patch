+
+  base::TimeDelta time_to_next_checkin = GetTimeToNextCheckin();
+  if (time_to_next_checkin.is_negative())
+    time_to_next_checkin = base::TimeDelta();
+
+  io_task_runner_->PostDelayedTask(
