{
  "name": "ardia",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@ardia/browser",
    "macos": "pnpm --filter @ardia/browser macos",
    "pods": "pnpm --filter @ardia/browser pods",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "shaders:check": "turbo run shaders:check",
    "test": "turbo run test && pnpm run test:root",
    "test:root": "node --no-warnings --test extras/raycast-ardia/src/scripts.test.ts \"scripts/**/*.test.mjs\" \"engine/*.test.mjs\" \"apps/ios/scripts/*.test.mjs\" \"apps/site/src/**/*.test.ts\"",
    "test:portable": "pnpm run test:portable:packages && pnpm run test:portable:mac && pnpm run test:root",
    "test:portable:mac": "turbo run test:portable",
    "test:portable:packages": "turbo run test --filter=!@ardia/ardiacore --filter=!@ardia/import --filter=!@ardia/shell --filter=!@ardia/sync"
  },
  "devDependencies": {
    "tsrs": "7.1.0-beta.tsrs4",
    "turbo": "^2.11.13",
    "typescript": "~5.9.2"
  },
  "license": "SEE LICENSE IN NOTICE"
}
