#!/usr/bin/env node
// A data dir full of sample data for trying the Library (Media, Downloads, Profiles, History), and a way to open it.
//
//   scripts/agent/sample-profile [--data DIR] [--app APP] [--metro PORT] [--reuse] [--verify] [--open]
//
//   --data DIR    the data dir, default ardia-library-data/sample beside the repo, so it stays off the startup
//                 disk. It is wiped and reseeded only when it is empty or was made by this script (.ardia-sample).
//   --app APP     a Debug build, default the newest Build/Products/Debug/Ardia.app in apps/browser/build-* or a
//                 sibling of the repo. Never /Applications.
//   --metro PORT  the Metro that serves the build's JS, default 8095
//   --reuse       keep DIR as it is when it was already seeded (with --open: just open it)
//   --verify      relaunch hidden on DIR, print what the Library lists in each section and filter, save a snapshot
//                 of each to $TMPDIR/ardia-sample-verify, and quit
//   --open        launch a visible instance on DIR: ARDIA_DATA_DIR=DIR ARDIA_INSTANCE=jsLocation=localhost:PORT
//
// Seeding runs in hidden instances (scripts/lib/instance.mjs) and drives the real app: settings (Library on, sidebar
// layout, every profile's download folder DIR/Downloads), three profiles with icons, pinned and open tabs, downloads
// from a local server that this script starts and stops (finished, cancelled, failed, repeated names), history over
// three weeks through the store's importHistory, then backdates the download records and the files' dates.
// DIR/Downloads also gets photos, videos, audio and documents (sips, ffmpeg), hidden files and a subfolder.
import { execFile, execFileSync, spawnSync } from "node:child_process";
import { createReadStream, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync, copyFileSync } from "node:fs";
import { createServer } from "node:http";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { promisify } from "node:util";
import { randomBytes } from "node:crypto";

const here = fileURLToPath(import.meta.url);
const repo = resolve(dirname(here), "../..");
const { launch, sleep, processInfo } = await import(join(repo, "scripts/lib/instance.mjs"));
const run = promisify(execFile);

const help = () => {
  const lines = readFileSync(here, "utf8").split("\n").slice(1);
  console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
};
const argv = process.argv.slice(2);
if (argv.includes("-h") || argv.includes("--help")) {
  help();
  process.exit(0);
}
const flags = {};
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (["--reuse", "--verify", "--open"].includes(a)) flags[a.slice(2)] = true;
  else if (["--data", "--app", "--metro"].includes(a)) flags[a.slice(2)] = argv[++i];
  else {
    console.error(`unknown argument ${a} (--help)`);
    process.exit(64);
  }
}

const MARKER = ".ardia-sample";
const DAY = 86_400_000;
const data = resolve(flags.data ?? join(dirname(repo), "ardia-library-data", "sample"));
const metro = Number(flags.metro ?? 8095);
const folder = join(data, "Downloads");
const served = join(data, "sample-served");
const log = (...a) => console.log(`[sample] ${a.join(" ")}`);
const fail = (message) => {
  console.error(`sample-profile: ${message}`);
  process.exit(1);
};

function newestBuild() {
  const roots = [join(repo, "apps/browser"), dirname(repo)];
  const found = [];
  for (const root of roots)
    for (const entry of readdirSync(root, { withFileTypes: true })) {
      if (!entry.isDirectory() || (root === roots[0] && !entry.name.startsWith("build-"))) continue;
      const app = join(root, entry.name, "Build/Products/Debug/Ardia.app");
      if (existsSync(join(app, "Contents/Info.plist"))) found.push({ app, at: statSync(join(app, "Contents/Info.plist")).mtimeMs });
    }
  return found.sort((a, b) => b.at - a.at)[0]?.app;
}
const app = resolve(flags.app ?? newestBuild() ?? fail("no Debug build found: pass --app"));
if (/^\/Applications\//.test(app)) fail("never an installed app: pass a build");
if (!existsSync(join(app, "Contents/Info.plist"))) fail(`${app} is not an app`);
if ([homedir(), join(homedir(), "ardia-library-try"), join(homedir(), "Downloads")].includes(data)) fail(`refusing ${data}`);

const seeded = () => existsSync(join(data, MARKER));
const running = () => {
  try {
    const { pid } = JSON.parse(readFileSync(join(data, "instance.json"), "utf8"));
    return processInfo(pid) ? pid : null;
  } catch {
    return null;
  }
};

function prepare() {
  if (running()) fail(`an instance is running on ${data} (pid ${running()}): quit it first`);
  if (existsSync(data) && readdirSync(data).length && !seeded()) fail(`${data} has files this script didn't make; pass another --data`);
  rmSync(data, { recursive: true, force: true });
  mkdirSync(folder, { recursive: true });
  mkdirSync(served, { recursive: true });
  writeFileSync(join(data, MARKER), `${new Date().toISOString()}\n`);
}

const at = (daysAgo, hour, minute = 0) => {
  const d = new Date();
  d.setDate(d.getDate() - daysAgo);
  d.setHours(hour, minute, (hour * 7 + minute) % 60, 0);
  return d.getTime() < Date.now() ? d.getTime() : Date.now() - (24 - hour) * 10 * 60_000;
};

const pad = (n) => String(n).padStart(2, "0");
const dayName = (daysAgo) => {
  const d = new Date(at(daysAgo, 12));
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
};
const shotName = (daysAgo, hour, minute) => `Screenshot ${dayName(daysAgo)} at ${hour}.${pad(minute)}.${pad((minute * 7) % 60)}.png`;

function systemPictures() {
  const dir = "/System/Library/Desktop Pictures";
  const list = (d, test) => (existsSync(d) ? readdirSync(d).filter(test).map((f) => join(d, f)) : []);
  const large = list(dir, (f) => f.endsWith(".heic") && statSync(join(dir, f)).size > 1_000_000);
  const scenic = list(join(dir, ".thumbnails"), (f) => f.endsWith(".heic") && !/Light|Dark|Grid|Chroma|Motion|hello|Mac |iMac|Radial|Gradient/.test(f));
  return { large, scenic };
}

