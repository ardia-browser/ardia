+}
+
+bool ArdiaPrivatePasteboardActive() {
+  NSPasteboard* pasteboard = GetPasteboard();
+  return g_ardia_private_pasteboard && pasteboard &&
+         pasteboard != NSPasteboard.generalPasteboard;
+}
