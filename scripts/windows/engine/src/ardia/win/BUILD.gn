assert(is_win)

declare_args() {
  ardia_linux_compile_probe = false
}

if (ardia_linux_compile_probe) {
  group("linux_compile_probe") {
    deps = [ "//ardia/linux:compile_probe" ]
  }
}

action("webui_bootstrap") {
  script = "//ardia/linux/generate_bootstrap.py"
  sources = [ "//ardia/linux/bootstrap.js" ]
  outputs = [ "$root_gen_dir/ardia/linux/host_bootstrap.h" ]
  args = [
    "--input",
    rebase_path(sources[0], root_build_dir),
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

