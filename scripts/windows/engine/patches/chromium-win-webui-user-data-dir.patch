+TEST_F(UserDataDir, PlainFileExistsOnlyForARealFile) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const std::wstring root = temp.GetPath().value();
+  const std::wstring file = root + L"\\ArdiaApp.dll";
+  const std::wstring folder = root + L"\\Folder.dll";
+  const std::wstring missing = root + L"\\Missing.dll";
+  const std::wstring dangling = root + L"\\Dangling.dll";
+  const std::wstring linked = root + L"\\Linked.dll";
+  HANDLE handle = ::CreateFileW(file.c_str(), GENERIC_WRITE, 0, nullptr,
+                                CREATE_NEW, FILE_ATTRIBUTE_NORMAL, nullptr);
+  ASSERT_NE(INVALID_HANDLE_VALUE, handle);
+  ::CloseHandle(handle);
+  ASSERT_TRUE(::CreateDirectoryW(folder.c_str(), nullptr));
+  ASSERT_TRUE(::CreateSymbolicLinkW(
+      dangling.c_str(), missing.c_str(),
+      SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE));
+  ASSERT_TRUE(::CreateSymbolicLinkW(
+      linked.c_str(), file.c_str(),
+      SYMBOLIC_LINK_FLAG_ALLOW_UNPRIVILEGED_CREATE));
+  EXPECT_TRUE(PlainFileExists(file));
+  EXPECT_FALSE(PlainFileExists(folder));
+  EXPECT_FALSE(PlainFileExists(missing));
+  EXPECT_FALSE(PlainFileExists(dangling));
+  EXPECT_FALSE(PlainFileExists(linked));
+  EXPECT_FALSE(PlainFileExists(std::wstring()));
+}
