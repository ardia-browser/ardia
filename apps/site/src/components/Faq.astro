---
import { base } from "../data/site";
import { FAQ } from "../data/faq";
---

<section class="faq paint edge" data-paint="plum" id="faq" aria-labelledby="faq-title" data-shot="press">
  <div class="wrap faq-grid">
    <header class="faq-head">
      <p class="label kicker">FAQ</p>
      <h2 class="poster" id="faq-title" data-reveal>Fair questions.</h2>
    </header>

    <dl class="qa">
      {
        FAQ.map((q) => (
          <div class="item" id={q.id}>
            <dt>{q.question}</dt>
            <dd>
              {q.answer}
              {q.more && (
                <>
                  {" "}
                  <a class="link" href={`${base}/${q.more.path}`}>
                    {q.more.label}
                  </a>
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .faq {
    padding: var(--section) 0;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 48px;
  }
  .faq-head {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: 100px;
  }
  h2 {
    font-size: clamp(2.3rem, 1.15rem + 3vw, 4.2rem);
  }
  .qa {
    grid-column: 7 / -1;
    display: grid;
    gap: 36px;
    margin: 0;
  }
  dt {
    font-weight: 640;
    font-size: 1.18rem;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }
  dd {
    margin: 8px 0 0;
    max-width: 36em;
    color: var(--ink-2);
  }
  b {
    font-weight: 600;
    color: var(--ink);
  }
  @media (max-width: 960px) {
    .faq-head,
    .qa {
      grid-column: 1 / -1;
      position: static;
    }
  }
</style>
