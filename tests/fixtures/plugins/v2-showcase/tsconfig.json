{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "@ardia/plugin-sdk",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@ardia/plugin-sdk": ["../../../../packages/plugin-sdk/src/index.ts"],
      "@ardia/plugin-sdk/jsx-runtime": ["../../../../packages/plugin-sdk/src/jsxRuntime.ts"],
      "@ardia/plugin-sdk/jsx-dev-runtime": ["../../../../packages/plugin-sdk/src/jsxRuntime.ts"]
    }
  },
  "include": ["src"]
}
