+String CommonRendererName(ExecutionContext* execution_context,
+                          const String& renderer) {
+  constexpr char kAppleMetalRenderer[] =
+      "ANGLE (Apple, ANGLE Metal Renderer: Apple M";
+  constexpr wtf_size_t kChipAt =
+      static_cast<wtf_size_t>(sizeof(kAppleMetalRenderer) - 1);
+  if (!base::FeatureList::IsEnabled(blink::features::kHeliumNoiseCpuCores) ||
+      (execution_context &&
+       !execution_context->GetHeliumNoiseTokens().contains(
+           HeliumNoiseFeature::kHardware)) ||
+      !renderer.starts_with(kAppleMetalRenderer)) {
+    return renderer;
+  }
+  const wtf_size_t chip_end = renderer.find(", ", kChipAt);
+  if (chip_end == String::npos) {
+    return renderer;
+  }
+  unsigned generation = 0;
+  for (wtf_size_t i = kChipAt; i < chip_end && IsAsciiDigit(renderer[i]);
+       ++i) {
+    generation = generation * 10 + static_cast<unsigned>(renderer[i] - '0');
+  }
+  if (generation == 0) {
+    return renderer;
+  }
+  const char* common_generation =
+      generation >= 3 ? "4" : generation == 2 ? "2" : "1";
+  return StrCat({StringView(renderer, 0, kChipAt), common_generation,
+                 StringView(renderer, chip_end)});
+}
+
