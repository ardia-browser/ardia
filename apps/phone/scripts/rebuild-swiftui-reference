#!/bin/bash
# Usage: apps/phone/scripts/rebuild-swiftui-reference [<commit>] [<out dir>] [--help]
#   Rebuilds main's SwiftUI iPhone app from <commit> (default e945077b66efc7595382510e4a3c78c8e541957f, the pinned
#   reference) for the simulator: Release, ad hoc signed with simulated entitlements. Writes
#   <out dir>/swiftui-main-rebuilt.app and .txt (default ~/Developer/ardia-phone-references).
set -euo pipefail
case "${1:-}" in -h|--help) sed -n '2,5p' "$0" | cut -c3-; exit 0 ;; esac
root="$(cd "$(dirname "$0")/../../.." && pwd)"
commit="$(git -C "$root" rev-parse "${1:-e945077b66efc7595382510e4a3c78c8e541957f}^{commit}")"
out="${2:-$HOME/Developer/ardia-phone-references}"
work="${TMPDIR:-/tmp}/ardia-swiftui-rebuild/${commit:0:12}"
rm -rf "$work"
mkdir -p "$work/src" "$out"
git -C "$root" archive "$commit" apps/ios packages/sync | tar -x -C "$work/src"
"$root/scripts/agent/locked" xcodebuild -- xcodebuild -project "$work/src/apps/ios/Ardia.xcodeproj" -scheme Ardia \
  -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath "$work/dd" \
  ARCHS=arm64 ONLY_ACTIVE_ARCH=YES CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY=- DEVELOPMENT_TEAM= PROVISIONING_PROFILE_SPECIFIER= \
  COMPILER_INDEX_STORE_ENABLE=NO -quiet build
app="$work/dd/Build/Products/Release-iphonesimulator/Ardia.app"
entitled="$(otool -l "$app/Ardia" | grep -c 'sectname __entitlements' || true)"
[ "$entitled" = 1 ] || { echo "the build carries no entitlements: it would have no Keychain" >&2; exit 1; }
rm -rf "$out/swiftui-main-rebuilt.app"
cp -R "$app" "$out/swiftui-main-rebuilt.app"
{
  echo "app: swiftui-main-rebuilt.app"
  echo "built from: $commit"
  echo "configuration: Release, simulator, ad hoc signed with simulated entitlements"
  echo "bundle id: $(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Info.plist")"
  echo "version: $(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$app/Info.plist") ($(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$app/Info.plist"))"
} > "$out/swiftui-main-rebuilt.txt"
rm -rf "$work"
cat "$out/swiftui-main-rebuilt.txt"
