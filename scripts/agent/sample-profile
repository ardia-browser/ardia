async function makeFiles() {
  const plan = folderPlan(systemPictures());
  const jobs = [
    ...plan.folder.map((f) => ({ ...f, out: join(folder, f.name) })),
    ...plan.hidden.map((f) => ({ ...f, out: join(folder, f.name) })),
    ...plan.subfolder.map((f) => ({ ...f, out: join(folder, f.name) })),
    ...plan.served.map((f) => ({ ...f, out: join(served, f.name) })),
  ];
  for (const j of jobs) mkdirSync(dirname(j.out), { recursive: true });
  const queue = [...jobs];
  const worker = async () => {
    for (let j; (j = queue.shift()); ) {
      try {
        await j.make(j.out);
      } catch (e) {
        throw new Error(`making ${j.name}: ${(e.stderr || e.message).toString().trim()}`);
      }
      if (!existsSync(j.out)) throw new Error(`making ${j.name} left no file`);
    }
  };
  await Promise.all(Array.from({ length: 6 }, worker));
  log(`made ${plan.folder.length} files in Downloads, ${plan.hidden.length} hidden, ${plan.subfolder.length} in a subfolder, ${plan.served.length} to download`);
  return [...plan.folder, ...plan.hidden, ...plan.subfolder].map((f) => ({ path: join(folder, f.name), time: at(f.daysAgo, f.hour, 17) }));
}

const MIME = { ".jpg": "image/jpeg", ".png": "image/png", ".pdf": "application/pdf", ".zip": "application/zip", ".mp4": "video/mp4",
  ".mov": "video/quicktime", ".mp3": "audio/mpeg", ".dmg": "application/x-apple-diskimage" };

function startServer() {
  const server = createServer((req, res) => {
    const parts = new URL(req.url, "http://x").pathname.split("/").filter(Boolean).map(decodeURIComponent);
    const [mode, , name] = parts;
    const file = name && join(served, basename(name));
    if (!file || !existsSync(file)) {
      res.writeHead(404);
      return res.end();
    }
    const size = statSync(file).size;
    const type = MIME[name.slice(name.lastIndexOf(".")).toLowerCase()] ?? "application/octet-stream";
    const disposition = `attachment; filename="${name}"`;
    if (mode === "cancel") {
      res.writeHead(200, { "content-type": type, "content-length": String(400_000_000), "content-disposition": disposition });
      const timer = setInterval(() => res.write(Buffer.alloc(4096)), 100);
      res.on("close", () => clearInterval(timer));
      return;
    }
    if (mode === "fail") {
      res.writeHead(200, { "content-type": type, "content-length": String(size * 4 + 2_000_000), "content-disposition": disposition });
      res.write(Buffer.alloc(Math.max(size, 500_000)));
      return void setTimeout(() => res.socket?.destroy(), 400);
    }
    res.writeHead(200, { "content-type": type, "content-length": String(size), "content-disposition": disposition });
    createReadStream(file).pipe(res);
  });
  return new Promise((r) => server.listen(0, "127.0.0.1", () => r(server)));
}

const js = (args, body) => `const A = ${JSON.stringify(args)};\n${body}`;

async function seed() {
  const files = await makeFiles();
  const server = await startServer();
  const port = server.address().port;
  const hosts = [...new Set(DOWNLOADS.map((d) => d.host))];
  log(`serving downloads on 127.0.0.1:${port}`);
  const instance = await launch(app, {
    data, metroPort: metro, onboarded: true,
    switches: [`--host-resolver-rules=${hosts.map((h) => `MAP ${h} 127.0.0.1:${port}`).join(",")}`],
  });
  log(`hidden instance pid ${instance.pid} port ${instance.port}`);
  const ev = (args, body, timeout = 30000) => instance.eval(js(args, body), { timeout });
  try {
    const ids = await ev({ PROFILES, folder }, `
      const s = ac.store.getState();
      s.updateSettings({ sidebarLibrary: true, tabLayout: "sidebar", autoHideTabs: false });
      const w = s.windowOrder[0];
      s.updateProfile("default", { name: A.PROFILES.personal.name, icon: A.PROFILES.personal.icon });
      s.setProfileLook("default", { color: A.PROFILES.personal.color });
      const ids = { personal: "default", window: w, firstTab: s.windows[w].tabIds[0] };
      for (const key of ["work", "studio"]) ids[key] = s.createProfile(A.PROFILES[key]);
      return ids;`);
    const engineOf = (key) => (key === "personal" ? "" : ids[key]);
    for (const key of ["work", "studio", "personal"]) {
      await ev({ w: ids.window, id: ids[key] }, `ac.store.getState().switchProfile(A.w, A.id); return true;`);
      await sleep(1500);
      const settings = await ev({ folder, profile: engineOf(key) }, `
        return ac.engine.call("downloads.setSettings", { folder: A.folder, askWhereToSave: false, profile: A.profile })
          .then(() => ac.engine.call("downloads.settings", { profile: A.profile }));`);
      if (settings?.folder !== folder) throw new Error(`the ${key} profile's download folder is ${settings?.folder}, not ${folder}`);
    }
    log("settings, profiles and download folders set");

    const downloaded = [];
    for (const [i, d] of DOWNLOADS.entries()) {
      const url = `http://${d.host}/${d.end ?? "file"}/${i}/${encodeURIComponent(d.name)}`;
      await ev({ w: ids.window, url, profileId: ids[d.profile] }, `ac.store.getState().newTab(A.w, { url: A.url, profileId: A.profileId, background: true }); return true;`);
      let record = null;
      for (const end = Date.now() + 60000; Date.now() < end; await sleep(250)) {
        record = await ev({ url }, `const d = ac.store.getState().downloads.find((x) => x.url === A.url); return d ? { id: d.id, state: d.state, dangerous: !!d.dangerous, path: d.path, filename: d.filename } : null;`);
        if (record?.dangerous && record.state === "downloading") await ev({ id: record.id }, `return ac.engine.call("downloads.keep", { id: A.id }).then(() => true);`);
        if (record && d.end === "cancel" && record.state === "downloading" && !record.dangerous) {
          await sleep(800);
          await ev({ id: record.id }, `return ac.engine.call("downloads.cancel", { id: A.id }).then(() => true);`);
        }
        if (record && record.state !== "downloading") break;
      }
      const wanted = { cancel: "cancelled", fail: "failed" }[d.end] ?? "finished";
      if (record?.state !== wanted) throw new Error(`${d.name} ended ${record?.state ?? "never started"}, expected ${wanted}`);
      const time = at(d.daysAgo, d.hour, 3 + i);
      await ev({ id: record.id, time }, `const s = ac.store.getState(); const d = s.downloads.find((x) => x.id === A.id); s.upsertDownload({ ...d, startTime: A.time }); return true;`);
      if (wanted === "finished") downloaded.push({ path: record.path, time });
      log(`${wanted.padEnd(9)} ${d.profile.padEnd(8)} ${record.filename}`);
    }

    for (const key of ["work", "studio", "personal"]) {
      const tabs = TABS[key];
      await ev({ w: ids.window, id: ids[key], tabs, first: ids.firstTab }, `
        const s = ac.store.getState();
        s.switchProfile(A.w, A.id);
        for (const url of A.tabs.pinned) s.newTab(A.w, { url, profileId: A.id, pinned: true, background: true });
        for (const url of A.tabs.open) s.newTab(A.w, { url, profileId: A.id, background: true });
        const after = ac.store.getState();
        const mine = after.windows[A.w].tabIds.filter((t) => after.tabs[t]?.profileId === A.id && !after.tabs[t]?.pin && after.tabs[t]?.url === A.tabs.open[0]);
        if (A.id === "default" && after.tabs[A.first]) after.closeTabs([A.first]);
        return mine;`);
      await sleep(1500);
      const now = Date.now();
      const entries = HISTORY[key].map(([url, title], n) => {
        const daysAgo = (n * 5 + key.length) % 21;
        const lastVisit = Math.min(at(daysAgo, 8 + ((n * 5) % 14), (n * 13) % 60), now - (n + 1) * 60_000);
        return { url, title, visits: 1 + ((n * 3) % 7), lastVisit };
      });
      const added = await ev({ id: ids[key], entries, hosts }, `
        const s = ac.store.getState();
        const added = s.importHistory(A.id, A.entries);
        const local = (ac.store.getState().history[A.id === "default" ? "" : A.id]?.list ?? []).filter((h) => A.hosts.some((host) => h.url.includes(host)) || h.url.includes("127.0.0.1"));
        if (local.length) s.removeHistory(A.id, local.map((h) => h.url));
        return added;`);
      log(`${key}: ${TABS[key].pinned.length} pinned, ${TABS[key].open.length} open, ${added} history entries`);
    }
    await ev({ w: ids.window, id: "default" }, `
      const s = ac.store.getState();
      s.switchProfile(A.w, A.id);
      const blank = Object.values(ac.store.getState().tabs).filter((t) => !t.url && !t.pin).map((t) => t.id);
      if (blank.length) s.closeTabs(blank);
      const w = ac.store.getState().windows[A.w];
      const open = w.tabIds.find((t) => ac.store.getState().tabs[t]?.profileId === A.id && !ac.store.getState().tabs[t]?.pin);
      if (open) s.activate(open);
      return true;`);
    await sleep(4000);
    const summary = await ev({}, `
      const s = ac.store.getState();
      return { profiles: s.profileOrder.length, tabs: Object.keys(s.tabs).length, downloads: s.downloads.length,
        history: Object.fromEntries(Object.entries(s.history).map(([k, v]) => [k || "default", v.list.length])) };`);
    log(`in the store: ${JSON.stringify(summary)}`);
    return [...files, ...downloaded];
  } finally {
    await instance.quit();
    server.close();
  }
}

const DATE_SCRIPT = `
import ctypes, ctypes.util, json, os, struct, sys
libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
class AttrList(ctypes.Structure):
    _fields_ = [("bitmapcount", ctypes.c_ushort), ("reserved", ctypes.c_uint16), ("commonattr", ctypes.c_uint32),
                ("volattr", ctypes.c_uint32), ("dirattr", ctypes.c_uint32), ("fileattr", ctypes.c_uint32), ("forkattr", ctypes.c_uint32)]
ATTR_CMN_CRTIME = 0x00000200
ATTR_CMN_ADDEDTIME = 0x10000000
for row in json.load(sys.stdin):
    seconds = int(row["time"] / 1000)
    os.utime(row["path"], (seconds, seconds), follow_symlinks=False)
    for attr in (ATTR_CMN_CRTIME, ATTR_CMN_ADDEDTIME):
        value = struct.pack("qq", seconds, 0)
        if libc.setattrlist(row["path"].encode(), ctypes.byref(AttrList(5, 0, attr, 0, 0, 0, 0)), value, len(value), 0) != 0:
            sys.exit("setattrlist %s: errno %d" % (row["path"], ctypes.get_errno()))
`;

function backdate(rows) {
  const dirs = [...new Set(rows.map((r) => dirname(r.path)).filter((d) => d !== folder))].map((path) => ({ path, time: at(20, 9) }));
  const result = spawnSync("python3", ["-I", "-c", DATE_SCRIPT], { input: JSON.stringify([...rows.filter((r) => existsSync(r.path)), ...dirs]) });
  if (result.status !== 0) throw new Error(`backdating files: ${result.stderr}`);
  log(`backdated ${rows.length} files`);
}

