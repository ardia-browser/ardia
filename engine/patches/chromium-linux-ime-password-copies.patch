+template <typename Char>
+inline void WipeText(std::basic_string<Char>& text) {
+  text.resize(text.capacity());
+  for (Char& unit : text) {
+    *static_cast<volatile Char*>(&unit) = 0;
+  }
+  text.clear();
+}
+
+inline void WipeText(std::optional<std::u16string>& text) {
+  if (text) {
+    WipeText(*text);
+  }
+  text.reset();
+}
+
+inline void WipeComposition(CompositionText& composition) {
+  WipeText(composition.text);
+  composition = CompositionText();
+}
+
+}
