+// [Ardia: a line box is centred on its cap height, so lowercase text reads low next to an icon. The text is drawn a
+// whole number of device pixels higher, (cap height - x-height) * 0.375, without touching layout. Ardia]
+CGFloat RCTTextOpticalLift(NSFont *_Nullable font, CGFloat scale)
+{
+  if (font == nil || scale <= 0) {
+    return 0;
+  }
+  return MAX(0, round((font.capHeight - font.xHeight) * 0.375 * scale)) / scale;
+}
+
+static NSArray<NSValue *> *RCTTextShownCharacters(NSAttributedString *text, NSLayoutManager *_Nullable layoutManager, NSTextContainer *_Nullable textContainer)
+{
+  if (layoutManager == nil || textContainer == nil) {
+    return @[ [NSValue valueWithRange:NSMakeRange(0, text.length)] ];
+  }
+  NSMutableIndexSet *shownCharacters = [NSMutableIndexSet indexSet];
+  NSMutableIndexSet *hiddenCharacters = [NSMutableIndexSet indexSet];
+  NSRange glyphs = [layoutManager glyphRangeForTextContainer:textContainer];
+  for (NSUInteger glyph = glyphs.location; glyph < NSMaxRange(glyphs); glyph++) {
+    if ([layoutManager notShownAttributeForGlyphAtIndex:glyph]) {
+      [hiddenCharacters addIndex:[layoutManager characterIndexForGlyphAtIndex:glyph]];
+    }
+  }
+  for (NSUInteger glyph = glyphs.location; glyph < NSMaxRange(glyphs); glyph++) {
+    if ([layoutManager notShownAttributeForGlyphAtIndex:glyph]) {
+      continue;
+    }
+    NSRange characters = [layoutManager characterRangeForGlyphRange:NSMakeRange(glyph, 1) actualGlyphRange:NULL];
+    if (![hiddenCharacters intersectsIndexesInRange:characters]) {
+      [shownCharacters addIndexesInRange:characters];
+    }
+  }
+  NSMutableArray<NSValue *> *shown = [NSMutableArray array];
+  [shownCharacters enumerateRangesUsingBlock:^(NSRange range, __unused BOOL *stop) {
+    [shown addObject:[NSValue valueWithRange:range]];
+  }];
+  return shown;
+}
+
+static NSFont *RCTTextDominantFont(NSAttributedString *text, NSArray<NSValue *> *shown)
+{
+  NSString *string = text.string;
+  NSCharacterSet *blank = NSCharacterSet.whitespaceAndNewlineCharacterSet;
+  NSCharacterSet *control = NSCharacterSet.controlCharacterSet;
+  NSMutableDictionary<NSFont *, NSNumber *> *counts = [NSMutableDictionary dictionary];
+  __block NSFont *dominant = nil;
+  __block NSUInteger most = 0;
+  for (NSValue *part in shown) {
+    [text enumerateAttribute:NSFontAttributeName
+                     inRange:part.rangeValue
+                     options:NSAttributedStringEnumerationLongestEffectiveRangeNotRequired
+                  usingBlock:^(NSFont *font, NSRange range, __unused BOOL *stop) {
+                    if (font == nil) {
+                      return;
+                    }
+                    __block NSUInteger visible = 0;
+                    [string enumerateSubstringsInRange:range
+                                               options:NSStringEnumerationByComposedCharacterSequences | NSStringEnumerationSubstringNotRequired
+                                            usingBlock:^(__unused NSString *substring, NSRange character, __unused NSRange enclosing, __unused BOOL *innerStop) {
+                                              unichar first = [string characterAtIndex:character.location];
+                                              if (![blank characterIsMember:first] && ![control characterIsMember:first]) {
+                                                visible++;
+                                              }
+                                            }];
+                    NSUInteger total = counts[font].unsignedIntegerValue + visible;
+                    counts[font] = @(total);
+                    if (total > most) {
+                      most = total;
+                      dominant = font;
+                    }
+                  }];
+  }
+  return dominant;
+}
+
+static BOOL RCTTextHasAttachments(NSAttributedString *text)
+{
+  __block BOOL found = NO;
+  [text enumerateAttribute:NSAttachmentAttributeName
+                   inRange:NSMakeRange(0, text.length)
+                   options:0
+                usingBlock:^(id attachment, __unused NSRange range, BOOL *stop) {
+                  if (attachment != nil) {
+                    found = YES;
+                    *stop = YES;
+                  }
+                }];
+  return found;
+}
