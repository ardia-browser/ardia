{
  "version": 1,
  "manifests": {
    "bw": {
      "manifest": 2,
      "name": "fakewarden",
      "title": "Fakewarden",
      "description": "Fakewarden for the native argv fixture.",
      "version": "1.0.0",
      "requires": "1.41.0",
      "official": true,
      "main": "dist/main.js",
      "contributes": {
        "credentialProvider": {
          "title": "Fakewarden",
          "symbol": "key.fill",
          "capabilities": [
            "totp",
            "save",
            "edit"
          ],
          "signIn": {
            "methods": [
              {
                "id": "password",
                "title": "Email and Password",
                "fields": [
                  {
                    "id": "email",
                    "title": "Email",
                    "type": "email"
                  },
                  {
                    "id": "masterPassword",
                    "title": "Master Password",
                    "type": "secret"
                  }
                ]
              }
            ]
          },
          "cli": {
            "name": "bw",
            "install": {
              "command": "brew install bitwarden-cli",
              "url": "https://bitwarden.com/help/cli/"
            },
            "patterns": {
              "guid": "^[0-9a-fA-F-]{36}$",
              "word": "^[a-z-]{1,20}$"
            },
            "env": [
              {
                "name": "BW_NOINTERACTION",
                "literal": "true"
              },
              {
                "name": "BITWARDENCLI_APPDATA_DIR",
                "testFolder": ""
              },
              {
                "name": "ARDIA_TEST_MODE",
                "testLiteral": "1"
              }
            ],
            "verbs": {
              "status": {
                "argv": [
                  "status",
                  "--nointeraction"
                ],
                "slots": {
                  "session": {
                    "type": "secret",
                    "optional": true
                  }
                },
                "env": [
                  {
                    "name": "BW_SESSION",
                    "secretSlot": "session"
                  }
                ],
                "output": {
                  "mode": "json"
                }
              },
              "login.password": {
                "argv": [
                  "login",
                  {
                    "slot": "email"
                  },
                  "--passwordenv",
                  "ARDIA_BW_PASSWORD",
                  "--raw",
                  "--nointeraction",
                  {
                    "flag": "--method",
                    "slot": "method"
                  },
                  {
                    "flag": "--code",
                    "slot": "code"
                  }
                ],
                "slots": {
                  "email": {
                    "type": "email"
                  },
                  "password": {
                    "type": "secret"
                  },
                  "method": {
                    "type": "enum",
                    "values": [
                      "0",
                      "1",
                      "3"
                    ],
                    "optional": true
                  },
                  "code": {
                    "type": "code",
                    "optional": true
                  }
                },
                "env": [
                  {
                    "name": "ARDIA_BW_PASSWORD",
                    "secretSlot": "password"
                  }
                ],
                "timeoutMs": 60000,
                "signIn": true,
                "output": {
                  "mode": "lastLineSecret"
                },
                "unlocks": {
                  "persistent": true
                }
              },
              "unlock.stdin": {
                "argv": [
                  "unlock",
                  "--raw",
                  "--nointeraction"
                ],
                "slots": {
                  "password": {
                    "type": "secret"
                  }
                },
                "stdin": {
                  "slot": "password",
                  "encoding": "utf8"
                },
                "signIn": true,
                "output": {
                  "mode": "lastLineSecret"
                },
                "unlocks": true
              },
              "config.server.url": {
                "argv": [
                  "config",
                  "server",
                  {
                    "slot": "url"
                  },
                  "--nointeraction"
                ],
                "slots": {
                  "url": {
                    "type": "url",
                    "allowLocalHttp": true
                  }
                },
                "output": {
                  "mode": "lines"
                }
              },
              "config.server.strict": {
                "argv": [
                  "config",
                  "server",
                  {
                    "slot": "url"
                  }
                ],
                "slots": {
                  "url": {
                    "type": "url"
                  }
                },
                "output": {
                  "mode": "lines"
                }
              },
              "create.item": {
                "argv": [
                  "create",
                  "item",
                  "--nointeraction"
                ],
                "slots": {
                  "session": {
                    "type": "secret"
                  },
                  "item": {
                    "type": "json"
                  }
                },
                "env": [
                  {
                    "name": "BW_SESSION",
                    "secretSlot": "session"
                  }
                ],
                "stdin": {
                  "slot": "item",
                  "encoding": "base64"
                },
                "timeoutMs": 60000,
                "output": {
                  "mode": "json"
                }
              },
              "edit.item": {
                "argv": [
                  "edit",
                  "item",
                  {
                    "slot": "id"
                  }
                ],
                "slots": {
                  "session": {
                    "type": "secret"
                  },
                  "id": {
                    "type": "id",
                    "pattern": "guid"
                  },
                  "item": {
                    "type": "json"
                  }
                },
                "env": [
                  {
                    "name": "BW_SESSION",
                    "secretSlot": "session"
                  }
                ],
                "stdin": {
                  "slot": "item",
                  "encoding": "utf8"
                },
                "output": {
                  "mode": "json"
                }
              },
              "get.any": {
                "argv": [
                  "get",
                  {
                    "slot": "kind"
                  },
                  {
                    "slot": "id"
                  }
                ],
                "slots": {
                  "session": {
                    "type": "secret"
                  },
                  "kind": {
                    "type": "id",
                    "pattern": "word"
                  },
                  "id": {
                    "type": "id",
                    "pattern": "guid"
                  }
                },
                "env": [
                  {
                    "name": "BW_SESSION",
                    "secretSlot": "session"
                  }
                ],
                "output": {
                  "mode": "lines"
                }
              },
              "global.first": {
                "argv": [
                  "--nointeraction",
                  {
                    "slot": "sub"
                  }
                ],
                "slots": {
                  "sub": {
                    "type": "id",
                    "pattern": "word"
                  }
                },
                "output": {
                  "mode": "lines"
                }
              },
              "list.items": {
                "argv": [
                  "list",
                  "items",
                  "--nointeraction"
                ],
                "slots": {
                  "session": {
                    "type": "secret"
                  }
                },
                "env": [
                  {
                    "name": "BW_SESSION",
                    "secretSlot": "session"
                  }
                ],
                "timeoutMs": 90000,
                "outputLimitBytes": 167772160,
                "output": {
                  "mode": "json",
                  "items": "$"
                }
              }
            }
          }
        }
      }
    },
    "op": {
      "manifest": 2,
      "name": "fakeop",
      "title": "Fake Op",
      "description": "Fake Op for the native argv fixture.",
      "version": "1.0.0",
      "requires": "1.41.0",
      "official": true,
      "main": "dist/main.js",
      "contributes": {
        "credentialProvider": {
          "title": "Fake Op",
          "symbol": "key.fill",
          "capabilities": [
            "totp",
            "save",
            "edit"
          ],
          "signIn": {
            "methods": [
              {
                "id": "password",
                "title": "Email and Password",
                "fields": [
                  {
                    "id": "email",
                    "title": "Email",
                    "type": "email"
                  },
                  {
                    "id": "masterPassword",
                    "title": "Master Password",
                    "type": "secret"
                  }
                ]
              }
            ]
          },
          "cli": {
            "name": "op",
            "install": {
              "command": "brew install 1password-cli",
              "url": "https://developer.1password.com/docs/cli/"
            },
            "patterns": {
              "item": "^[a-z0-9]{26}$",
              "account": "^[A-Za-z0-9._@-]{1,64}$",
              "word": "^[a-z-]{1,20}$"
            },
            "verbs": {
              "item.get": {
                "argv": [
                  "item",
                  "get",
                  {
                    "slot": "id"
                  },
                  "--format",
                  "json",
                  {
                    "flag": "--account",
                    "slot": "account"
                  }
                ],
                "slots": {
                  "id": {
                    "type": "id",
                    "pattern": "item"
                  },
                  "account": {
                    "type": "id",
                    "pattern": "account",
                    "optional": true
                  }
                },
                "output": {
                  "mode": "json"
                }
              },
              "item.list": {
                "argv": [
                  "item",
                  "list",
                  {
                    "flag": "--reveal",
                    "when": "reveal"
                  },
                  "--format",
                  "json"
                ],
                "slots": {
                  "reveal": {
                    "type": "flag",
                    "optional": true
                  }
                },
                "output": {
                  "mode": "json",
                  "items": "$"
                }
              },
              "read.opt": {
                "argv": [
                  "--account",
                  {
                    "slot": "account"
                  },
                  {
                    "slot": "sub"
                  }
                ],
                "slots": {
                  "account": {
                    "type": "id",
                    "pattern": "account"
                  },
                  "sub": {
                    "type": "id",
                    "pattern": "word"
                  }
                },
                "output": {
                  "mode": "lines"
                }
              }
            }
          }
        }
      }
    }
  },
  "secrets": {
    "h1": "correct horse battery staple",
    "h2": "client-secret-value",
    "h3": "session0123456789abcdefSESSIONKEY"
  },
  "testFolder": "/scratch/data/Password Managers/fakewarden",
  "cases": [
    {
      "name": "a verb with no params runs its literal argv and the CLI's literal env",
      "manifest": "bw",
      "verb": "status",
      "params": {},
      "testInstance": false,
      "launch": {
        "argv": [
          "status",
          "--nointeraction"
        ],
        "env": {
          "BW_NOINTERACTION": "true"
        },
        "stdin": "",
        "timeoutMs": 30000,
        "signIn": false
      }
    },
    {
      "name": "an optional secret slot goes into its env entry",
      "manifest": "bw",
      "verb": "status",
      "params": {
        "session": {
          "$secret": "h3"
        }
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "status",
          "--nointeraction"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "BW_SESSION": "session0123456789abcdefSESSIONKEY"
        },
        "stdin": "",
        "timeoutMs": 30000,
        "signIn": false
      }
    },
    {
      "name": "test folders and test literals apply only in a hidden test instance",
      "manifest": "bw",
      "verb": "status",
      "params": {},
      "testInstance": true,
      "launch": {
        "argv": [
          "status",
          "--nointeraction"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "BITWARDENCLI_APPDATA_DIR": "/scratch/data/Password Managers/fakewarden",
          "ARDIA_TEST_MODE": "1"
        },
        "stdin": "",
        "timeoutMs": 30000,
        "signIn": false
      }
    },
    {
      "name": "flag slots render as one --flag=value token",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "login",
          "a@example.com",
          "--passwordenv",
          "ARDIA_BW_PASSWORD",
          "--raw",
          "--nointeraction",
          "--method=0",
          "--code=123456"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "ARDIA_BW_PASSWORD": "correct horse battery staple"
        },
        "stdin": "",
        "timeoutMs": 60000,
        "signIn": true
      }
    },
    {
      "name": "optional slots left out leave their tokens out",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        }
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "login",
          "a@example.com",
          "--passwordenv",
          "ARDIA_BW_PASSWORD",
          "--raw",
          "--nointeraction"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "ARDIA_BW_PASSWORD": "correct horse battery staple"
        },
        "stdin": "",
        "timeoutMs": 60000,
        "signIn": true
      }
    },
    {
      "name": "a plugin can lower a verb's timeout",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "login",
          "a@example.com",
          "--passwordenv",
          "ARDIA_BW_PASSWORD",
          "--raw",
          "--nointeraction",
          "--method=0",
          "--code=123456"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "ARDIA_BW_PASSWORD": "correct horse battery staple"
        },
        "stdin": "",
        "timeoutMs": 5000,
        "signIn": true
      },
      "timeoutMs": 5000
    },
    {
      "name": "a plugin can't raise a verb's timeout",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "login",
          "a@example.com",
          "--passwordenv",
          "ARDIA_BW_PASSWORD",
          "--raw",
          "--nointeraction",
          "--method=0",
          "--code=123456"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "ARDIA_BW_PASSWORD": "correct horse battery staple"
        },
        "stdin": "",
        "timeoutMs": 60000,
        "signIn": true
      },
      "timeoutMs": 900000
    },
    {
      "name": "a timeout under a second becomes a second",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "login",
          "a@example.com",
          "--passwordenv",
          "ARDIA_BW_PASSWORD",
          "--raw",
          "--nointeraction",
          "--method=0",
          "--code=123456"
        ],
        "env": {
          "BW_NOINTERACTION": "true",
          "ARDIA_BW_PASSWORD": "correct horse battery staple"
        },
        "stdin": "",
        "timeoutMs": 1000,
        "signIn": true
      },
      "timeoutMs": 10
    },
    {
      "name": "a required slot left out is refused by name",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "password": {
          "$secret": "h1"
        }
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "email is required for login.password."
      }
    },
    {
      "name": "an unknown param is refused",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456",
        "pin": "1234"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "login.password has no slot named pin."
      }
    },
    {
      "name": "a code with a space is refused",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "12 34"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "code for login.password must be 1 to 64 letters and digits."
      }
    },
    {
      "name": "an enum takes only its values",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "2",
        "code": "123456"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "method for login.password must be one of 0, 1, 3."
      }
    },
    {
      "name": "a secret slot takes only a handle, never plain text",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": "hunter2",
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "password for login.password must be a secret handle."
      }
    },
    {
      "name": "a handle in a text slot is refused",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": {
          "$secret": "h2"
        },
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "a handle only goes in a secret slot."
      }
    },
    {
      "name": "a handle that was used or ended is refused",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com",
        "password": {
          "$secret": "h9"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "refused": {
        "code": "expired",
        "message": "h9 was used or has ended."
      }
    },
    {
      "name": "an email that starts with - is refused",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "-x@example.com",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "email for login.password must be an email address."
      }
    },
    {
      "name": "an email with a newline is refused",
      "manifest": "bw",
      "verb": "login.password",
      "params": {
        "email": "a@example.com\n--raw",
        "password": {
          "$secret": "h1"
        },
        "method": "0",
        "code": "123456"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "email for login.password must be an email address."
      }
    },
    {
      "name": "an unknown verb is refused",
      "manifest": "bw",
      "verb": "list.all",
      "params": {},
      "testInstance": false,
      "refused": {
        "code": "refused",
        "message": "bw has no verb list.all."
      }
    },
    {
