{
  "name": "@ardia/browser-linux",
  "version": "0.0.0",
  "private": true,
  "description": "Ardia on Linux: the Electron host for the shared UI",
  "main": "out/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:ui": "vite build --config renderer/vite.config.ts",
    "build:ui:chromium": "vite build --config renderer/vite.chromium.config.ts",
    "build": "pnpm build:ui && pnpm build:main",
    "dev": "node scripts/dev.mjs",
    "dev:engine": "node scripts/dev-engine.mjs",
    "package": "node scripts/package.mjs",
    "package:engine": "node ../../../scripts/linux/package-engine.mjs",
    "start": "electron .",
    "test": "node --import ./scripts/test-hooks.mjs --test \"src/**/*.test.ts\"",
    "test:engine-fake": "node scripts/engine-fake.mjs",
    "typecheck": "tsc -p .",
    "typecheck:chromium": "tsc -p tsconfig.chromium.json"
  },
  "dependencies": {
    "@ardia/ardiacore": "workspace:*",
    "@ardia/core": "workspace:*",
    "@ardia/expo-linux": "workspace:*",
    "@ardia/import": "workspace:*",
    "@ardia/shaders": "workspace:*",
    "@ardia/shell": "workspace:*",
    "@ardia/sync": "workspace:*",
    "@browsermt/bergamot-translator": "0.4.9",
    "@ghostery/adblocker": "2.20.3",
    "adm-zip": "0.5.18",
    "cld3-asm": "4.0.0",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native-web": "^0.21.1",
    "tldts-experimental": "^7.5.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.7",
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "github:castlabs/electron-releases#v45.2.1+wvcus",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.9"
  }
}
