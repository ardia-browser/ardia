+                     LoginsChangedTrigger::Addition, std::move(completion)));
+}
+
+void PasswordStore::OnConditionalWrite(
+    LoginsChangedTrigger trigger,
+    base::OnceCallback<void(bool)> completion,
+    std::optional<PasswordStoreChangeList> changes) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  const bool applied = changes.has_value();
+  if (applied) {
+    NotifyLoginsChangedOnMainSequence(
+        trigger, base::expected<std::optional<PasswordStoreChangeList>,
+                                PasswordStoreBackendError>(std::move(changes)));
+  }
+  std::move(completion).Run(applied);
+}
