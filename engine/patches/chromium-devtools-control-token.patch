+class ArdiaWheelAcks : public RenderWidgetHost::InputEventObserver,
+                       public RenderWidgetHostObserver {
+ public:
+  static void Watch(RenderWidgetHostImpl* widget,
+                    base::TimeTicks wheel,
+                    base::TimeTicks ended,
+                    size_t first,
+                    base::RepeatingCallback<void(size_t, int)> resolve,
+                    scoped_refptr<ArdiaWheelTicket> ticket) {
+    new ArdiaWheelAcks(widget, wheel, ended, first, std::move(resolve),
+                       std::move(ticket));
+  }
+
+  ~ArdiaWheelAcks() override = default;
+
+  void OnInputEventAck(const RenderWidgetHost& host,
+                       blink::mojom::InputEventResultSource source,
+                       blink::mojom::InputEventResultState state,
+                       const blink::WebInputEvent& event) override {
+    if (event.GetType() != blink::WebInputEvent::Type::kMouseWheel) {
+      return;
+    }
+    if (event.TimeStamp() == wheel_ && !wheel_acked_) {
+      wheel_acked_ = true;
+      resolve_.Run(first_,
+                   source != blink::mojom::InputEventResultSource::kBrowser
+                       ? 2
+                       : 1);
+      if (ticket_) {
+        ticket_->Acked(false);
+      }
+    } else if (event.TimeStamp() == ended_ && !ended_acked_) {
+      ended_acked_ = true;
+      resolve_.Run(first_ + 1, 2);
+      if (ticket_) {
+        ticket_->Acked(true);
+      }
+    }
+    if (wheel_acked_ && ended_acked_) {
+      Finish();
+    }
+  }
+
+  void RenderWidgetHostDestroyed(RenderWidgetHost* host) override {
+    resolve_.Run(first_, 1);
+    resolve_.Run(first_ + 1, 1);
+    if (ticket_) {
+      ticket_->WidgetGone();
+    }
+    Finish();
+  }
+
+ private:
+  ArdiaWheelAcks(RenderWidgetHostImpl* widget,
+                 base::TimeTicks wheel,
+                 base::TimeTicks ended,
+                 size_t first,
+                 base::RepeatingCallback<void(size_t, int)> resolve,
+                 scoped_refptr<ArdiaWheelTicket> ticket)
+      : widget_(widget),
+        wheel_(wheel),
+        ended_(ended),
+        first_(first),
+        resolve_(std::move(resolve)),
+        ticket_(std::move(ticket)) {
+    widget_->AddInputEventObserver(this);
+    widget_->AddObserver(this);
+  }
+
+  void Finish() {
+    if (!widget_) {
+      return;
+    }
+    widget_->RemoveInputEventObserver(this);
+    widget_->RemoveObserver(this);
+    widget_ = nullptr;
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  raw_ptr<RenderWidgetHostImpl> widget_;
+  const base::TimeTicks wheel_;
+  const base::TimeTicks ended_;
+  const size_t first_;
+  base::RepeatingCallback<void(size_t, int)> resolve_;
+  scoped_refptr<ArdiaWheelTicket> ticket_;
+  bool wheel_acked_ = false;
+  bool ended_acked_ = false;
+};
