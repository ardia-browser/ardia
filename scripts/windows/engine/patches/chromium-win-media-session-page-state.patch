+// Ardia: whether the tab's media session belongs wholly to its primary page;
+// the Windows host reports a session only then.
+CONTENT_EXPORT bool ArdiaWinMediaSessionOnPrimaryPage(WebContents* contents) {
+  MediaSessionImpl* session =
+      contents ? MediaSessionImpl::FromWebContents(contents) : nullptr;
+  return session && session->ArdiaWinOnPrimaryPage();
+}
+
+// Ardia: the artwork the tab's media session declares now, which the Windows
+// host reports and lets the app download.
+CONTENT_EXPORT std::vector<media_session::MediaImage>
+ArdiaWinMediaSessionArtwork(WebContents* contents) {
+  MediaSessionImpl* session =
+      contents ? MediaSessionImpl::FromWebContents(contents) : nullptr;
+  return session ? session->ArdiaWinArtwork()
+                 : std::vector<media_session::MediaImage>();
+}
