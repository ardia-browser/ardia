+bool ArdiaMayInject(DevToolsSession* session,
+                    RenderFrameHostImpl* host,
+                    RenderWidgetHostImpl* widget) {
+  if (!g_ardia_devtools_may_input) {
+    return true;
+  }
+  if (!session || !widget) {
+    return false;
+  }
+  DevToolsAgentHostClient* client = session->GetRootSession()->GetClient();
+  if (g_ardia_devtools_may_input(client, nullptr)) {
+    return true;
+  }
+  WebContents* contents = host ? WebContents::FromRenderFrameHost(host) : nullptr;
+  if (!contents) {
+    return false;
+  }
+  auto* touch_emulator = static_cast<TouchEmulatorImpl*>(
+      static_cast<WebContentsImpl*>(contents)->GetTouchEmulator(false));
+  if (touch_emulator && touch_emulator->ArdiaEmulatingTouchFromMouse()) {
+    return false;
+  }
+  if (g_ardia_devtools_session_may_input &&
+      !g_ardia_devtools_session_may_input(client, session->ArdiaSessionId())) {
+    return false;
+  }
+  bool found = false;
+  bool allowed = true;
+  contents->ForEachRenderFrameHost([&](RenderFrameHost* frame) {
+    if (frame->GetRenderWidgetHost() == widget) {
+      found = true;
+      allowed = allowed && g_ardia_devtools_may_input(client, frame);
+    }
+  });
+  return found && allowed;
+}
