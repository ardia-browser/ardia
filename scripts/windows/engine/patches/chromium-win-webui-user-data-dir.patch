+std::vector<std::wstring> CommandLineToArgvWTokens(
+    const std::wstring& command_line) {
+  std::vector<std::wstring> tokens;
+  HMODULE shell = ::LoadLibraryExW(L"api-ms-win-downlevel-shell32-l1-1-0.dll",
+                                   nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+  if (!shell)
+    return tokens;
+  auto* split = reinterpret_cast<decltype(::CommandLineToArgvW)*>(
+      ::GetProcAddress(shell, "CommandLineToArgvW"));
+  int count = 0;
+  wchar_t** args = split ? split(command_line.c_str(), &count) : nullptr;
+  if (!args) {
+    ::FreeLibrary(shell);
+    return tokens;
+  }
+  for (int i = 0; i < count; ++i)
+    tokens.emplace_back(UNSAFE_BUFFERS(args[i]));
+  ::LocalFree(args);
+  ::FreeLibrary(shell);
+  return tokens;
+}
