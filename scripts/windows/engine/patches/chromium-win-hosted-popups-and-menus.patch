--- a/chrome/browser/ui/navigator/browser_navigator.cc
+++ b/chrome/browser/ui/navigator/browser_navigator.cc
@@ -112,6 +112,17 @@
 using content::WebContents;
 using WebExposedIsolationLevel = content::WebExposedIsolationLevel;
 
+#if BUILDFLAG(IS_WIN)
+// Ardia: the Windows engine host (ardia/win) keeps a tab or pop-up a page opens
+// from a window it hosts in the background of that window, offered to the app,
+// until the app shows it where it belongs.
+bool (*g_ardia_win_open_as_offer)(
+    BrowserWindowInterface* browser,
+    WindowOpenDisposition disposition,
+    const blink::mojom::WindowFeatures& features) = nullptr;
+void (*g_ardia_win_offer_inserted)() = nullptr;
+#endif
+
 namespace {
 
 struct AdditionalParams {
@@ -1212,6 +1223,25 @@
 
 base::WeakPtr<content::NavigationHandle> Navigate(NavigateParams* params) {
   AdditionalParams additional_params;
+#if BUILDFLAG(IS_WIN)
+  // Ardia: a tab or pop-up a page opens from a window the Windows engine host
+  // hosts.
+  if ((params->disposition == WindowOpenDisposition::NEW_POPUP ||
+       params->disposition == WindowOpenDisposition::NEW_FOREGROUND_TAB) &&
+      g_ardia_win_open_as_offer &&
+      g_ardia_win_open_as_offer(params->browser, params->disposition,
+                                params->window_features)) {
+    params->disposition = WindowOpenDisposition::NEW_BACKGROUND_TAB;
+    params->tabstrip_add_types |= AddTabTypes::ADD_INHERIT_OPENER;
+    params->window_action = NavigateParams::WindowAction::kNoAction;
+    base::WeakPtr<content::NavigationHandle> handle =
+        internal::NavigateImpl(params, additional_params);
+    if (g_ardia_win_offer_inserted) {
+      g_ardia_win_offer_inserted();
+    }
+    return handle;
+  }
+#endif
   return internal::NavigateImpl(params, additional_params);
 }
 
