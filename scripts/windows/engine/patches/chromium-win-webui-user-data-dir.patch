+TEST_F(UserDataDir, ArdiaShellSwitchMatchesBaseCommandLine) {
+  for (const bool react_native_app_present : {false, true}) {
+    SetReactNativeAppLibraryPresentForTesting(react_native_app_present);
+    for (const ShellSwitchCase& c : kShellSwitchCases) {
+      SCOPED_TRACE(base::WideToUTF8(c.command_line));
+      SCOPED_TRACE(react_native_app_present);
+      const bool early = IsWebUIShellCommandLine(c.command_line);
+      const base::CommandLine parsed =
+          base::CommandLine::FromString(c.command_line);
+      const std::wstring shell = parsed.GetSwitchValueNative("ardia-shell");
+      const bool late =
+          parsed.GetSwitchValueNative("type").empty() && shell != L"rnw" &&
+          (shell == L"webui" ||
+           (!parsed.HasSwitch("headless") && !react_native_app_present));
+      EXPECT_EQ(early, late);
+      if (!react_native_app_present && c.webui != kEither)
+        EXPECT_EQ(late, c.webui == 1);
+    }
+  }
+}
