+uint64_t ArdiaPageEpoch(DevToolsAgentHost* host) {
+  return protocol::ArdiaPageEpochOfContents(host ? host->GetWebContents()
+                                                 : nullptr);
+}
+
+void ArdiaDispatchPointer(DevToolsAgentHost* host,
+                          DevToolsAgentHostClient* root_client,
+                          const std::string& session_id,
+                          const ArdiaPointer& pointer,
+                          base::OnceCallback<void(std::string error)> done) {
+  if (host) {
+    for (protocol::InputHandler* handler : protocol::InputHandler::ForAgentHost(
+             static_cast<DevToolsAgentHostImpl*>(host))) {
+      if (handler->ArdiaIsSession(root_client, session_id)) {
+        handler->ArdiaDispatchPointer(
+            static_cast<int>(pointer.kind), pointer.x, pointer.y,
+            pointer.button, pointer.click_count, pointer.modifiers,
+            pointer.delta_x, pointer.delta_y, pointer.epoch,
+            pointer.wheel_ticket, std::move(done));
+        return;
+      }
+    }
+  }
+  std::move(done).Run(ardia::refusal::kSessionCantSendInput);
+}
