+constexpr base::TimeDelta kArdiaAckDeadline = base::Seconds(5);
+
+bool ArdiaPersonBusy(RenderFrameHostImpl* host) {
+  WebContentsImpl* contents =
+      host ? WebContentsImpl::FromRenderFrameHostImpl(host) : nullptr;
+  RenderWidgetHostImpl* widget = host ? host->GetRenderWidgetHost() : nullptr;
+  if (!contents || !widget) {
+    return false;
+  }
+  const base::TimeTicks last = contents->ArdiaLastPersonInput();
+  return ardia::PersonBusy(widget->IsHidden(), !last.is_null(),
+                           (base::TimeTicks::Now() - last).InMicroseconds());
+}
+
+uint64_t ArdiaPageEpochOf(WebContents* contents) {
+  return contents
+             ? ArdiaPageEpochTracker::GetOrCreateForWebContents(contents)
+                   ->value()
+             : 0;
+}
