{
  "name": "@ardia/phone",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "main": "index.js",
  "reanimated": {
    "staticFeatureFlags": {
      "FORCE_REACT_RENDER_FOR_SETTLED_ANIMATIONS": false,
      "ANDROID_SYNCHRONOUSLY_UPDATE_UI_PROPS": true,
      "IOS_SYNCHRONOUSLY_UPDATE_UI_PROPS": true
    }
  },
  "scripts": {
    "dev": "expo start --port 8091",
    "android": "scripts/gradle-locked :app:assembleDebug",
    "typecheck": "tsrs -p . && tsrs -p tsconfig.test.json && tsrs -p tsconfig.render.json",
    "test": "node --no-warnings --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\" && jest --config jest.config.js --ci && jest --config jest.release.config.js --ci",
    "test:render": "jest --config jest.config.js --ci && jest --config jest.release.config.js --ci",
    "credits": "node --no-warnings test/credits.ts --write"
  },
  "dependencies": {
    "@ardia/core": "link:../../packages/core",
    "@ardia/phone-native": "workspace:*",
    "@expo/ui": "~58.0.28",
    "expo": "~58.0.25",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-localization": "~58.0.5",
    "expo-modules-core": "~58.1.0",
    "expo-sqlite": "~58.0.17",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.25",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-test-renderer": "19.3.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "~6.0.3"
  }
}
