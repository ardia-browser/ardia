+std::u16string MaskedText(std::u16string_view text) {
+  std::u16string masked;
+  masked.reserve(text.size());
+  for (base::i18n::UTF16CharIterator iter(text); !iter.end(); iter.Advance()) {
+    const int32_t code_point = iter.get();
+    if (code_point < 0x80) {
+      masked += u'x';
+    } else if (code_point < 0x800) {
+      masked += u'\u00b7';
+    } else if (code_point < 0x10000) {
+      masked += u'\u2022';
+    } else {
+      masked += u"\U0001F511";
+    }
+  }
+  return masked;
+}
+
+CompositionText MaskedComposition(const CompositionText& composition) {
+  CompositionText masked;
+  masked.text = MaskedText(composition.text);
+  masked.ime_text_spans = composition.ime_text_spans;
+  masked.selection = composition.selection;
+  return masked;
 }
 
