Ardia's uBlock Origin loads on Windows as a component extension, which Chrome lets script every page. The restricted
URL check runs in every process, so the hook that keeps it off restricted pages (chrome://, the Web Store) is set in
BasicStartupComplete, before any process reads it, as chromium-ardia-linux-layer.patch does on Linux.

--- a/chrome/app/chrome_main_delegate.cc
+++ b/chrome/app/chrome_main_delegate.cc
@@ -41,6 +41,11 @@
 #include "base/time/time.h"
 #include "base/timer/timer.h"
 #include "build/build_config.h"
+
+#if BUILDFLAG(IS_WIN)
+#include "ardia/core/ac_content_hooks.h"  // nogncheck
+#include "ardia/linux/ac_linux_site_controls.h"  // nogncheck
+#endif
 #include "chrome/common/buildflags.h"
 #include "chrome/common/channel_info.h"
 #include "chrome/common/chrome_constants.h"
@@ -1194,7 +1199,20 @@
           std::move(tracing_factory), unwinder_type);
 }

+#if BUILDFLAG(IS_WIN)
+namespace {
+
+bool IsArdiaWindowsContentBlocker(const extensions::ExtensionId& extension_id) {
+  return extension_id == linux_site_controls::kExtensionId;
+}
+
+}
+#endif
+
