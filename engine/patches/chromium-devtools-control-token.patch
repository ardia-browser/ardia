+  return session() && session()->GetRootSession()->GetClient() == root_client &&
+         session()->ArdiaSessionId() == session_id;
+}
+
+void InputHandler::ArdiaDispatchPointer(
+    int kind,
+    double x,
+    double y,
+    const std::string& button,
+    int click_count,
+    int modifiers,
+    double delta_x,
+    double delta_y,
+    uint64_t epoch,
+    scoped_refptr<ArdiaWheelTicket> wheel_ticket,
+    base::OnceCallback<void(std::string)> done) {
+  const bool click = kind == static_cast<int>(ArdiaPointer::Kind::kClick);
+  const bool wheel = kind == static_cast<int>(ArdiaPointer::Kind::kWheel);
+  if (!host_ || host_->GetParentOrOuterDocument() ||
+      !host_->IsInPrimaryMainFrame()) {
+    std::move(done).Run(
+        ardia::refusal::kNotPageSession);
+    return;
+  }
+  RenderWidgetHostImpl* widget_host =
+      host_ ? host_->GetRenderWidgetHost() : nullptr;
+  WebContents* contents =
+      host_ ? WebContents::FromRenderFrameHost(host_) : nullptr;
+  if (!widget_host || !contents || !widget_host->delegate() ||
+      !widget_host->GetInputEventRouter() || !widget_host->GetView()) {
+    std::move(done).Run(ardia::refusal::kNoPage);
+    return;
+  }
+  if (ArdiaPageEpochOf(contents) != epoch) {
+    std::move(done).Run(ardia::refusal::kPageChanged);
+    return;
+  }
+  if (ardia::RefusesHiddenTarget(wheel, widget_host->IsHidden())) {
+    std::move(done).Run(ardia::refusal::kPageHidden);
+    return;
+  }
+  if (wheel && ArdiaPersonBusy(host_)) {
+    std::move(done).Run(ardia::refusal::kBusy);
+    return;
+  }
+  std::vector<std::unique_ptr<blink::WebMouseEvent>> events;
+  const bool right = button == Input::MouseButtonEnum::Right;
+  if (click) {
+    for (int count = 1; count <= click_count; ++count) {
+      for (const bool press : {true, false}) {
+        auto event = CreateWebMouseEvent(
+            press ? Input::DispatchMouseEvent::TypeEnum::MousePressed
+                  : Input::DispatchMouseEvent::TypeEnum::MouseReleased,
+            x, y, ScaleFactor(), modifiers, std::nullopt, button,
+            press ? (right ? 2 : 1) : 0, count, std::nullopt, std::nullopt,
+            std::nullopt, std::nullopt, std::nullopt, std::nullopt,
+            std::nullopt, std::nullopt);
+        if (!event.has_value()) {
+          std::move(done).Run(ardia::refusal::kInputCantBeMade);
+          return;
+        }
+        if (!press) {
+          (*event)->SetModifiers(
+              (*event)->GetModifiers() &
+              ~(right ? blink::WebInputEvent::kRightButtonDown
+                      : blink::WebInputEvent::kLeftButtonDown));
+        }
+        events.push_back(std::move(event).value());
+      }
+    }
+  } else {
+    auto event = CreateWebMouseEvent(
+        wheel ? Input::DispatchMouseEvent::TypeEnum::MouseWheel
+              : Input::DispatchMouseEvent::TypeEnum::MouseMoved,
+        x, y, ScaleFactor(), modifiers, std::nullopt,
+        std::string(Input::MouseButtonEnum::None), 0, 0, std::nullopt,
+        std::nullopt, std::nullopt, std::nullopt, std::nullopt,
+        wheel ? std::optional<double>(delta_x) : std::nullopt,
+        wheel ? std::optional<double>(delta_y) : std::nullopt, std::nullopt);
+    if (!event.has_value()) {
+      std::move(done).Run(ardia::refusal::kInputCantBeMade);
+      return;
+    }
+    events.push_back(std::move(event).value());
+  }
+  const gfx::PointF position = events.front()->PositionInWidget();
+  const gfx::Size view_size = widget_host->GetView()->GetVisibleViewportSize();
+  if (!std::isfinite(position.x()) || !std::isfinite(position.y()) ||
+      position.x() < 0 || position.y() < 0 ||
+      position.x() >= view_size.width() ||
+      position.y() >= view_size.height()) {
+    std::move(done).Run(ardia::refusal::kOutsidePage);
+    return;
+  }
+  auto run = base::MakeRefCounted<ArdiaPointerRun>(
+      kind, epoch, contents->GetWeakPtr(), weak_factory_.GetWeakPtr(),
+      std::move(wheel_ticket), std::move(done));
+  auto find_widget = base::BindOnce(
+      [](base::WeakPtr<InputHandler> self,
+         base::WeakPtr<RenderWidgetHostImpl> widget, gfx::PointF position,
+         std::vector<std::unique_ptr<blink::WebMouseEvent>> events,
+         scoped_refptr<ArdiaPointerRun> run, bool success) {
+        if (!self || !widget || !widget->delegate() || !widget->GetView()) {
+          return;
+        }
+        widget->delegate()->GetRenderWidgetHostAtPointAsynchronously(
+            widget->GetView(), position,
+            base::BindOnce(&InputHandler::ArdiaInjectPointer, self,
+                           std::move(events), std::move(run)));
+      },
+      weak_factory_.GetWeakPtr(), widget_host->GetWeakPtr(), position,
+      std::move(events), std::move(run));
+  if (wheel) {
+    widget_host->InsertVisualStateCallback(std::move(find_widget));
+  } else {
+    std::move(find_widget).Run(true);
+  }
+}
+
+void InputHandler::ArdiaInjectPointer(
+    std::vector<std::unique_ptr<blink::WebMouseEvent>> events,
+    scoped_refptr<ArdiaPointerRun> run,
+    base::WeakPtr<RenderWidgetHostViewBase> target,
+    std::optional<gfx::PointF> point) {
+  if (!target || !point.has_value()) {
+    run->Fail(ardia::refusal::kNothingThere);
+    return;
+  }
+  if (run->EpochChanged()) {
+    run->Fail(ardia::refusal::kPageChanged);
+    return;
+  }
+  RenderWidgetHostImpl* widget_host =
+      RenderWidgetHostImpl::From(target->GetRenderWidgetHost());
+  if (!ArdiaMayInject(session(), host_, widget_host)) {
+    run->Fail(ardia::refusal::kInputNotAllowed);
+    return;
+  }
+  const bool is_wheel = !events.empty() &&
+                        events.front()->GetType() ==
+                            blink::WebInputEvent::Type::kMouseWheel;
+  if (ardia::RefusesHiddenTarget(is_wheel, widget_host->IsHidden())) {
+    run->Fail(ardia::refusal::kPageHidden);
+    return;
+  }
+  if (is_wheel && ArdiaPersonBusy(host_)) {
+    run->Fail(ardia::refusal::kBusy);
+    return;
+  }
+  if (is_wheel && widget_host->IsIgnoringWebInputEvents(*events.front())) {
+    run->Fail(ardia::refusal::kNotTakingInput);
+    return;
+  }
+  const gfx::PointF screen_point =
+      ConvertWidgetPointToScreenPoint(CHECK_DEREF(target.get()), *point);
+  std::optional<blink::WebMouseEvent> recovery_release;
+  for (std::unique_ptr<blink::WebMouseEvent>& event : events) {
+    event->SetPositionInWidget(*point);
+    event->SetPositionInScreen(screen_point);
+    if (run->click() && !recovery_release &&
+        event->GetType() == blink::WebInputEvent::Type::kMouseUp) {
+      recovery_release = *event;
+      recovery_release->click_count = 1;
+    }
+  }
+  base::WeakPtr<RenderWidgetHostImpl> widget = widget_host->GetWeakPtr();
+  std::vector<bool> presses;
+  for (const std::unique_ptr<blink::WebMouseEvent>& event : events) {
+    presses.push_back(event->GetType() ==
+                      blink::WebInputEvent::Type::kMouseDown);
+  }
+  if (is_wheel) {
+    presses.push_back(false);
+  }
+  run->Start(std::move(presses), widget, std::move(recovery_release));
+  if (run->click()) {
+    widget_host->Focus();
+  }
+  for (size_t index = 0; index < events.size(); ++index) {
+    if (!widget || run->EpochChanged()) {
+      run->Resolve(index, 0);
+      if (is_wheel) {
+        run->Resolve(index + 1, 0);
+      }
+      continue;
+    }
+    ui::LatencyInfo latency;
+    latency.set_trace_id(
+        static_cast<int64_t>(base::trace_event::GetNextGlobalTraceId()));
+    blink::WebMouseEvent& event = *events[index];
+    if (event.GetType() == blink::WebInputEvent::Type::kMouseWheel) {
+      auto& wheel = static_cast<blink::WebMouseWheelEvent&>(event);
+      const base::TimeTicks stamp = base::TimeTicks::Now();
+      wheel.SetTimeStamp(stamp);
+      blink::WebMouseWheelEvent ended = wheel;
+      ended.delta_x = 0;
+      ended.delta_y = 0;
+      ended.wheel_ticks_x = 0;
+      ended.wheel_ticks_y = 0;
+      ended.phase = blink::WebMouseWheelEvent::kPhaseEnded;
+      ended.dispatch_type = blink::WebInputEvent::DispatchType::kEventNonBlocking;
+      ended.SetTimeStamp(stamp + base::Microseconds(1));
+      if (run->wheel_ticket() && !run->wheel_ticket()->Forward()) {
+        run->Fail(ardia::refusal::kNotDelivered);
+        return;
+      }
+      ArdiaWheelAcks::Watch(widget.get(), stamp, ended.TimeStamp(), index,
+                            run->Resolver(), run->wheel_ticket());
+      widget->ForwardWheelEventWithLatencyInfo(wheel, latency);
+      if (widget) {
+        widget->ForwardWheelEventWithLatencyInfo(ended, ui::LatencyInfo());
+      }
+      for (size_t pending : {index, index + 1}) {
+        base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+            FROM_HERE, base::BindOnce(&ArdiaPointerRun::Expire, run, pending),
+            kArdiaAckDeadline);
+      }
+      continue;
+    }
+    widget->ArdiaExpectMouseAck(
+        base::BindOnce(&ArdiaPointerRun::Resolve, run, index));
+    widget->ForwardMouseEventWithLatencyInfo(event, latency);
+    base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&ArdiaPointerRun::Expire, run, index),
+        kArdiaAckDeadline);
+  }
+}
