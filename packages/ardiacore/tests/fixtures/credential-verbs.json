      "manifest": "bw",
      "verb": "config.server.url",
      "params": {
        "url": "http://127.0.0.1:8080"
      },
      "testInstance": false,
      "launch": {
        "argv": [
          "config",
          "server",
          "http://127.0.0.1:8080",
          "--nointeraction"
        ],
        "env": {
          "BW_NOINTERACTION": "true"
        },
        "stdin": "",
        "timeoutMs": 30000,
        "signIn": false
      }
    },
    {
      "name": "allowLocalHttp still refuses http to another host",
      "manifest": "bw",
      "verb": "config.server.url",
      "params": {
        "url": "http://vault.example.com"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "url for config.server.url must be an https address, or http to this Mac."
      }
    },
    {
      "name": "a url slot without allowLocalHttp refuses http to this Mac",
      "manifest": "bw",
      "verb": "config.server.strict",
      "params": {
        "url": "http://localhost:8080"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "url for config.server.strict must be an https address."
      }
    },
    {
      "name": "a url with a user and password is refused",
      "manifest": "bw",
      "verb": "config.server.url",
      "params": {
        "url": "https://user:pw@vault.example.com"
      },
      "testInstance": false,
      "refused": {
        "code": "bad_request",
        "message": "url for config.server.url must be an https address, or http to this Mac."
      }
    },
    {
      "name": "a json slot goes to stdin with sorted keys, base64 encoded",
      "manifest": "bw",
      "verb": "create.item",
      "params": {
        "session": {
          "$secret": "h3"
        },
        "item": {
          "type": 1,
          "name": "Example",
          "login": {
            "username": "a",
            "uris": [
              {
                "uri": "https://example.com/"
              }
