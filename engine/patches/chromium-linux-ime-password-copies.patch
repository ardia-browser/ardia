+      u"Earlier");
+
+  LinuxInputMethodContext::TextInputClientAttributes attributes;
+  attributes.input_type = TEXT_INPUT_TYPE_PASSWORD;
+  input_method_context_->UpdateFocus(true, TEXT_INPUT_TYPE_NONE, attributes,
+                                     ui::TextInputClient::FOCUS_REASON_OTHER);
+  EXPECT_EQ(
+      input_method_context_->predicted_state_for_testing().surrounding_text,
+      u"");
+
+  input_method_context_->OnPreeditString("Se\xC3\xA9\xE2\x82\xAC\xF0\x9F\x98\x80",
+                                         {}, gfx::Range(11));
+  EXPECT_EQ(input_method_context_delegate_->last_preedit()->text,
+            u"Se\u00e9\u20ac\U0001F600");
+  EXPECT_EQ(
