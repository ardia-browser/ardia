---
import { base, homeUrl } from "../data/site";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Showcase from "../components/Showcase.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
import { aboutArdiaPage, breadcrumbs } from "../data/jsonLd";

const home = homeUrl(Astro.site);
const url = new URL("try/", home).href;
const title = "Try Ardia live · an Arc and Dia alternative you can click";
const description =
  "Click around the real Ardia sidebar right here: tabs, split view, the command bar and profiles. Free for Mac once you’re done kicking the tires.";
const jsonLd = [aboutArdiaPage({ home, url, title, description }), breadcrumbs(home, ["Demo", url])];
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <Header home={`${base}/`} current="try" />
  <main id="main">
    <section class="intro" aria-labelledby="try-title">
      <div class="wrap">
        <p class="label kicker">Live demo</p>
        <h1 class="poster" id="try-title"><span class="visually-hidden">Try Ardia in your browser: </span>Kick the tires.</h1>
        <p class="lede">
          The real sidebar, running in this page. Click a tab, split two side by side, put the tabs on top, open the command bar.
          Nothing to install until you want the real thing.
        </p>
      </div>
    </section>

    <Showcase />

    <section class="what paint edge" data-paint="midmorning" aria-labelledby="what-title">
      <div class="wrap">
        <p class="label kicker">What you just clicked</p>
        <h2 class="poster" id="what-title">Arc’s sidebar. Dia’s look.</h2>
        <div class="cols">
          <div class="col">
            <h3>Import from Arc</h3>
            <p>
              Bring over your spaces, pinned tabs, folders and themes in one step. Updates ship most weeks; see the{" "}
              <a class="link" href={`${base}/release-notes/`}>release notes</a>.
            </p>
          </div>
          <div class="col">
            <h3>Chromium underneath</h3>
            <p>
              Looks like Dia by default, or Arc in Settings. Sites and Chrome extensions run as expected, with no built-in AI.
            </p>
          </div>
          <div class="col">
            <h3>Measured speed</h3>
            <p>
              Benchmarked against Dia and Helium on launch, memory, CPU and power. <a class="link" href={`${base}/benchmarks/`}
                >See the benchmarks</a
              >.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Closing />
  </main>
  <Footer />
</Base>

<style>
  .intro {
    padding: clamp(36px, 5vw, 80px) 0 clamp(8px, 1.5vw, 24px);
  }
  .intro h1 {
    font-size: var(--t-mega);
    margin-left: -0.04em;
  }
  .lede {
    margin-top: clamp(20px, 2.4vw, 32px);
    max-width: 30em;
    font-size: var(--t-lede);
    color: var(--ink-2);
  }
  .what {
    padding: clamp(64px, 8vw, 120px) 0 var(--section);
  }
  .what h2 {
    font-size: var(--t-h2);
    max-width: 12em;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    margin-top: clamp(36px, 4vw, 64px);
    border-top: 2px solid var(--ink);
    padding-top: 24px;
  }
  .col h3 {
    font-weight: 640;
    font-size: 1.25rem;
    line-height: 1.25;
    letter-spacing: -0.022em;
  }
  .col p {
    margin-top: 10px;
    color: var(--ink-2);
  }
  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import "../scripts/motion";
  import "../scripts/tilt";
</script>
