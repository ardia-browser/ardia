+  if (g_ardia_win_hosts_normal_windows && browser_view_ &&
+      browser_view_->GetIsNormalType()) {
+    return false;
+  }
   need_regenerate |=
       (theme_change_type == BrowserThemeChangeType::kBrowserTheme) &&
       !IsFullscreen();
