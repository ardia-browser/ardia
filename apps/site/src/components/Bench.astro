---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { base } from "../data/site";
import { bench, BENCH_METHOD } from "../data/bench";
import { scorecardOf } from "../data/benchScorecard";
import ardiaLogo from "../assets/app-icon.png";
import diaLogo from "../assets/logos/dia.png";
import heliumLogo from "../assets/logos/helium.png";

interface Props {
  page?: boolean;
  heading?: "h1" | "h2";
}
const { page = false, heading } = Astro.props;
const Title = heading ?? (page ? "h1" : "h2");

const logos: Record<string, ImageMetadata> = {
  ardia: ardiaLogo,
  dia: diaLogo,
  helium: heliumLogo,
};

const card = bench ? scorecardOf(bench) : null;
const sections = card ? (page ? card.sections : card.sections.filter((s) => s.tests.every((t) => !t.isMulti))) : [];
const rivalNames = bench?.rivals ?? ["Dia", "Helium"];
const rivals = rivalNames.length > 1 ? `${rivalNames.slice(0, -1).join(", ")} and ${rivalNames.at(-1)}` : rivalNames.join("");
const lede = page
  ? "Every test, every number, losses included. Lower is better, except Speedometer 3. The best number in each row is highlighted."
  : "Launch, tabs, and Speedometer 3, medians only. Lower is better, except Speedometer 3. The best number in each row is highlighted.";
const slugOf = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const highlights = (() => {
  if (page || !sections.length) return [];
  const flat = sections.flatMap((s) => s.tests.flatMap((t) => t.lines));
  const picks = [
    { match: /window on screen/i, title: "Cold launch" },
    { match: /new window/i, title: "New window" },
    { match: /tab switch/i, title: "Tab switch" },
  ];
  return picks
    .map(({ match, title }) => {
      const row = flat.find((line) => match.test(line.label));
      if (!row || !row.callout.figure) return null;
      const ardia = row.cells.find((c) => c.isArdia);
      const dia = row.cells.find((c) => c.name === "Dia");
      return {
        title,
        figure: row.callout.figure,
        detail: row.callout.line,
        compare: ardia && dia && dia.number !== null ? `${ardia.display} vs ${dia.display}` : ardia?.display ?? "",
      };
    })
    .filter((item): item is NonNullable<typeof item> => item !== null);
})();
---

{
  bench && card && (
    <section class:list={["bb paint", { edge: !page, "bb-page": page }]} data-paint="golden" id="speed" aria-labelledby="bench-title" data-shot="bench" data-bench>
      <div class="wrap">
        <header class="bb-head">
          <p class="label kicker">Measured against {rivals}</p>
          <Title class="poster bb-heading" id="bench-title">
            {page && <span class="visually-hidden">Ardia vs {rivalNames.join(" vs ")}: </span>}Benchmarks.
          </Title>
          <p class="lede">{lede}</p>
          {bench.sample && <p class="label sample">Sample numbers. Not measured. Dev only.</p>}
        </header>

        {highlights.length > 0 && (
          <ul class="stat-strip" role="list">
            {highlights.map((item) => (
              <li class="stat-tile">
                <p class="stat-label">{item.title}</p>
                <p class="stat-figure">{item.figure}</p>
                <p class="stat-detail">{item.detail}</p>
                {item.compare && <p class="stat-compare">{item.compare}</p>}
              </li>
            ))}
          </ul>
        )}

        <div class="sheet-card">
          <div class="table-wrap">
            <table class="sheet">
              <caption class="visually-hidden">Ardia vs {rivals}: browser benchmarks, medians only</caption>
              <colgroup>
                <col class="t" />
                {card.roster.map(() => <col class="n" />)}
                <col class="x" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col" class="test-col">Metric</th>
                  {card.roster.map((name) => {
                    const slug = slugOf(name);
                    const logo = logos[slug];
                    return (
                      <th scope="col" class="who-col" data-browser={slug}>
                        <span class="who-head">
                          {logo ? (
                            <Image class="brand-logo" src={logo} alt="" width={20} height={20} densities={[1, 2]} />
                          ) : (
                            <i class="dot" aria-hidden="true"></i>
                          )}
                          <span>{name}</span>
                        </span>
                      </th>
                    );
                  })}
                  <th scope="col" class="x-col">Comparison</th>
                </tr>
              </thead>
              <tbody>
                {sections.map((section) => (
                  <>
                    <tr class="g">
                      <th colspan={card.roster.length + 2} class="label">{section.title}</th>
                    </tr>
                    {section.tests.map((group) => (
                      <>
                        {group.isMulti && (
                          <tr class="r head">
                            <th scope="row" colspan={card.roster.length + 1}>
                              {group.title} <span class="unit">{group.unit}</span>
                              {(group.headline.figure || group.headline.line) && (
                                <span class="m-callout">
                                  {group.headline.figure && <><b>{group.headline.figure}</b>{" "}</>}
                                  {group.headline.line}
                                </span>
                              )}
                            </th>
                            <td class="x">
                              {group.headline.figure && <><b>{group.headline.figure}</b>{" "}</>}
                              {group.headline.line}
                            </td>
                          </tr>
                        )}
                        {group.lines.map((line) => (
                          <tr class:list={["r", { sub: group.isMulti }]}>
                            <th scope="row" title={line.detail ?? undefined}>
                              <span class="row-label">{line.label}</span>
                              {line.detail && <span class="visually-hidden"> ({line.detail})</span>}
                              {!group.isMulti && (line.callout.figure || line.callout.line) && (
                                <span class="m-callout">
                                  {line.callout.figure && <><b>{line.callout.figure}</b>{" "}</>}
                                  {line.callout.line}
                                </span>
                              )}
                            </th>
                            {line.cells.map((cell) => (
                              <td
                                class:list={["n", { us: cell.isArdia, best: cell.isBest, none: cell.number === null }]}
                                data-browser={slugOf(cell.name)}
                                data-who={cell.name}
                              >
                                <span class="visually-hidden">{cell.spoken}</span>
                                <span class="val" aria-hidden="true">{cell.display}</span>
                              </td>
                            ))}
                            <td class="x">
                              {!group.isMulti && (
                                <>
                                  {line.callout.figure && <><b>{line.callout.figure}</b>{" "}</>}
                                  {line.callout.line}
                                </>
                              )}
                            </td>
                          </tr>
                        ))}
                      </>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div class="colophon">
          <p class="label colophon-title">The small print</p>
          <p>
            {bench.dated ? `${bench.machine}. ${bench.dated}.` : `${bench.machine}, ${bench.date}. ${bench.versions}.`}
            {bench.elsewhere && ` ${bench.elsewhere}.`}
          </p>
          <p>Every figure is a median, so one lucky run doesn’t count.</p>
          <p class="links">
            {!page && (
              <a class="link label" href={`${base}/benchmarks/`}>
                All {card.total} tests: memory, idle CPU, wakeups, and power
              </a>
            )}
            <a class="link label" href={BENCH_METHOD} rel="noopener" data-track="github_clicked" data-track-link="bench_method" data-track-location="bench">
              How we measure
            </a>
          </p>
        </div>
      </div>
    </section>
  )
}

<style>
  .bb {
    --bar-ardia: oklch(0.38 0.09 162);
    --bar-dia: oklch(0.38 0.11 262);
    --bar-helium: oklch(0.38 0.11 325);
    --bar-color: var(--rival);
    padding: clamp(68px, 7.5vw, 128px) 0 clamp(68px, 8vw, 128px);
  }
  .bb [data-browser="ardia"] {
    --bar-color: var(--bar-ardia);
  }
  .bb [data-browser="dia"] {
    --bar-color: var(--bar-dia);
  }
  .bb [data-browser="helium"] {
    --bar-color: var(--bar-helium);
  }
  .bb-page {
    padding-top: clamp(56px, 7vw, 112px);
  }
  .bb-heading {
    font-size: var(--t-h2);
  }
  .lede {
    font-size: var(--t-lede);
    line-height: 1.44;
    max-width: 34em;
    margin-top: 14px;
    color: var(--ink);
  }
  .sample {
    display: inline-block;
    margin-top: 18px;
    padding: 4px 10px;
    color: var(--stamp);
    border: 1.5px solid currentColor;
    border-radius: 6px;
    transform: rotate(-1.5deg);
  }

  .stat-strip {
    list-style: none;
    margin: clamp(24px, 3vw, 36px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.8vw, 20px);
  }
  .stat-tile {
    padding: clamp(16px, 1.8vw, 20px) clamp(18px, 2vw, 24px) clamp(18px, 2vw, 24px);
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid transparent;
    box-shadow:
      0 0 0 1px rgb(22 19 15 / 0.08),
      0 1px 2px rgb(22 19 15 / 0.04),
      0 14px 30px -20px rgb(74 44 12 / 0.2);
  }
  .stat-label {
    font-size: 0.84rem;
    font-weight: 560;
    color: var(--ink-2);
    letter-spacing: -0.01em;
  }
  .stat-figure {
    margin-top: 4px;
    font-size: clamp(2rem, 1.4rem + 1.8vw, 3rem);
    font-weight: 740;
    letter-spacing: -0.036em;
    line-height: 1;
    color: var(--figure);
    font-variant-numeric: tabular-nums;
  }
  .stat-detail {
    margin-top: 6px;
    font-size: 0.88rem;
    font-weight: 520;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .stat-compare {
    margin-top: 2px;
    font-size: 0.8rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  .sheet-card {
    margin-top: clamp(16px, 2vw, 24px);
    padding: clamp(18px, 2.2vw, 26px) clamp(10px, 1.4vw, 18px) clamp(16px, 2vw, 24px);
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid transparent;
    box-shadow:
      0 0 0 1px rgb(22 19 15 / 0.08),
      0 1px 2px rgb(22 19 15 / 0.04),
      0 20px 44px -26px rgb(74 44 12 / 0.22);
  }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  table.sheet {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-variant-numeric: tabular-nums;
  }
  col.t {
    width: 38%;
  }
  col.n {
    width: 13%;
  }
  col.x {
    width: 23%;
  }
  th,
  td {
    padding: 0;
    text-align: end;
    vertical-align: middle;
    font-weight: inherit;
  }
  thead th {
    padding-block: 0 14px;
    border-bottom: 1px solid rgb(22 19 15 / 0.1);
    font-size: 0.82rem;
    font-weight: 640;
    letter-spacing: -0.008em;
    color: var(--ink-3);
    white-space: nowrap;
  }
  thead th.test-col {
    text-align: start;
    padding-inline-start: 14px;
  }
  thead th.x-col {
    text-align: start;
    padding-inline: clamp(20px, 2.6vw, 40px) 14px;
  }
  thead th.who-col {
    color: var(--bar-color);
  }
  .who-head {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
  }
  .brand-logo {
    width: 20px;
    height: 20px;
    border-radius: 5px;
    object-fit: cover;
    flex: none;
  }
  [data-browser="ardia"] .brand-logo {
    outline: 1px solid rgb(22 19 15 / 0.12);
    outline-offset: -1px;
  }
  .dot {
    display: inline-block;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--bar-color);
  }
  tbody th {
    text-align: start;
  }
  tbody tr.g th {
    padding-block: 26px 8px;
    padding-inline-start: 14px;
    color: var(--ink-3);
    font-size: 0.7rem;
  }
  tbody tr.g:first-child th {
    padding-block-start: 16px;
  }
  tr.r > * {
    padding-block: 12px;
    border-bottom: 1px solid rgb(22 19 15 / 0.06);
    transition:
      background-color 120ms ease,
      border-color 120ms ease;
  }
  tr.r:last-child > * {
    border-bottom: 0;
  }
  @media (hover: hover) {
    tbody tr.r:not(.head):hover > * {
      background: rgb(22 19 15 / 0.036);
      border-bottom-color: transparent;
    }
    tbody tr.r:has(+ tr.r:not(.head):hover) > * {
      border-bottom-color: transparent;
    }
    tbody tr.r:not(.head):hover > :first-child {
      border-start-start-radius: 10px;
      border-end-start-radius: 10px;
    }
    tbody tr.r:not(.head):hover > :last-child {
      border-start-end-radius: 10px;
      border-end-end-radius: 10px;
    }
  }
  tr.r th {
    font-size: 0.95rem;
    font-weight: 540;
    letter-spacing: -0.01em;
    color: var(--ink);
    padding-inline: 14px 16px;
  }
  tr.r.sub th {
    font-weight: 440;
    color: var(--ink-2);
    padding-inline-start: 30px;
  }
  tr.r.head > * {
    padding-block: 16px 4px;
    border-bottom: 0;
  }
  tr.r.head .unit {
    font-weight: 440;
    color: var(--ink-2);
  }
  .m-callout {
    display: none;
  }

  td.n {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    color: var(--ink-2);
    white-space: nowrap;
    padding-inline-start: 10px;
  }
  td.n .val {
    display: inline-block;
    padding: 4px 8px;
    margin-inline-end: -8px;
    border-radius: 7px;
    text-box: trim-both cap alphabetic;
  }
  td.n.us {
    color: var(--bar-color);
    font-weight: 660;
  }
  td.n.best .val {
    background: color-mix(in oklch, var(--bar-color) 11%, transparent);
    color: var(--bar-color);
    font-weight: 700;
  }
  td.n.none {
    color: var(--ink-3);
  }
  td.x {
    text-align: start;
    padding-inline: clamp(20px, 2.6vw, 40px) 14px;
    color: var(--ink-2);
    font-size: 0.9rem;
    line-height: 1.3;
  }
  td.x b {
    color: var(--ink);
    font-weight: 700;
    font-size: 0.98rem;
    margin-inline-end: 0.16em;
  }

  .colophon {
    display: grid;
    gap: 8px;
    max-width: 44em;
    margin-top: clamp(28px, 3.6vw, 44px);
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .colophon-title {
    color: var(--ink);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 4px;
  }
  .colophon .link {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--ink);
    font-weight: 620;
  }
  .colophon .link::after {
    content: " →";
  }

  @media (max-width: 860px) {
    .stat-strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }
    .stat-tile {
      padding: 14px 12px;
      border-radius: 16px;
    }
    .stat-label {
      font-size: 0.74rem;
    }
    .stat-figure {
      font-size: clamp(1.55rem, 6.2vw, 2.1rem);
    }
    .stat-detail {
      font-size: 0.74rem;
      line-height: 1.25;
    }
    .stat-compare {
      font-size: 0.7rem;
      margin-top: 3px;
    }

    .sheet-card {
      padding: 16px 8px;
      border-radius: 18px;
    }
    col.t {
      width: 40%;
    }
    col.n {
      width: 20%;
    }
    col.x,
    thead th.x-col,
    td.x {
      display: none;
    }
    thead th {
      padding-block: 0 11px;
      font-size: 0.78rem;
      vertical-align: bottom;
    }
    thead th.test-col {
      padding-inline-start: 10px;
    }
    thead th.who-col:nth-last-child(2) {
      padding-inline-end: 10px;
    }
    tbody tr.g th {
      padding-block: 22px 6px;
      padding-inline-start: 10px;
    }
    tbody tr.g:first-child th {
      padding-block-start: 14px;
    }
    tr.r > * {
      padding-block: 11px;
      vertical-align: middle;
    }
    tr.r > :nth-last-child(2) {
      padding-inline-end: 10px;
    }
    @media (hover: hover) {
      tbody tr.r:not(.head):hover > :nth-last-child(2) {
        border-start-end-radius: 10px;
        border-end-end-radius: 10px;
      }
    }
    tr.r th {
      font-size: 0.9rem;
      line-height: 1.28;
      padding-inline: 10px 8px;
      text-wrap: pretty;
    }
    tr.r.sub th {
      padding-inline-start: 22px;
    }
    .m-callout {
      display: block;
      margin-top: 3px;
      font-size: 0.76rem;
      font-weight: 460;
      color: var(--ink-2);
      line-height: 1.25;
    }
    .m-callout b {
      color: var(--bar-ardia);
      font-weight: 700;
    }
    td.n {
      font-size: 0.88rem;
      padding-inline-start: 6px;
    }
    td.n .val {
      padding: 4px 7px;
      margin-inline-end: -7px;
      border-radius: 7px;
    }
  }
  @media (max-width: 520px) {
    .sheet-card {
      padding: 16px 6px;
    }
    col.t {
      width: 31%;
    }
    col.n {
      width: 23%;
    }
    thead th {
      padding-block: 0 10px;
      font-size: 0.72rem;
    }
    thead th.test-col {
      padding-inline-start: 8px;
    }
    thead th.who-col:nth-last-child(2) {
      padding-inline-end: 8px;
    }
    .dot {
      width: 6px;
      height: 6px;
    }
    .who-head {
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }
    .brand-logo {
      width: 20px;
      height: 20px;
      border-radius: 5px;
    }
    tbody tr.g th {
      padding-block: 20px 6px;
      padding-inline-start: 8px;
    }
    tbody tr.g:first-child th {
      padding-block-start: 12px;
    }
    tr.r > * {
      padding-block: 10px;
    }
    tr.r > :nth-last-child(2) {
      padding-inline-end: 8px;
    }
    tr.r th {
      font-size: 0.82rem;
      padding-inline: 8px 6px;
    }
    tr.r.sub th {
      padding-inline-start: 18px;
    }
    .m-callout {
      font-size: 0.7rem;
    }
    td.n {
      font-size: 0.76rem;
      padding-inline-start: 4px;
    }
    td.n .val {
      padding: 3px 5px;
      margin-inline-end: -5px;
      border-radius: 6px;
    }
  }
  @media (max-width: 360px) {
    .stat-strip {
      gap: 6px;
    }
    .stat-tile {
      padding: 12px 8px;
    }
    .stat-label {
      font-size: 0.68rem;
      white-space: nowrap;
    }
    .stat-figure {
      font-size: 1.45rem;
    }
    .stat-detail,
    .stat-compare {
      font-size: 0.68rem;
    }
    .sheet-card {
      padding: 14px 4px;
    }
    col.t {
      width: 31%;
    }
    col.n {
      width: 23%;
    }
    thead th {
      font-size: 0.66rem;
    }
    thead th.test-col,
    tbody tr.g th {
      padding-inline-start: 6px;
    }
    thead th.who-col:nth-last-child(2),
    tr.r > :nth-last-child(2) {
      padding-inline-end: 6px;
    }
    tr.r th {
      font-size: 0.72rem;
      padding-inline: 6px 4px;
    }
    td.n {
      font-size: 0.63rem;
      padding-inline-start: 2px;
    }
    td.n .val {
      padding: 2px 3px;
      margin-inline-end: -3px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    tr.r > * {
      transition: none;
    }
  }
</style>
