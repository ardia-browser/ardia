export type RelayEntry = { mtime: number; size: number };
export type RelaySide = Record<string, RelayEntry>;
export type RelayRecord = Record<string, { mac?: RelayEntry; phone?: RelayEntry }>;
export type RelayStep = { kind: "toPhone" | "toMac" | "deleteOnMac" | "deleteOnPhone"; file: string };
export function plan(mac: RelaySide, phone: RelaySide, record: RelayRecord): RelayStep[];
export function nextRecord(record: RelayRecord, before: { mac: RelaySide; phone: RelaySide }, after: { mac: RelaySide; phone: RelaySide }, planned: RelayStep[], done: RelayStep[]): RelayRecord;
export function parseListing(out: string, options?: { withProbe?: boolean }): RelaySide;
export const LISTED: string;
export const LIST_STAT_SCRIPT: string;
export function listed(out: string, where: string, options?: { withProbe?: boolean }): RelaySide;
export const PHRASE_SCRIPT: string;
export function typePhrase(opts: RelayOptions): string;
export function quoted(text: string): string;
export function emptySide(before: { mac: RelaySide; phone: RelaySide }, record: RelayRecord): "mac" | "phone" | null;
export type RelayCommand = [string, string[]];
export type RelaySideAccess = { folder: string; shell: (command: string) => RelayCommand; write: (part: string) => RelayCommand; read: (file: string) => RelayCommand };
export type RelayOptions = { mac: string; phoneFolder: string; work: string; adb: string; serial?: string };
export type RelaySummary = { at: string; mac: number; phone: number; steps: RelayStep[]; failed: (RelayStep & { error: string })[] };
export const COMMITTED: string;
export function partsFolder(folder: string): string;
export function commitCommand(part: string, target: string, sha256: string): string;
export const COMMIT_TRIES: number;
export const COMMIT_WAIT_MS: number;
export function copyInto(side: RelaySideAccess, from: RelayCommand, target: string): Promise<{ sha256: string; bytes: number; attempts: number }>;
export function probePhone(opts: RelayOptions): Promise<void>;
export function pass(opts: RelayOptions): Promise<RelaySummary>;
