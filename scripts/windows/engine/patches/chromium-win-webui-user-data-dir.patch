+std::wstring FinalPathOfHandle(HANDLE handle, DWORD volume) {
+  const DWORD flags = volume | FILE_NAME_NORMALIZED;
+  std::wstring path;
+  const DWORD size = ::GetFinalPathNameByHandleW(handle, nullptr, 0, flags);
+  if (size == 0)
+    return path;
+  path.resize(size);
+  const DWORD written =
+      ::GetFinalPathNameByHandleW(handle, &path[0], size, flags);
+  path.resize(written > 0 && written < size ? written : 0);
+  while (!path.empty() && path.back() == L'\\')
+    path.pop_back();
+  return path;
+}
+
+std::wstring ResolvedFolder(std::wstring path) {
+  std::wstring rest;
+  while (!path.empty() &&
+         ::GetFileAttributesW(path.c_str()) == INVALID_FILE_ATTRIBUTES) {
+    const size_t slash = path.find_last_of(L'\\');
+    if (slash == std::wstring::npos)
+      return std::wstring();
+    rest = path.substr(slash) + rest;
+    path.resize(slash);
+  }
+  if (path.empty())
+    return std::wstring();
+  HANDLE handle = ::CreateFileW(
+      path.c_str(), 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+      nullptr, OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+  if (handle == INVALID_HANDLE_VALUE)
+    return std::wstring();
+  const std::wstring resolved = FinalPathOfHandle(handle, VOLUME_NAME_GUID);
+  ::CloseHandle(handle);
+  return resolved.empty() ? resolved : resolved + rest;
+}
+
+bool WithinOrSameFolder(const std::wstring& inner, const std::wstring& outer) {
+  if (outer.empty() || inner.size() < outer.size() ||
+      ::CompareStringOrdinal(inner.c_str(), static_cast<int>(outer.size()),
+                             outer.c_str(), static_cast<int>(outer.size()),
+                             TRUE) != CSTR_EQUAL) {
+    return false;
+  }
+  return inner.size() == outer.size() || inner[outer.size()] == L'\\';
+}
+
+std::wstring WithTrailingSlash(std::wstring path) {
+  if (!path.empty() && path.back() != L'\\')
+    path.push_back(L'\\');
+  return path;
+}
+
+std::vector<std::wstring> ReactNativeFolders() {
+  std::vector<std::wstring> folders;
+  for (const wchar_t* variable : {L"LOCALAPPDATA", L"APPDATA"}) {
+    const std::wstring base = GetEnvironmentString(variable);
+    if (base.empty())
+      continue;
+    const std::wstring root = WithTrailingSlash(base) + L"Ardia";
+    folders.push_back(ResolvedFolder(root));
+    folders.push_back(ResolvedFolder(root + L"\\User Data"));
+  }
+  return folders;
+}
+
+bool JoinsReactNativeFolders(const std::wstring& folder) {
+  const std::wstring mine = ResolvedFolder(folder);
+  if (mine.empty())
+    return true;
+  for (const std::wstring& theirs : ReactNativeFolders()) {
+    if (theirs.empty() || WithinOrSameFolder(mine, theirs) ||
+        WithinOrSameFolder(theirs, mine)) {
+      return true;
+    }
+  }
+  return false;
+}
