+bool ArdiaRestrictedSession(DevToolsSession* session) {
+  return g_ardia_devtools_may_input &&
+         (!session ||
+          !g_ardia_devtools_may_input(session->GetRootSession()->GetClient(),
+                                      nullptr));
+}
