{
  "name": "@ardia/browser-linux",
  "version": "0.0.0",
  "private": true,
  "description": "Ardia on Linux: the UI bundle and packaging for Ardia's own engine (Chromium with Helium's patches and ours)",
  "scripts": {
    "build": "vite build --config renderer/vite.config.ts",
    "dev": "node scripts/dev.mjs",
    "package": "pnpm build && node ../../../scripts/linux/package-engine.mjs",
    "test": "node --import ./scripts/test-hooks.mjs --test \"../../../packages/expo-linux/src/**/*.test.ts\"",
    "test:fake": "node scripts/engine-fake.mjs",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@ardia/ardiacore": "workspace:*",
    "@ardia/core": "workspace:*",
    "@ardia/expo-linux": "workspace:*",
    "@ardia/import": "workspace:*",
    "@ardia/shaders": "workspace:*",
    "@ardia/shell": "workspace:*",
    "@ardia/sync": "workspace:*",
    "@browsermt/bergamot-translator": "0.4.9",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "react-native-web": "^0.21.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.9"
  }
}
