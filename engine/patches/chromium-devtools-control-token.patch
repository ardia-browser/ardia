+void ServerWrapper::ArdiaCloseWhenFlushed(int connection_id,
+                                          base::TimeTicks deadline) {
+  const int pending = server_->ArdiaPendingWriteBytes(connection_id);
+  if (pending < 0) {
+    return;
+  }
+  if (pending == 0 || base::TimeTicks::Now() >= deadline) {
+    server_->Close(connection_id);
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&ServerWrapper::ArdiaCloseWhenFlushed,
+                     ardia_weak_factory_.GetWeakPtr(), connection_id, deadline),
+      base::Milliseconds(20));
+}
