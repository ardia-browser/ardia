#!/usr/bin/env python3
"""Usage: scripts/linux/xinput <display> <command> [args]
Real X input and pictures on an X display (an Xvfb), through XTest and XGetImage:
  click X Y [button] [mods]   press and release a button at X,Y (button 1 left, 3 right; mods like ctrl,shift)
  wheel X Y STEPS             scroll at X,Y (STEPS > 0 down, < 0 up)
  keys CHORD [CHORD...]       press key chords like ctrl+l, ctrl+q, Escape, Return
  type TEXT                   type plain ASCII text
  shot PATH [X Y W H]         save the root window (or a rectangle of it) as a PNG
  pixel X Y                   print the root window's pixel at X,Y as rrggbb"""
import ctypes
import struct
import sys
import time
import zlib

x11 = ctypes.CDLL("libX11.so.6")
xtst = ctypes.CDLL("libXtst.so.6")
x11.XOpenDisplay.restype = ctypes.c_void_p
x11.XDefaultRootWindow.restype = ctypes.c_ulong
x11.XDefaultRootWindow.argtypes = [ctypes.c_void_p]
x11.XGetImage.restype = ctypes.c_void_p
x11.XGetImage.argtypes = [ctypes.c_void_p, ctypes.c_ulong, ctypes.c_int, ctypes.c_int, ctypes.c_uint, ctypes.c_uint, ctypes.c_ulong, ctypes.c_int]
x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
x11.XStringToKeysym.restype = ctypes.c_ulong
x11.XStringToKeysym.argtypes = [ctypes.c_char_p]
x11.XGetGeometry.argtypes = [ctypes.c_void_p, ctypes.c_ulong] + [ctypes.c_void_p] * 7
x11.XFlush.argtypes = [ctypes.c_void_p]
xtst.XTestFakeMotionEvent.argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_ulong]
xtst.XTestFakeButtonEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
xtst.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]


class XImage(ctypes.Structure):
    _fields_ = [("width", ctypes.c_int), ("height", ctypes.c_int), ("xoffset", ctypes.c_int), ("format", ctypes.c_int),
                ("data", ctypes.POINTER(ctypes.c_ubyte)), ("byte_order", ctypes.c_int), ("bitmap_unit", ctypes.c_int),
                ("bitmap_bit_order", ctypes.c_int), ("bitmap_pad", ctypes.c_int), ("depth", ctypes.c_int),
                ("bytes_per_line", ctypes.c_int), ("bits_per_pixel", ctypes.c_int)]


MODIFIERS = {"ctrl": "Control_L", "control": "Control_L", "shift": "Shift_L", "alt": "Alt_L", "super": "Super_L"}
ALL_PLANES = 0xFFFFFFFF
Z_PIXMAP = 2


def keycode(display, name):
    symbol = x11.XStringToKeysym(name.encode())
    if not symbol and len(name) == 1:
        symbol = ord(name)
    code = x11.XKeysymToKeycode(display, symbol)
    if not code:
        sys.exit(f"xinput: no key for {name}")
    return code


def flush(display, pause=0.03):
    x11.XFlush(display)
    time.sleep(pause)


def move(display, x, y):
    xtst.XTestFakeMotionEvent(display, -1, int(float(x)), int(float(y)), 0)
    flush(display, 0.08)


def chord(display, text):
    parts = text.split("+")
    codes = [keycode(display, MODIFIERS.get(part.lower(), part)) for part in parts]
    for code in codes:
        xtst.XTestFakeKeyEvent(display, code, True, 0)
        flush(display, 0.02)
    for code in reversed(codes):
        xtst.XTestFakeKeyEvent(display, code, False, 0)
        flush(display, 0.02)


def grab(display, x=0, y=0, width=0, height=0):
    root = x11.XDefaultRootWindow(display)
    if not width or not height:
        sizes = [ctypes.c_uint() for _ in range(4)]
        ignored_root = ctypes.c_ulong()
        ignored_x, ignored_y = ctypes.c_int(), ctypes.c_int()
        x11.XGetGeometry(display, root, ctypes.byref(ignored_root), ctypes.byref(ignored_x), ctypes.byref(ignored_y),
                         ctypes.byref(sizes[0]), ctypes.byref(sizes[1]), ctypes.byref(sizes[2]), ctypes.byref(sizes[3]))
        width, height = sizes[0].value, sizes[1].value
    pointer = x11.XGetImage(display, root, x, y, width, height, ALL_PLANES, Z_PIXMAP)
    if not pointer:
        sys.exit("xinput: XGetImage failed")
    image = ctypes.cast(pointer, ctypes.POINTER(XImage)).contents
    if image.bits_per_pixel != 32:
        sys.exit(f"xinput: {image.bits_per_pixel} bits per pixel isn't supported")
    raw = ctypes.string_at(image.data, image.bytes_per_line * image.height)
    rows = []
    for row in range(image.height):
        line = raw[row * image.bytes_per_line: row * image.bytes_per_line + image.width * 4]
        rgb = bytearray(image.width * 3)
        rgb[0::3] = line[2::4]
        rgb[1::3] = line[1::4]
        rgb[2::3] = line[0::4]
        rows.append(bytes(rgb))
    return image.width, image.height, rows


def png(path, width, height, rows):
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
    body = zlib.compress(b"".join(b"\x00" + row for row in rows), 6)
    with open(path, "wb") as out:
        out.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)) +
                  chunk(b"IDAT", body) + chunk(b"IEND", b""))


def main():
    if len(sys.argv) < 3 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        sys.exit(0 if len(sys.argv) > 1 else 2)
    name, command, args = sys.argv[1], sys.argv[2], sys.argv[3:]
    display = x11.XOpenDisplay(name.encode())
    if not display:
        sys.exit(f"xinput: can't open display {name}")
    display = ctypes.c_void_p(display)
    if command == "click":
        x, y = args[0], args[1]
        button = int(args[2]) if len(args) > 2 and args[2] else 1
        modifiers = [m for m in (args[3].split(",") if len(args) > 3 else []) if m]
        move(display, x, y)
        codes = [keycode(display, MODIFIERS[m]) for m in modifiers]
        for code in codes:
            xtst.XTestFakeKeyEvent(display, code, True, 0)
        flush(display)
        xtst.XTestFakeButtonEvent(display, button, True, 0)
        flush(display, 0.08)
        xtst.XTestFakeButtonEvent(display, button, False, 0)
        flush(display)
        for code in reversed(codes):
            xtst.XTestFakeKeyEvent(display, code, False, 0)
        flush(display)
    elif command == "wheel":
        move(display, args[0], args[1])
        steps = int(args[2])
        button = 5 if steps > 0 else 4
        for _ in range(abs(steps)):
            xtst.XTestFakeButtonEvent(display, button, True, 0)
            xtst.XTestFakeButtonEvent(display, button, False, 0)
            flush(display, 0.04)
    elif command == "keys":
        for text in args:
            chord(display, text)
    elif command == "type":
        for character in args[0]:
            chord(display, "space" if character == " " else ("shift+" + character.lower() if character.isupper() else character))
    elif command == "shot":
        rect = [int(float(value)) for value in args[1:5]] if len(args) >= 5 else [0, 0, 0, 0]
        width, height, rows = grab(display, *rect)
        png(args[0], width, height, rows)
        print(args[0])
    elif command == "pixel":
        _, _, rows = grab(display, int(float(args[0])), int(float(args[1])), 1, 1)
        print(rows[0].hex())
    else:
        sys.exit(f"xinput: unknown command {command}")


main()
