{
  "manifest_version": 3,
  "name": "Ardia protected video",
  "version": "1.0",
  "key": "",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.netflix.com/*",
    "https://www.youtube.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "safari",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
