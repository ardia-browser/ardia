+void PasswordStore::UpdateLoginsIfPasswordIs(
+    std::vector<StoredCredential> forms,
+    std::u16string expected,
+    base::OnceCallback<void(bool)> completion) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  if (!backend_) {
+    std::move(completion).Run(false);
+    return;
+  }
+  if (post_init_callback_) {
+    post_init_callback_ =
+        std::move(post_init_callback_)
+            .Then(base::BindOnce(&PasswordStore::UpdateLoginsIfPasswordIs,
+                                 this, std::move(forms), std::move(expected),
+                                 std::move(completion)));
+    return;
+  }
+  backend_->UpdateLoginsIfPasswordIsAsync(
+      std::move(forms), std::move(expected),
+      base::BindOnce(&PasswordStore::OnConditionalWrite, this,
+                     LoginsChangedTrigger::Update, std::move(completion)));
+}
+
+void PasswordStore::AddLoginIfAbsent(
