+bool InspectorDOMAgent::ArdiaOwnsNode(Node* node) const {
+  if (!ardia_owned_backend_nodes_only_) {
+    return true;
+  }
+  Document& document = node->GetDocument();
+  LocalFrame* frame = document.GetFrame();
+  if (!frame) {
+    if (auto* window = DynamicTo<LocalDOMWindow>(document.GetExecutionContext())) {
+      frame = window->GetFrame();
+    }
+  }
+  return frame && inspected_frames_->Contains(frame);
+}
