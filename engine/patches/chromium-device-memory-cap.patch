navigator.deviceMemory and the Device-Memory and Sec-CH-Device-Memory client hints top out at 8 GB again, Chrome's
limit before crbug.com/454354290 raised it to 32 on desktop: EFF's Cover Your Tracks (2026-11-20) gives 2.7 bits for
8 against 3.9 for 32. Nothing else in Chrome reads the value (memory pressure only calls Initialize), so no behaviour
changes with it; 2 GB stays the floor and Android keeps its 1 to 8. The two tests that expect 32 on desktop expect 8.
It applies whatever Helium's noise switches say.

diff --git a/third_party/blink/common/device_memory/approximated_device_memory.cc b/third_party/blink/common/device_memory/approximated_device_memory.cc
--- a/third_party/blink/common/device_memory/approximated_device_memory.cc
+++ b/third_party/blink/common/device_memory/approximated_device_memory.cc
@@ -59,7 +59,7 @@ void ApproximatedDeviceMemory::CalculateAndSetApproximatedDeviceMemory() {
   // Limit the values to reduce fingerprintability.
   // See: https://crbug.com/454354290 for updated limits.
   float kMinMemory = 2.0f;
-  float kMaxMemory = 32.0f;
+  float kMaxMemory = 8.0f;
 
 #if BUILDFLAG(IS_ANDROID)
     // Allow smaller lower limits on Android where lower RAM is still common.
diff --git a/third_party/blink/common/device_memory/approximated_device_memory_unittest.cc b/third_party/blink/common/device_memory/approximated_device_memory_unittest.cc
--- a/third_party/blink/common/device_memory/approximated_device_memory_unittest.cc
+++ b/third_party/blink/common/device_memory/approximated_device_memory_unittest.cc
@@ -75,11 +75,11 @@ TEST_F(ApproximatedDeviceMemoryTest, GetApproximatedDeviceMemory) {
   EXPECT_EQ(8, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
 #else
   ApproximatedDeviceMemory::SetPhysicalMemoryMBForTesting(16384);  // 16GB
-  EXPECT_EQ(16, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
+  EXPECT_EQ(8, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
   ApproximatedDeviceMemory::SetPhysicalMemoryMBForTesting(32768);  // 32GB
-  EXPECT_EQ(32, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
+  EXPECT_EQ(8, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
   ApproximatedDeviceMemory::SetPhysicalMemoryMBForTesting(64385);  // <64GB
-  EXPECT_EQ(32, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
+  EXPECT_EQ(8, ApproximatedDeviceMemory::GetApproximatedDeviceMemory());
 #endif
 }
 
diff --git a/third_party/blink/renderer/core/loader/frame_fetch_context_test.cc b/third_party/blink/renderer/core/loader/frame_fetch_context_test.cc
--- a/third_party/blink/renderer/core/loader/frame_fetch_context_test.cc
