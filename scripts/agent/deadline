#!/bin/bash
# Run a command with a deadline, and stop every process it started when it ends, times out or is interrupted.
#
#   scripts/agent/deadline [--timeout SECS] -- <command…>
#   scripts/agent/deadline -h | --help
#
# Use it instead of `timeout` for anything that starts helpers: `timeout swift test` stops only swift, and its
# swiftpm-testing-helper and test bundle keep running (three of them sat idle for six hours in #4751, holding the
# scratch path). The command runs as the leader of its own process group; at the deadline (default 540 s, under the
# Bash tool's 600 s limit) the whole group gets TERM, then KILL 3 s later, and so does whatever of the group is still
# alive when the command exits or this script is interrupted. Exits with the command's status, or 124 at the deadline.
#
#   scripts/agent/deadline -- swift test --package-path packages/phone/ios/ArdiaKit --scratch-path /tmp/me-ardiakit
#   scripts/agent/deadline --timeout 300 -- xcodebuild test …
set -uo pipefail

help() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
}

timeout=540
while [[ $# -gt 0 && "$1" != "--" ]]; do
  case "$1" in
    -h | --help) help ;;
    --timeout)
      [[ $# -ge 2 && "$2" =~ ^[1-9][0-9]{0,5}$ ]] || { echo "deadline: --timeout needs a whole number of seconds" >&2; exit 64; }
      timeout="$2"; shift 2 ;;
    *) echo "deadline: unknown option $1" >&2; exit 64 ;;
  esac
done
[[ "${1:-}" == "--" ]] && shift
[[ $# -gt 0 ]] || { echo "deadline: no command; see --help" >&2; exit 64; }

flag="$(mktemp "${TMPDIR:-/tmp}/deadline.XXXXXX")"
rm -f "$flag"
perl -e 'setpgrp(0, 0); exec { $ARGV[0] } @ARGV or do { print STDERR "deadline: can'"'"'t run $ARGV[0]: $!\n"; exit 127 }' "$@" &
leader=$!
perl -e 'my ($wait, $group, $flag) = @ARGV; sleep $wait; exit 0 unless kill 0, -$group; open my $f, ">", $flag; close $f; kill "TERM", -$group; sleep 3; kill "KILL", -$group' "$timeout" "$leader" "$flag" &
watcher=$!

finish() {
  kill "$watcher" 2> /dev/null
  if kill -0 -- "-$leader" 2> /dev/null; then
    kill -TERM -- "-$leader" 2> /dev/null
    for _ in 1 2 3 4 5 6; do kill -0 -- "-$leader" 2> /dev/null || break; sleep 0.5; done
    kill -KILL -- "-$leader" 2> /dev/null
  fi
}
trap 'finish; rm -f "$flag"; exit 130' INT TERM HUP

wait "$leader"
status=$?
finish
if [[ -e "$flag" ]]; then
  echo "deadline: stopped $1 and everything it started at the $timeout s deadline" >&2
  status=124
fi
rm -f "$flag"
exit "$status"
