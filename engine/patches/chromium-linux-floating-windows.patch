+const char* (*g_ardia_linux_window_class)(const BrowserWindowInterface*) =
+    nullptr;
+bool (*g_ardia_linux_pins_window_size)(const BrowserWindowInterface*) =
+    nullptr;
+
+namespace {
+
+bool ArdiaLinuxPinsWindowSize(const BrowserView* browser_view) {
+  return g_ardia_linux_pins_window_size && browser_view &&
+         g_ardia_linux_pins_window_size(browser_view->browser());
+}
