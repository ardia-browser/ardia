#!/usr/bin/env node
// A hidden test instance with one plugin installed, approved and on (docs/plugins.md › Testing).
//
//   scripts/agent/plugin-instance launch <plugin folder> [--data DIR] [--shared DIR] [--app APP] [--link]
//                                 [--open [PATH]] [--fresh] [--test K[=V]]… [--instance K=V]… [--env K=V]…
//   scripts/agent/plugin-instance install <plugin folder> --data DIR [--link]   copy it in again (Ardia rescans)
//   scripts/agent/plugin-instance open  <data dir> [PATH]                      open ardia://<plugin><PATH> in a tab
//   scripts/agent/plugin-instance eval  <data dir> '<body>' [--plugin NAME]    run an async function body in the page
//   scripts/agent/plugin-instance app   <data dir> '<body>'                    the dev harness (as `ac eval`)
//   scripts/agent/plugin-instance shot  <data dir> <file.png> [--plugin NAME] [--bare]  in-process snapshot of the page
//   scripts/agent/plugin-instance state <data dir>                             the plugin's record, process and grants
//   scripts/agent/plugin-instance quit  <data dir>
//
// launch copies the folder (without node_modules and .git; --link symlinks it instead, so edits show at once) to
// <data>/config/plugins/<name>, starts a hidden instance (scripts/agent/ac) with ARDIA_TEST pluginApprove=<name>,
// appDialog and appMenu and ARDIA_INSTANCE sharedFolders=<shared>, waits until the plugin is on, and prints the pid,
// the DevTools port, the data dir, the shared folder and the commands to drive it. Defaults: the app is
// apps/browser/build-home's Debug build, the data dir /tmp/ardia-pi-<name>, the shared folder <data>-shared.
// Confirms (folders.create) take their answer from <data>/dialog.json.pick, folder and file panels from
// <data>/file-chooser.txt. eval needs a Debug build; NAME defaults to the plugin launch installed.
import { cpSync, existsSync, lstatSync, mkdirSync, readFileSync, rmSync, symlinkSync, writeFileSync } from "node:fs";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const here = dirname(fileURLToPath(import.meta.url));
const repo = resolve(here, "../..");
const { attach, launch, sleep } = await import(join(repo, "scripts/lib/instance.mjs"));

const argv = process.argv.slice(2);
const help = () => {
  const lines = readFileSync(fileURLToPath(import.meta.url), "utf8").split("\n").slice(1);
  console.log(lines.slice(0, lines.findIndex((l) => !l.startsWith("//"))).map((l) => l.replace(/^\/\/ ?/, "")).join("\n"));
};
if (!argv.length || argv.includes("-h") || argv.includes("--help")) {
  help();
  process.exit(argv.length ? 0 : 64);
}

const [command, ...rest] = argv;
const flags = {};
const positional = [];
for (let i = 0; i < rest.length; i++) {
  const a = rest[i];
  if (!a.startsWith("--")) positional.push(a);
  else if (["--link", "--fresh", "--bare"].includes(a)) flags[a.slice(2)] = true;
  else if (a === "--open") flags.open = rest[i + 1] && !rest[i + 1].startsWith("--") && rest[i + 1].startsWith("/") ? rest[++i] : "";
  else if (["--test", "--instance", "--env"].includes(a)) (flags[a.slice(2)] ??= []).push(rest[++i]);
  else flags[a.slice(2)] = rest[++i];
}

const pairs = (list) => Object.fromEntries((list ?? []).map((kv) => (kv.includes("=") ? [kv.slice(0, kv.indexOf("=")), kv.slice(kv.indexOf("=") + 1)] : [kv, true])));
const input = (s) => (s === "-" ? readFileSync(0, "utf8") : s);
const print = (v) => console.log(typeof v === "string" ? v : JSON.stringify(v, null, 2));
const metaFile = (data) => join(data, "plugin-instance.json");
const metaOf = (data) => {
  try {
    return JSON.parse(readFileSync(metaFile(data), "utf8"));
  } catch {
    return {};
  }
};

function manifestName(folder) {
  const text = readFileSync(join(folder, "plugin.json"), "utf8");
  const name = JSON.parse(text).name;
  if (typeof name !== "string" || !/^[a-z0-9][a-z0-9-]{0,39}$/.test(name)) throw new Error(`${folder}/plugin.json has no valid name`);
  return name;
}

function install(folder, data, link) {
  folder = resolve(folder);
  const name = manifestName(folder);
  const plugins = join(data, "config", "plugins");
  const target = join(plugins, name);
  mkdirSync(plugins, { recursive: true });
  let existing = null;
  try {
    existing = lstatSync(target);
  } catch {}
  if (existing) rmSync(target, { recursive: true, force: true });
  if (link) symlinkSync(folder, target);
  else cpSync(folder, target, { recursive: true, filter: (src) => !["node_modules", ".git"].includes(basename(src)) });
  return name;
}

const harness = (data) => {
  try {
    return attach(data);
  } catch (e) {
    console.error(e.message);
    process.exit(e.gone ? 3 : 1);
  }
};

const STATE = (name) => `const p = ac.plugins; if (!p) throw new Error("plugin seams need a Debug build");
  const s = p.usePlugins.getState();
  const record = s.records[${JSON.stringify(name)}] ?? null;
  const listing = s.listings[${JSON.stringify(name)}] ?? null;
  return { listed: !!listing, problems: listing?.problems ?? [], enabled: !!record?.enabled, approved: !!record && record.approved === listing?.hash,
    process: s.processes[${JSON.stringify(name)}]?.state ?? null, folders: record?.folders ?? {}, consent: s.consent?.name ?? null };`;

const APPROVE = (name) => `const p = ac.plugins; const s = p.usePlugins.getState(); const l = s.listings[${JSON.stringify(name)}];
  if (!l?.hash || s.consent) return false; return p.requestPluginConsent(${JSON.stringify(name)}) && p.enablePlugin(${JSON.stringify(name)}, l.hash);`;

async function waitOn(app, name, seconds = 60) {
  const end = Date.now() + seconds * 1000;
  const byHand = Date.now() + 3000;
  let last = null;
  while (Date.now() < end) {
    last = await app.eval(STATE(name), { timeout: 5000 }).catch((e) => ({ error: e.message }));
    if (last?.problems?.length) throw new Error(`${name} has problems: ${last.problems.join("; ")}`);
    if (last?.enabled && last.approved) return last;
    if (last?.listed && Date.now() > byHand) await app.eval(APPROVE(name), { timeout: 5000 }).catch(() => false);
    await sleep(250);
  }
  throw new Error(`${name} wasn't on within ${seconds} s; last state: ${JSON.stringify(last)}`);
}

const OPEN = (name, path) => `const p = ac.plugins; const s = ac.store.getState(); const w = s.windowOrder[0];
  if (!w) throw new Error("no window"); const tab = p.openPluginPage(w, ${JSON.stringify(name)}, { path: ${JSON.stringify(path)} });
  if (!tab) throw new Error("the page didn't open (is it a plugin with a tab panel, and on?)"); return { tab, window: w };`;

const pluginOf = (data) => flags.plugin ?? metaOf(data).plugin;

try {
  if (command === "launch") {
    if (!positional[0]) throw new Error("usage: plugin-instance launch <plugin folder> [--data DIR] …");
    const folder = resolve(positional[0]);
    const name = manifestName(folder);
    const data = resolve(flags.data ?? `/tmp/ardia-pi-${name}`);
    const shared = resolve(flags.shared ?? `${data}-shared`);
    const app = resolve(flags.app ?? join(repo, "apps/browser/build-home/Build/Products/Debug/Ardia.app"));
    if (!existsSync(app)) throw new Error(`no app at ${app}; build one or pass --app`);
    if (flags.fresh) {
      rmSync(data, { recursive: true, force: true });
      rmSync(shared, { recursive: true, force: true });
    }
    mkdirSync(data, { recursive: true });
    mkdirSync(shared, { recursive: true });
    install(folder, data, flags.link);
    writeFileSync(metaFile(data), JSON.stringify({ plugin: name, folder, shared, link: !!flags.link }));
    const test = { appDialog: true, appMenu: true, ...pairs(flags.test) };
    test.pluginApprove = [name, test.pluginApprove].filter((v) => typeof v === "string").join(",");
    const instance = await launch(app, { data, onboarded: true, instance: { sharedFolders: shared, ...pairs(flags.instance) }, test, env: pairs(flags.env) });
    const state = await waitOn(instance, name);
    let opened = null;
    if (flags.open !== undefined) opened = await instance.eval(OPEN(name, flags.open));
    const self = "scripts/agent/plugin-instance";
    print([
      `pid ${instance.pid} port ${instance.port} data ${data} shared ${shared} log ${instance.log}`,
      `plugin ${name} on (process ${state.process ?? "not started"})${opened ? `, page open in tab ${opened.tab}` : ""}`,
      `open:   ${self} open ${data} /some/path`,
      `eval:   ${self} eval ${data} 'return document.title'`,
      `shot:   ${self} shot ${data} /tmp/page.png`,
      `quit:   ${self} quit ${data}`,
    ].join("\n"));
  } else if (command === "install") {
    const data = resolve(flags.data ?? "");
    if (!positional[0] || !flags.data) throw new Error("usage: plugin-instance install <plugin folder> --data DIR");
    const name = install(positional[0], data, flags.link ?? metaOf(data).link);
    writeFileSync(metaFile(data), JSON.stringify({ ...metaOf(data), plugin: name, folder: resolve(positional[0]) }));
    const app = harness(data);
    await app.eval("const p = ac.plugins; return p ? p.rescanPlugins(null).then(() => true) : false;");
    print(await waitOn(app, name));
  } else if (command === "open") {
    const data = resolve(positional[0] ?? "");
    print(await harness(data).eval(OPEN(pluginOf(data), positional[1] ?? "")));
  } else if (command === "eval") {
    const data = resolve(positional[0] ?? "");
    const body = input(positional[1] ?? "-");
    print(await harness(data).eval(`const p = ac.plugins; if (!p?.pageEval) throw new Error("pageEval needs a Debug build with plugin page dev hooks");
      return p.pageEval(${JSON.stringify(pluginOf(data))}, ${JSON.stringify(body)});`, { timeout: Number(flags.timeout ?? 20000) }));
  } else if (command === "app") {
    print(await harness(resolve(positional[0] ?? "")).eval(input(positional[1] ?? "-"), { timeout: Number(flags.timeout ?? 20000) }));
  } else if (command === "shot") {
    const data = resolve(positional[0] ?? "");
    const file = resolve(positional[1] ?? join(data, "plugin-page.png"));
    const plugin = JSON.stringify(pluginOf(data));
    const backdrop = "const s = document.createElement('style'); s.id = 'ardia-shot-backdrop'; s.textContent = 'html { background: var(--ardia-background-solid, Canvas) !important; }'; document.head.append(s); return true;";
    const lift = "document.getElementById('ardia-shot-backdrop')?.remove(); return true;";
    const page = (body) => (flags.bare ? "Promise.resolve(true)" : `Promise.resolve(ac.plugins.pageEval?.(${plugin}, ${JSON.stringify(body)})).catch(() => null)`);
    const ok = await harness(data).eval(`return ${page(backdrop)}
      .then(() => ac.plugins.snapshotPage(${plugin}, ${JSON.stringify(file)}))
      .then((shot) => ${page(lift)}.then(() => shot));`);
    if (!ok) throw new Error("no snapshot: is the plugin's page shown in a tab?");
    print(file);
  } else if (command === "state") {
    const data = resolve(positional[0] ?? "");
    print(await harness(data).eval(STATE(pluginOf(data))));
  } else if (command === "quit") {
    print(await harness(resolve(positional[0] ?? "")).quit({ graceful: true }));
  } else {
    help();
    process.exit(64);
  }
} catch (e) {
  console.error(e.message ?? e);
  process.exit(1);
}
process.exit(0);
