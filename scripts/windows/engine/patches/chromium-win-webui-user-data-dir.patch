+TEST(UserDataDir, ArdiaShellTokensMatchCommandLineToArgvW) {
+  for (const ShellSwitchCase& c : kShellSwitchCases) {
+    SCOPED_TRACE(base::WideToUTF8(c.command_line));
+    const std::wstring trimmed(
+        base::TrimWhitespace(std::wstring_view(c.command_line), base::TRIM_ALL));
+    if (trimmed.empty())
+      continue;
+    EXPECT_EQ(TokenizeCommandLineToArray(trimmed),
+              CommandLineToArgvWTokens(trimmed));
+  }
+}
