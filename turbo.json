{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@ardia/browser#build": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "shaders:check": {
      "inputs": [
        "ios/**/*.swift",
        "scripts/check-shaders.mjs"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "@ardia/hostapi#test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/ardiacore/src/engine/**",
        "$TURBO_ROOT$/packages/ardiacore/ios/*Module.swift",
        "$TURBO_ROOT$/engine/ardiacore-linux/src/ardia/linux/ac_linux_contract.h",
        "$TURBO_ROOT$/packages/expo-windows/src/engine/domains/forwarded.json"
      ]
    },
    "test:portable": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
