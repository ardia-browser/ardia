      "//third_party/blink/public/common",
      "//ui/accelerated_widget_mac",
      "//ui/base",
      "//ui/compositor",
      "//ui/display",
      "//ui/events:events_base",
      "//ui/gfx",
      "//ui/views",
      "//url",
    ]
    frameworks = [
      "AppKit.framework",
      "CoreServices.framework",
      "QuartzCore.framework",
      "ServiceManagement.framework",
      "UniformTypeIdentifiers.framework",
    ]
  }
}
