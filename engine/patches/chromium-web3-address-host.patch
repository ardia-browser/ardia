 namespace {
 
 template <typename CHAR>
+bool IsWeb3AddressHost(std::string_view scheme,
+                       std::optional<std::basic_string_view<CHAR>> host) {
+  if (scheme != "web3" || !host || host->size() != 42 || (*host)[0] != '0' ||
+      ((*host)[1] != 'x' && (*host)[1] != 'X')) {
+    return false;
+  }
+  for (CHAR c : host->substr(2)) {
+    if (c >= 0x80 || !IsHexChar(static_cast<unsigned char>(c))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+template <typename CHAR>
+void AppendLowercaseHost(std::basic_string_view<CHAR> host,
+                         CanonOutput* output,
+                         Component* out_host) {
+  out_host->begin = output->length();
+  for (CHAR c : host) {
+    output->push_back(
+        static_cast<char>(c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c));
+  }
+  out_host->len = output->length() - out_host->begin;
+}
