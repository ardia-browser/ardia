+void ExpectShellProfile(const wchar_t* command_line,
+                        bool react_native_app_present,
+                        bool webui) {
+  SCOPED_TRACE(base::WideToUTF8(command_line));
+  SCOPED_TRACE(react_native_app_present);
+  registry_util::RegistryOverrideManager override_manager;
+  std::wstring hklm, hkcu;
+  ASSERT_NO_FATAL_FAILURE(
+      override_manager.OverrideRegistry(HKEY_LOCAL_MACHINE, &hklm));
+  ASSERT_NO_FATAL_FAILURE(
+      override_manager.OverrideRegistry(HKEY_CURRENT_USER, &hkcu));
+  ScopedNTRegistryTestingOverride nt_hklm(nt::HKLM, hklm);
+  ScopedNTRegistryTestingOverride nt_hkcu(nt::HKCU, hkcu);
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const std::wstring local = temp.GetPath().value() + L"\\Local";
+  const std::wstring roaming = temp.GetPath().value() + L"\\Roaming";
+  ASSERT_TRUE(::CreateDirectoryW(local.c_str(), nullptr));
+  ASSERT_TRUE(::CreateDirectoryW(roaming.c_str(), nullptr));
+  base::ScopedEnvironmentVariableOverride local_app_data(
+      "LOCALAPPDATA", base::WideToUTF8(local));
+  base::ScopedEnvironmentVariableOverride app_data("APPDATA",
+                                                   base::WideToUTF8(roaming));
+  SetReactNativeAppLibraryPresentForTesting(react_native_app_present);
+  std::wstring result, invalid;
+  ASSERT_TRUE(GetUserDataDirectoryImpl(command_line, kFakeInstallConstants,
+                                       &result, &invalid));
+  EXPECT_EQ(webui, result.ends_with(L"\\Ardia WebUI\\Chromium"));
+  EXPECT_EQ(!webui, result.ends_with(kUserDataDirNameSuffix));
+  EXPECT_EQ(std::wstring(), invalid);
+}
 
