+class InputHandler::ArdiaPointerRun
+    : public base::RefCounted<InputHandler::ArdiaPointerRun> {
+ public:
+  ArdiaPointerRun(int kind,
+                  uint64_t epoch,
+                  base::WeakPtr<WebContents> contents,
+                  base::WeakPtr<InputHandler> handler,
+                  scoped_refptr<ArdiaWheelTicket> wheel_ticket,
+                  base::OnceCallback<void(std::string)> done)
+      : kind_(kind),
+        epoch_(epoch),
+        contents_(std::move(contents)),
+        handler_(std::move(handler)),
+        wheel_ticket_(std::move(wheel_ticket)),
+        done_(std::move(done)) {}
+
+  const scoped_refptr<ArdiaWheelTicket>& wheel_ticket() const {
+    return wheel_ticket_;
+  }
+
+  bool click() const {
+    return kind_ == static_cast<int>(ArdiaPointer::Kind::kClick);
+  }
+
+  bool EpochChanged() const {
+    return !contents_ || ArdiaPageEpochOf(contents_.get()) != epoch_;
+  }
+
+  void Fail(std::string error) {
+    if (done_) {
+      std::move(done_).Run(std::move(error));
+    }
+  }
+
+  void Start(std::vector<bool> presses,
+             base::WeakPtr<RenderWidgetHostImpl> widget,
+             std::optional<blink::WebMouseEvent> recovery_release) {
+    events_.clear();
+    for (bool press : presses) {
+      events_.push_back(ardia::PointerEvent{press});
+    }
+    widget_ = std::move(widget);
+    recovery_release_ = std::move(recovery_release);
+  }
+
+  void Resolve(size_t index, int state) {
+    if (index >= events_.size() ||
+        events_[index].result != ardia::PointerEventResult::kPending) {
+      return;
+    }
+    events_[index].result =
+        state == 2   ? ardia::PointerEventResult::kAcked
+        : state == 1 ? ardia::PointerEventResult::kSentUnknown
+                     : ardia::PointerEventResult::kNotSent;
+    Settle();
+  }
+
+  void Expire(size_t index) { Resolve(index, 1); }
+
+  base::RepeatingCallback<void(size_t, int)> Resolver() {
+    return base::BindRepeating(&ArdiaPointerRun::Resolve,
+                               weak_factory_.GetWeakPtr());
+  }
+
+ private:
+  friend class base::RefCounted<ArdiaPointerRun>;
+
+  ~ArdiaPointerRun() {
+    if (events_.empty()) {
+      Fail(ardia::refusal::kNotDelivered);
+      return;
+    }
+    for (ardia::PointerEvent& event : events_) {
+      if (event.result == ardia::PointerEventResult::kPending) {
+        event.result = ardia::PointerEventResult::kSentUnknown;
+      }
+    }
+    Settle();
+  }
+
+  bool MayRecover() {
+    return !EpochChanged() && handler_ && handler_->session() && widget_ &&
+           ArdiaMayInject(handler_->session(), handler_->host_, widget_.get());
+  }
+
+  void Settle() {
+    if (!done_ || events_.empty()) {
+      return;
+    }
+    const ardia::PointerOutcome outcome = ardia::PointerOutcomeOf(
+        events_, !EpochChanged(), static_cast<bool>(widget_));
+    if (outcome == ardia::PointerOutcome::kPending) {
+      return;
+    }
+    if (ardia::NeedsRecoveryRelease(events_, outcome) && recovery_release_ &&
+        MayRecover()) {
+      widget_->ForwardMouseEventWithLatencyInfo(*recovery_release_,
+                                                ui::LatencyInfo());
+    }
+    switch (outcome) {
+      case ardia::PointerOutcome::kDone:
+        std::move(done_).Run(std::string());
+        return;
+      case ardia::PointerOutcome::kNotDelivered:
+        std::move(done_).Run(ardia::refusal::kNotDelivered);
+        return;
+      default:
+        std::move(done_).Run(ardia::refusal::kOutcomeUnknown);
+        return;
+    }
+  }
+
+  const int kind_;
+  const uint64_t epoch_;
+  base::WeakPtr<WebContents> contents_;
+  base::WeakPtr<InputHandler> handler_;
+  scoped_refptr<ArdiaWheelTicket> wheel_ticket_;
+  base::OnceCallback<void(std::string)> done_;
+  std::vector<ardia::PointerEvent> events_;
+  base::WeakPtr<RenderWidgetHostImpl> widget_;
+  std::optional<blink::WebMouseEvent> recovery_release_;
+  base::WeakPtrFactory<ArdiaPointerRun> weak_factory_{this};
+};
