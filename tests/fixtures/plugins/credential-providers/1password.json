{
  "$schema": "https://raw.githubusercontent.com/ardia-browser/ardia/main/docs/plugin.schema.json",
  "manifest": 2,
  "name": "1password",
  "title": "1Password",
  "description": "Fills and saves logins and codes from 1Password, approved in the 1Password app.",
  "version": "1.0.0",
  "requires": "1.40.0",
  "official": true,
  "keywords": [
    "1password",
    "agilebits",
    "passwords"
  ],
  "main": "dist/main.js",
  "memoryMB": 1024,
  "contributes": {
    "credentialProvider": {
      "title": "1Password",
      "symbol": "key.horizontal.fill",
      "accent": "#0572EC",
      "readsOffline": true,
      "approvalLastsSeconds": 600,
      "capabilities": [
        "totp",
        "save",
        "edit",
        "addTotp",
        "touchID"
      ],
      "signIn": {
        "methods": [
          {
            "id": "app",
            "title": "1Password App",
            "kind": "desktopApproval",
            "appURL": "onepassword://",
            "appTitle": "1Password"
          }
        ]
      },
      "cli": {
        "name": "op",
        "install": {
          "command": "brew install 1password-cli",
          "update": "brew upgrade 1password-cli",
          "url": "https://www.1password.dev/cli/get-started/"
        },
        "patterns": {
          "item": "^[A-Za-z0-9]{1,64}$",
          "account": "^[A-Za-z0-9][A-Za-z0-9.@_-]{0,319}$",
          "vault": "^[A-Za-z0-9]{1,64}$"
        },
        "env": [
          {
            "name": "OP_INTEGRATION_NAME",
            "literal": "Ardia"
          },
          {
            "name": "OP_INTEGRATION_ID",
            "literal": "ardia"
          },
          {
            "name": "OP_CONFIG_DIR",
            "testFolder": ""
          }
        ],
        "onLock": {
          "verb": "signout",
          "params": {
            "account": {
              "from": "preference",
              "key": "account"
            }
          }
        },
        "verbs": {
          "account.list": {
            "argv": [
              "account",
              "list",
              "--format",
              "json"
            ],
            "timeoutMs": 20000,
            "output": {
              "mode": "json"
            },
            "hints": {
              "noAccounts": [
                "no accounts",
                "no account found"
              ]
            }
          },
          "connect": {
            "argv": [
              "vault",
              "list",
              "--format",
              "json",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 90000,
            "signIn": true,
            "unlocks": true,
            "output": {
              "mode": "json"
            },
            "hints": {
              "dismissed": [
                "dismissed",
                "denied",
                "cancel"
              ],
              "appUnreachable": [
                "cannot connect",
                "connect to the 1password app",
                "desktop app"
              ],
              "setupNeeded": [
                "not currently signed in",
                "no accounts configured",
                "account is not signed in"
              ]
            }
          },
          "signout": {
            "argv": [
              "signout",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 15000,
            "output": {
              "mode": "lines"
            }
          },
          "item.list": {
            "argv": [
              "item",
              "list",
              "--categories",
              "Login",
              "--format",
              "json",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "json",
              "items": "$"
            }
          },
          "item.reveal": {
            "argv": [
              "item",
              "get",
              {
                "slot": "id"
              },
              "--format",
              "json",
              "--reveal",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "id": {
                "type": "id",
                "pattern": "item"
              },
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "json"
            }
          },
          "item.otp": {
            "argv": [
              "item",
              "get",
              {
                "slot": "id"
              },
              "--otp",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "id": {
                "type": "id",
                "pattern": "item"
              },
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "lines"
            }
          },
          "item.create": {
            "argv": [
              "item",
              "create",
              "-",
              {
                "flag": "--vault",
                "slot": "vault"
              },
              "--format=json",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "vault": {
                "type": "id",
                "pattern": "vault"
              },
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              },
              "template": {
                "type": "json"
              }
            },
            "stdin": {
              "slot": "template",
              "encoding": "utf8"
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "json"
            }
          },
          "item.edit": {
            "argv": [
              "item",
              "edit",
              {
                "slot": "id"
              },
              "--format=json",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "id": {
                "type": "id",
                "pattern": "item"
              },
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              },
              "template": {
                "type": "json"
              }
            },
            "stdin": {
              "slot": "template",
              "encoding": "utf8"
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "json"
            }
          },
          "vault.list": {
            "argv": [
              "vault",
              "list",
              "--format",
              "json",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "json"
            }
          },
          "vault.get": {
            "argv": [
              "vault",
              "get",
              {
                "slot": "id"
              },
              "--format",
              "json",
              {
                "flag": "--account",
                "slot": "account"
              }
            ],
            "slots": {
              "id": {
                "type": "id",
                "pattern": "vault"
              },
              "account": {
                "type": "id",
                "pattern": "account",
                "optional": true
              }
            },
            "timeoutMs": 60000,
            "output": {
              "mode": "json"
            }
          }
        }
      }
    }
  }
}
