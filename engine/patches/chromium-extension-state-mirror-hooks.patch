+RulesMonitorService::ApiCallback ArdiaNotifyingRulesChanged(
+    content::BrowserContext* context,
+    const ExtensionId& extension_id,
+    const char* kind,
+    RulesMonitorService::ApiCallback callback) {
+  if (!g_ardia_dnr_rules_changed) {
+    return callback;
+  }
+  return base::BindOnce(
+      [](content::BrowserContext* context, const ExtensionId& extension_id,
+         const std::string& kind, RulesMonitorService::ApiCallback callback,
+         std::optional<std::string> error) {
+        const bool changed = !error.has_value();
+        std::move(callback).Run(std::move(error));
+        if (changed && g_ardia_dnr_rules_changed) {
+          g_ardia_dnr_rules_changed(context, extension_id, kind);
+        }
+      },
+      base::Unretained(context), extension_id, std::string(kind),
+      std::move(callback));
