+std::optional<gfx::Size> ArdiaLinuxPinnedWindowSize(
+    const OpaqueBrowserFrameView* frame) {
+  if (!g_ardia_linux_pins_window_size || !frame->GetWidget() ||
+      !frame->GetBrowserView() ||
+      !g_ardia_linux_pins_window_size(frame->GetBrowserView()->browser())) {
+    return std::nullopt;
+  }
+  return frame->GetWidget()->GetWindowBoundsInScreen().size();
+}
