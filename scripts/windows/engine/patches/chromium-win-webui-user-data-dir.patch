+struct VanishingFolder {
+  std::wstring folder;
+  bool removed = false;
+};
+
+void RemoveFolderBeforeListing(const std::wstring& folder, void* context) {
+  auto* vanishing = static_cast<VanishingFolder*>(context);
+  if (folder == vanishing->folder)
+    vanishing->removed = ::RemoveDirectoryW(folder.c_str()) != 0;
+}
