---
import { base, pagePath } from "../data/site";
import { Image } from "astro:assets";
import icon from "../assets/app-icon.png";
import DownloadButton from "./DownloadButton.astro";
import { STARS } from "../data/github";
import { DISCORD, DMG, LINUX_NIGHTLY, LINUX_TARBALL, LINUX_VERSION, MIN_MACOS_MAJOR, REPO, VERSION, WINDOWS_SETUP } from "../data/release";

const githubPath =
  "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12";
const discordPath =
  "M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.865-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.74 19.74 0 0 0 3.677 4.37a.07.07 0 0 0-.032.028C.533 9.046-.32 13.58.099 18.058a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 0 0-.042-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .078-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .079.009c.12.099.246.198.373.292a.077.077 0 0 1-.007.128 12.3 12.3 0 0 1-1.873.891.077.077 0 0 0-.041.107c.36.698.772 1.363 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.029ZM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.419 0 1.333-.956 2.419-2.157 2.419Zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.095 2.157 2.419 0 1.333-.946 2.419-2.157 2.419Z";
const starPath =
  "M8 .75l2.22 4.5 4.97.72-3.6 3.5.85 4.95L8 12.08l-4.44 2.34.85-4.95-3.6-3.5 4.97-.72L8 .75z";

export type Page = "try" | "arc" | "benchmarks" | "notes";
interface Props {
  home?: string;
  current?: Page;
}
const { home = "", current } = Astro.props;
const pcDownloads = [
  { only: "windows-only x64-only", href: WINDOWS_SETUP.x64, platform: "windows", arch: "x64", version: "nightly" },
  { only: "windows-only arm-only", href: WINDOWS_SETUP.arm64, platform: "windows", arch: "arm64", version: "nightly" },
  { only: "linux-only", href: LINUX_TARBALL, platform: "linux", arch: "x64", version: LINUX_VERSION },
];
const pages: { page?: Page; href: string; section?: string; label: string; menuLabel: string }[] = [
  { page: "try", href: pagePath("try"), section: "demo", label: "Demo", menuLabel: "Demo" },
  { href: `${pagePath("home")}#cli`, section: "cli", label: "CLI", menuLabel: "CLI" },
  { page: "benchmarks", href: pagePath("benchmarks"), section: "speed", label: "Benchmarks", menuLabel: "Benchmarks" },
  { page: "arc", href: `${base}/arc/`, label: "Arc & Dia", menuLabel: "Arc & Dia" },
  { page: "notes", href: pagePath("notes"), label: "Changelog", menuLabel: "Changelog" },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="bar" data-bar>
  <div class="wrap bar-inner">
    <a
      class="mark"
      href={`${home}#top`}
      aria-label={home ? "Ardia home" : "Ardia, back to top"}
      title="Right-click for the press kit"
      data-press={`${base}/press`}
    >
      <Image src={icon} alt="" width={30} height={30} densities={[1, 2]} loading="eager" decoding="sync" fetchpriority="high" />
      <span>Ardia</span>
    </a>
    <nav class="links" aria-label="Primary">
      {
        pages.map((p) => (
          <a href={p.href} data-section={p.section} aria-current={p.page && p.page === current ? "page" : undefined}>
            {p.label}
          </a>
        ))
      }
    </nav>
    <div class="actions">
      <div class="social">
        <a
          class="icon-link"
          href={REPO}
          rel="noopener"
          aria-label={STARS ? `GitHub, ${STARS} stars` : "GitHub"}
          data-track="github_clicked"
          data-track-link="source"
          data-track-location="header"
          ><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d={githubPath} /></svg>{
            STARS && (
              <span class="stars" aria-hidden="true">
                <svg class="star-icon" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
                  <path d={starPath} />
                </svg>
                <span>{STARS}</span>
              </span>
            )
          }</a
        >
        <a
          class="icon-link icon-only"
          href={DISCORD}
          rel="noopener"
          aria-label="Discord"
          data-track="discord_clicked"
          data-track-location="header"
          ><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d={discordPath} /></svg></a
        >
      </div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu" data-menu-btn>
        <span class="menu-glyph" aria-hidden="true"><i /><i /></span>
        <span data-menu-label>Menu</span>
      </button>
      <a
        class="bar-cta not-pc"
        href={DMG}
        data-download
        data-track="download_clicked"
        data-track-version={VERSION}
        data-track-location="header"
        ><span class="not-phone">Download</span><span class="phone-only" data-send-label aria-live="polite">Send to my Mac</span></a
      >
      {
        pcDownloads.map(({ only, href, platform, arch, version }) => (
          <a
            class:list={["bar-cta", only]}
            href={href}
            data-track="download_clicked"
            data-track-version={version}
            data-track-channel={version.includes("nightly") ? "nightly" : undefined}
            data-track-platform={platform}
            data-track-arch={arch}
            data-track-location="header"
          >
            Download
          </a>
        ))
      }
    </div>
  </div>
  <div class="menu-backdrop" data-menu-backdrop hidden></div>
  <nav class="menu" id="menu" aria-label="Menu" data-menu hidden>
    <div class="wrap menu-inner">
      <div class="menu-pages">
        {
          pages.map((p) => (
            <a href={p.href} data-section={p.section} aria-current={p.page && p.page === current ? "page" : undefined}>
              <span>{p.menuLabel}</span>
            </a>
          ))
        }
      </div>
      <div class="menu-social">
        <a
          class="icon-link"
          href={REPO}
          rel="noopener"
          aria-label={STARS ? `GitHub, ${STARS} stars` : undefined}
          data-track="github_clicked"
          data-track-link="source"
          data-track-location="menu"
          ><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={githubPath} /></svg><span>GitHub</span>{
            STARS && (
              <span class="stars" aria-hidden="true">
                <svg class="star-icon" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                  <path d={starPath} />
                </svg>
                <span>{STARS}</span>
              </span>
            )
          }</a
        >
        <a class="icon-link" href={DISCORD} rel="noopener" data-track="discord_clicked" data-track-location="menu"
          ><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d={discordPath} /></svg><span>Discord</span></a
        >
      </div>
      <div class="menu-cta">
        <DownloadButton location="menu" class="not-pc" />
        <DownloadButton location="menu" platform="windows-x64" />
        <DownloadButton location="menu" platform="windows-arm64" />
        <DownloadButton location="menu" platform="linux" />
        <p class="label menu-fine bits not-pc"><span>Apple Silicon</span><span>macOS {MIN_MACOS_MAJOR}+</span></p>
        <p class="label menu-fine bits windows-only"><span>Nightly</span><span>x64 and Arm</span></p>
        <p class="label menu-fine bits linux-only">{LINUX_NIGHTLY && <span>Nightly</span>}<span>x86-64</span><span>Wayland or X11</span></p>
      </div>
    </div>
  </nav>
</header>

<style>
  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 40;
    padding: 10px 16px;
    border-radius: 10px;
    background: var(--ink);
    color: var(--ink-on);
    font-family: var(--sans);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
  }
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    color: var(--day-ink);
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 256px;
    background-blend-mode: soft-light;
  }
  .bar::after {
    content: "";
    position: absolute;
    top: calc(100% - 1px);
    left: 0;
    right: 0;
    height: 14px;
    pointer-events: none;
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 256px;
    background-blend-mode: soft-light;
    -webkit-mask: var(--edge-a) 0 100% / 1200px 100% repeat-x;
    mask: var(--edge-a) 0 100% / 1200px 100% repeat-x;
    scale: 1 -1;
    transition: opacity 140ms var(--ease-out);
  }
  .bar[data-menu-open]::after {
    opacity: 0;
  }
  .bar-inner {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
    height: 60px;
  }
  .mark {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--sans);
    font-weight: 740;
    font-size: 1.24rem;
    letter-spacing: -0.032em;
    line-height: 1;
    min-height: 44px;
    padding-right: 4px;
  }
  .mark img {
    width: 30px;
    height: 30px;
    flex: none;
  }
  .links {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: clamp(2px, 0.5vw, 8px);
  }
  .links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 clamp(10px, 1vw, 14px);
    font-family: var(--sans);
    font-size: 0.93rem;
    font-weight: 540;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
    transition: color 150ms var(--ease-out);
  }
  .links a::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 5px;
    width: calc(100% - 20px);
    min-width: 28px;
    height: 3.5px;
    border-radius: 55% 45% 60% 40% / 70% 60% 50% 40%;
    background-color: var(--forest);
    background-image: var(--impasto);
    background-size: 120px;
    background-blend-mode: soft-light;
    opacity: 0;
    transform: translateX(-50%) scaleX(0.35) rotate(-1.5deg);
    transition:
      opacity 180ms var(--ease-out),
      transform 220ms var(--ease-out);
    pointer-events: none;
  }
  .links a[aria-current="page"] {
    color: var(--ink);
    font-weight: 660;
  }
  .links a[data-active] {
    color: var(--ink);
  }
  .links a[aria-current="page"]::after,
  .links a[data-active]::after {
    opacity: 1;
    transform: translateX(-50%) scaleX(1) rotate(-1.5deg);
  }
  .actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 24px);
  }
  .social {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 44px;
    padding: 0 10px;
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 0.84rem;
    font-weight: 540;
    line-height: 1;
    text-decoration: none;
    color: var(--ink-2);
    white-space: nowrap;
    transition:
      color 150ms var(--ease-out),
      background-color 150ms var(--ease-out);
  }
  .social .icon-only {
    min-width: 44px;
    padding: 0;
  }
  @media (hover: hover) {
    .links a:hover {
      color: var(--ink);
    }
    .links a:not([aria-current="page"]):not([data-active]):hover::after {
      opacity: 0.32;
      transform: translateX(-50%) scaleX(0.68) rotate(-2deg);
    }
    .social a:hover {
      color: var(--ink);
      background-color: rgb(22 19 15 / 0.06);
    }
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--sans);
    font-weight: 560;
    line-height: 1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .star-icon {
    display: block;
    flex: none;
    transform: translateY(-0.5px);
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .icon-link svg {
    display: block;
    flex: none;
    fill: currentColor;
  }
  .bar-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    font-family: var(--sans);
    font-weight: 600;
    font-size: 0.88rem;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    background: var(--ink);
    color: var(--ink-on);
    transition:
      background-color 160ms var(--ease-out),
      transform 150ms var(--ease-out);
    touch-action: manipulation;
  }
  @media (hover: hover) {
    .bar-cta:hover {
      background: var(--figure);
    }
  }
  .bar-cta:active {
    transform: scale(0.96);
  }

  .menu-btn,
  .menu,
  .menu-backdrop {
    display: none;
  }

  @media (max-width: 1080px) {
    .bar-inner {
      grid-template-columns: auto 1fr auto;
      gap: 16px;
    }
    .links {
      gap: 2px;
    }
    .links a {
      padding: 0 9px;
      font-size: 0.91rem;
    }
    .actions {
      gap: 12px;
    }
  }

  @media (max-width: 860px) {
    .bar-inner {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .mark {
      margin-right: auto;
    }
    .links,
    .social {
      display: none;
    }
    .actions {
      gap: 8px;
    }
    .menu-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      min-height: 44px;
      min-width: 44px;
      padding: 0 10px;
      border: 0;
      border-radius: 999px;
      background: none;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 0.88rem;
      font-weight: 560;
      letter-spacing: -0.01em;
      cursor: pointer;
      touch-action: manipulation;
      -webkit-tap-highlight-color: transparent;
    }
    .menu-glyph {
      position: relative;
      display: block;
      width: 14px;
      height: 10px;
      flex: none;
    }
    .menu-glyph i {
      position: absolute;
      left: 0;
      right: 0;
      height: 1.75px;
      border-radius: 1px;
      background: currentColor;
      transition:
        top 160ms var(--ease-out),
        transform 160ms var(--ease-out);
    }
    .menu-glyph i:first-child {
      top: 1px;
    }
    .menu-glyph i:last-child {
      top: 7px;
    }
    .menu-btn[aria-expanded="true"] .menu-glyph i:first-child {
      top: 4px;
      transform: rotate(45deg);
    }
    .menu-btn[aria-expanded="true"] .menu-glyph i:last-child {
      top: 4px;
      transform: rotate(-45deg);
    }
    .bar-cta {
      min-height: 44px;
      padding: 0 16px;
    }
    :global(:root[data-device="phone"]) .menu-btn {
      padding: 0 8px;
    }
    :global(:root[data-device="phone"]) .bar-cta {
      padding: 0 13px;
    }
    .menu-backdrop:not([hidden]) {
      display: block;
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1;
      background: rgb(22 19 15 / 0.48);
      animation: fade 180ms var(--ease-out) both;
    }
    .menu:not([hidden]) {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 2;
      background-color: var(--paper);
      background-image: var(--grain);
      background-size: 256px;
      background-blend-mode: soft-light;
      animation: drop 200ms var(--ease-out) both;
    }
    .menu::after {
      content: "";
      position: absolute;
      top: calc(100% - 1px);
      left: 0;
      right: 0;
      height: 14px;
      pointer-events: none;
      background-color: var(--paper);
      background-image: var(--grain);
      background-size: 256px;
      background-blend-mode: soft-light;
      -webkit-mask: var(--edge-a) 0 100% / 1200px 100% repeat-x;
      mask: var(--edge-a) 0 100% / 1200px 100% repeat-x;
      scale: 1 -1;
    }
    .menu-inner {
      max-height: calc(100dvh - 74px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-block: 8px 20px;
    }
    .menu-pages {
      display: flex;
      flex-direction: column;
    }
    .menu-pages a {
      display: flex;
      align-items: center;
      gap: 12px;
      min-height: 48px;
      font-family: var(--sans);
      font-weight: 700;
      font-size: clamp(1.35rem, 5vw, 1.65rem);
      line-height: 1.15;
      letter-spacing: -0.028em;
      text-decoration: none;
      color: var(--ink);
      -webkit-tap-highlight-color: transparent;
    }
    .menu-pages a[aria-current="page"],
    .menu-pages a[data-active] {
      color: var(--forest-deep);
    }
    .menu-pages a[aria-current="page"]::after,
    .menu-pages a[data-active]::after {
      content: "";
      width: 18px;
      height: 4px;
      border-radius: 55% 45% 60% 40% / 70% 60% 50% 40%;
      background-color: var(--forest);
      background-image: var(--impasto);
      background-size: 120px;
      background-blend-mode: soft-light;
      transform: rotate(-3deg);
      flex: none;
    }
    .menu-social {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px 20px;
      margin-top: 18px;
    }
    .menu-social a {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 44px;
      font-family: var(--sans);
      font-weight: 580;
      font-size: 0.96rem;
      letter-spacing: -0.01em;
      line-height: 1;
      text-decoration: none;
      color: var(--ink-2);
    }
    .menu-social .stars {
      font-size: 0.78rem;
      color: var(--ink-3);
      margin-left: 2px;
    }
    .menu-cta {
      margin-top: 18px;
    }
    .menu-cta :global(.btn) {
      width: 100%;
      justify-content: center;
    }
    .menu-fine {
      margin-top: 10px;
      color: var(--ink-3);
    }
  }
  @media (max-width: 370px) {
    .bar-inner {
      gap: 6px;
    }
    .mark {
      gap: 7px;
      font-size: 1.12rem;
    }
    .mark img {
      width: 26px;
      height: 26px;
    }
    .actions {
      gap: 4px;
    }
    :global(:root[data-device="phone"]) .menu-btn {
      padding: 0 6px;
      font-size: 0.82rem;
    }
    :global(:root[data-device="phone"]) .bar-cta {
      font-size: 0.78rem;
      padding: 0 10px;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar::after,
    .links a,
    .links a::after,
    .social a,
    .bar-cta,
    .menu-glyph i,
    .menu,
    .menu-backdrop {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  import { capture } from "../scripts/telemetry";

  const bar = document.querySelector<HTMLElement>("[data-bar]")!;

  const mark = bar.querySelector<HTMLAnchorElement>("[data-press]")!;
  mark.addEventListener("contextmenu", (e) => {
    e.preventDefault();
    capture("press_kit_opened", { via: "logo" }, { send_instantly: true });
    location.href = mark.dataset.press!;
  });

  const btn = bar.querySelector<HTMLButtonElement>("[data-menu-btn]")!;
  const btnLabel = btn.querySelector<HTMLElement>("[data-menu-label]")!;
  const menu = bar.querySelector<HTMLElement>("[data-menu]")!;
  const backdrop = bar.querySelector<HTMLElement>("[data-menu-backdrop]")!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    backdrop.hidden = !open;
    bar.toggleAttribute("data-menu-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btnLabel.textContent = open ? "Close" : "Menu";
    document.documentElement.style.overflow = open ? "hidden" : "";
    for (const el of document.querySelectorAll<HTMLElement>("main, footer")) el.inert = open;
  };
  btn.addEventListener("click", () => setOpen(menu.hidden));
  backdrop.addEventListener("click", () => setOpen(false));
  mark.addEventListener("click", () => !menu.hidden && setOpen(false));
  menu.addEventListener("click", (e) => {
    if ((e.target as Element).closest("a")) setOpen(false);
  });
  addEventListener("keydown", (e) => e.key === "Escape" && !menu.hidden && (setOpen(false), btn.focus()));

  bar.addEventListener("click", (e) => {
    if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    const link = (e.target as Element).closest<HTMLAnchorElement>("a[data-section]");
    const section = link && document.getElementById(link.dataset.section!);
    if (!section) return;
    e.preventDefault();
    if (location.hash === `#${section.id}`) section.scrollIntoView();
    else location.hash = section.id;
  });
  matchMedia("(min-width: 861px)").addEventListener("change", (e) => e.matches && setOpen(false));

  if (!bar.querySelector('[aria-current="page"]')) {
    const sectionLinks = [...bar.querySelectorAll<HTMLAnchorElement>("a[data-section]")];
    const sectionIds = [...new Set(sectionLinks.map((link) => link.dataset.section!).filter(Boolean))];
    const sections = sectionIds.map((id) => document.getElementById(id)).filter((el): el is HTMLElement => Boolean(el));
    if (sections.length) {
      const visible = new Set<HTMLElement>();
      let activeId: string | null = null;
      const syncActive = () => {
        let nextId: string | null = null;
        if (window.scrollY >= 80 && visible.size) {
          let bestDist = Infinity;
          for (const section of visible) {
            const dist = Math.abs(section.getBoundingClientRect().top - 90);
            if (dist < bestDist) {
              bestDist = dist;
              nextId = section.id;
            }
          }
        }
        if (nextId === activeId) return;
        activeId = nextId;
        for (const link of sectionLinks) {
          if (link.dataset.section === activeId) link.setAttribute("data-active", "");
          else link.removeAttribute("data-active");
        }
      };
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const el = entry.target as HTMLElement;
            if (entry.isIntersecting) visible.add(el);
            else visible.delete(el);
          }
          syncActive();
        },
        { rootMargin: "-90px 0px -65% 0px", threshold: 0 },
      );
      for (const section of sections) observer.observe(section);
    }
  }
</script>
