+#if BUILDFLAG(IS_LINUX)
+namespace {
+
+constexpr char kWidevineCdmComponentId[] = "oimompecagnajdejgnnjijobebaeigek";
+
+bool PlayProtectedContent() {
+  PrefService* local_state = g_browser_process->local_state();
+  return local_state &&
+         local_state->GetBoolean(kArdiaPlayProtectedContentPref);
+}
+
+scoped_refptr<base::SequencedTaskRunner> HintFileRunner() {
+  static base::NoDestructor<scoped_refptr<base::SequencedTaskRunner>> runner(
+      base::ThreadPool::CreateSequencedTaskRunner(
+          {base::MayBlock(), base::TaskPriority::USER_VISIBLE}));
+  return *runner;
+}
+
+void ForgetHintedCdm() {
+  base::FilePath hint_file;
+  if (base::PathService::Get(chrome::FILE_COMPONENT_WIDEVINE_CDM_HINT,
+                             &hint_file)) {
+    base::DeleteFile(hint_file);
+  }
+}
+
+void HintInstalledCdm(const base::Version& version) {
+  base::FilePath base_dir;
+  if (!base::PathService::Get(chrome::DIR_COMPONENT_UPDATED_WIDEVINE_CDM,
+                              &base_dir)) {
+    return;
+  }
+  const base::FilePath install_dir =
+      base::MakeAbsoluteFilePath(base_dir.AppendASCII(version.GetString()));
+  if (install_dir.empty() ||
+      !base::PathExists(GetCdmPathFromInstallDir(install_dir))) {
+    return;
+  }
+  if (!UpdateHintFile(install_dir)) {
+    PLOG(WARNING) << "Failed to update Widevine CDM hint path.";
+  }
+}
+
+void ApplyPlayProtectedContent(ComponentUpdateService* cus, bool changed) {
+  g_ardia_widevine_component_updates = PlayProtectedContent();
+  if (!g_ardia_widevine_component_updates) {
+    HintFileRunner()->PostTask(FROM_HERE, base::BindOnce(&ForgetHintedCdm));
+    return;
+  }
+  if (!changed) {
+    return;
+  }
+  for (const ComponentInfo& info : cus->GetComponents()) {
+    if (info.id == kWidevineCdmComponentId && info.version.IsValid() &&
+        info.version.CompareTo(base::Version("0.0.0.0")) > 0) {
+      HintFileRunner()->PostTask(
+          FROM_HERE, base::BindOnce(&HintInstalledCdm, info.version));
+    }
+  }
+  cus->MaybeThrottle(kWidevineCdmComponentId, base::DoNothing());
+}
+
+}  // namespace
+
+void RegisterWidevineCdmPrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kArdiaPlayProtectedContentPref, false);
+}
+#endif
+
 void RegisterWidevineCdmComponent(ComponentUpdateService* cus) {
+#if BUILDFLAG(IS_LINUX)
+  // Ardia: the "Play DRM-protected content" setting decides, before the
+  // installed component is read, whether Widevine is fetched and loaded.
+  g_ardia_widevine_component_updates = PlayProtectedContent();
+#endif
   auto installer = base::MakeRefCounted<ComponentInstaller>(
       std::make_unique<WidevineCdmComponentInstallerPolicy>());
+#if BUILDFLAG(IS_LINUX)
+  installer->Register(
+      cus, base::BindOnce(&ApplyPlayProtectedContent, cus, false));
+  if (PrefService* local_state = g_browser_process->local_state()) {
+    static base::NoDestructor<PrefChangeRegistrar> registrar;
+    registrar->Init(local_state);
+    registrar->Add(kArdiaPlayProtectedContentPref,
+                   base::BindRepeating(&ApplyPlayProtectedContent, cus, true));
+  }
+#else
   installer->Register(cus, base::OnceClosure());
+#endif
 }
 
 }  // namespace component_updater
