+void PauseAfterPinForTestBuild() {
+  std::wstring marker = ExecutableDirectory();
+  if (marker.empty())
+    return;
+  marker.append(L"Ardia.test-build");
+  if (::GetFileAttributesW(marker.c_str()) == INVALID_FILE_ATTRIBUTES)
+    return;
+  const std::wstring pause = GetEnvironmentString(L"ARDIA_TEST_PIN_PAUSE_MS");
+  if (pause.empty())
+    return;
+  DWORD milliseconds = 0;
+  for (wchar_t c : pause) {
+    if (c < L'0' || c > L'9')
+      return;
+    milliseconds = milliseconds * 10 + static_cast<DWORD>(c - L'0');
+    if (milliseconds > 30000)
+      milliseconds = 30000;
+  }
+  ::Sleep(milliseconds);
+}
